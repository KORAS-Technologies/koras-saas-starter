# Local development reverse proxy.
# TLS certificates are generated by local/certs/generate.sh and mounted read-only.

{
  local_certs
  auto_https off
}

# Web app (product profile)
app.localhost {
  tls /certs/app.localhost.pem /certs/app.localhost-key.pem
  reverse_proxy host.docker.internal:3000
}

# Admin app
admin.localhost {
  tls /certs/admin.localhost.pem /certs/admin.localhost-key.pem
  reverse_proxy host.docker.internal:3001
}

# Marketing (product only)
www.localhost {
  tls /certs/www.localhost.pem /certs/www.localhost-key.pem
  reverse_proxy host.docker.internal:3002
}

# Portal (control-plane only)
portal.localhost {
  tls /certs/portal.localhost.pem /certs/portal.localhost-key.pem
  reverse_proxy host.docker.internal:3001
}

# API
api.localhost {
  tls /certs/api.localhost.pem /certs/api.localhost-key.pem
  reverse_proxy host.docker.internal:8000
}

# ZITADEL
auth.localhost {
  tls /certs/auth.localhost.pem /certs/auth.localhost-key.pem
  reverse_proxy zitadel:8080
}

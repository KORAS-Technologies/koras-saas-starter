{
  "name": "koras-cli",
  "version": "0.1.0",
  "description": "KORAS platform CLI — bootstrap diagnostics and project tooling",
  "license": "MIT",
  "type": "module",
  "bin": {
    "koras": "./bin/koras.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "lint": "eslint src tests",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "create-koras-app": "workspace:*",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "vitest": "^2.0.0"
  }
}

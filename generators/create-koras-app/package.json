{
  "name": "create-koras-app",
  "version": "0.1.0",
  "description": "KORAS application factory CLI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-koras-app": "./bin/create-koras-app.js"
  },
  "exports": {
    "./terraform": {
      "types": "./dist/terraform/inputs.d.ts",
      "default": "./dist/terraform/inputs.js"
    },
    "./redact": {
      "types": "./dist/redact.d.ts",
      "default": "./dist/redact.js"
    },
    "./terraform-outputs": {
      "types": "./dist/terraform/outputs.d.ts",
      "default": "./dist/terraform/outputs.js"
    },
    "./project-manifest": {
      "types": "./dist/generation/project-manifest.d.ts",
      "default": "./dist/generation/project-manifest.js"
    },
    "./doppler": {
      "types": "./dist/terraform/doppler.d.ts",
      "default": "./dist/terraform/doppler.js"
    },
    "./url": {
      "types": "./dist/url.d.ts",
      "default": "./dist/url.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "lint": "eslint src tests",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "handlebars": "^4.7.10",
    "js-yaml": "^4.3.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/handlebars": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}

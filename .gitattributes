# Line-ending policy.
#
# Git normalizes text to LF in the object store, but `core.autocrlf=true` — the
# Windows default — rewrites it to CRLF on checkout. That is harmless for source
# files and fatal for shell scripts: bash reads `set -euo pipefail\r` as an
# option named `pipefail\r` and aborts, with the stray CR scrambling the error
# message on the way out.
#
# Anything executed by an interpreter that reads the shebang, or by a Linux
# container, is therefore pinned to LF regardless of platform.

* text=auto

*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
*.Dockerfile text eol=lf
Makefile    text eol=lf
*.mk        text eol=lf

# Windows-native scripts keep CRLF — cmd.exe requires it.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary, never converted.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.woff      binary
*.woff2     binary

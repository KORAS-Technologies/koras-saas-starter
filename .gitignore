# Node
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
.turbo/
out/
build/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
# Terraform plan files. A plan embeds a full state snapshot, so committing one
# publishes every credential Terraform holds. Named without an extension by
# convention, which is also why no content scanner looks inside them: gitleaks
# decides what is an archive from the extension, so a plan file scans as zero
# bytes and reports nothing.
tfplan
*.tfplan
*.plan.out
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Environment / secrets — NEVER commit these
.env
.env.*
!.env.*.example
!.env.*.example.hbs
!.env.local.example
doppler.yaml

# Editor
.DS_Store
Thumbs.db
*.swp
*.swo

# Local dev
local/certs/*.pem
local/certs/*.key
local/certs/*.crt

# Test artifacts
coverage/
junit.xml

private-keys/
.tmp/

# Temporary extraction / scratch
.tmp/

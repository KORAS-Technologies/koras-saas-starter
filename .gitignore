# Node
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
.turbo/
out/
build/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
# Terraform plan files. A plan embeds a full state snapshot, so committing one
# publishes every credential Terraform holds. Named without an extension by
# convention, which is also why no content scanner looks inside them: gitleaks
# decides what is an archive from the extension, so a plan file scans as zero
# bytes and reports nothing.
tfplan
*.tfplan
*.plan.out
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Environment / secrets — NEVER commit these
.env
.env.*
!.env.*.example
!.env.*.example.hbs
!.env.local.example
doppler.yaml

# Editor
.DS_Store
Thumbs.db
*.swp
*.swo

# Local dev
local/certs/*.pem
local/certs/*.key
local/certs/*.crt

# Test artifacts
coverage/
junit.xml

private-keys/
.tmp/

# Temporary extraction / scratch
.tmp/

# Terraform outputs captured for teardown.
#
# `terraform output -json` includes the values of outputs marked sensitive, so
# such a file holds live credentials -- Upstash URLs with their password, ZITADEL
# client secrets. One was committed to this repository on 2026-08-26 and had to
# be rotated. It is a working file for `koras teardown`; it belongs on disk and
# never in git.
*-outputs.json
terraform-outputs*.json


.playwright-mcp/*

# The round-trip harness's local identity provider writes its RSA signing key
# here when it starts (see profiles/_shared/template/.gitignore.hbs). Nothing in
# this repository writes it at the root today; the rule is here so that running
# the harness from the root cannot stage a private key.
/.e2e/

# Private key material, anywhere in the tree.
#
# The rules above name the places keys are known to be written. A key written
# anywhere else was covered by nothing, and the secret scan is not a reliable
# backstop: gitleaks reads a JWK as structure rather than as a pattern it
# knows, and an archive or an extension-less file it does not open at all.
# These rules name the file shapes instead of the places.
#
# No legitimate fixture in this repository is a key file -- test keys are
# generated at run time or held inline in source. If one ever has to be
# committed, negate that one exact path with a comment saying why it is not a
# credential. Never negate a directory.
*.pem
*.key
*.p12
*.pfx
*.jwk
*-key.json

# Claude Code's per-user settings. `.claude/settings.json` is shared and
# reviewed; `settings.local.json` is one machine's auto-approved permissions
# and environment. It can carry tokens, and it widens what an agent may run
# without asking, so it is personal by definition and never belongs in git.
**/.claude/settings.local.json

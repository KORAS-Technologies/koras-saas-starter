import { cookies } from 'next/headers'
import { PortalApiClient } from '@{{projectSlug}}/api-client'

/**
 * A portal API client carrying the customer's own token.
 *
 * Deliberately the portal client and not the platform one. The two are separate
 * classes so that a page cannot reach platform data by importing the wrong
 * thing, and the API would refuse it in any case.
 */
export async function portalClient(): Promise<PortalApiClient | null> {
  const token = (await cookies()).get('session')?.value
  if (!token) return null
  return new PortalApiClient({
    baseUrl: process.env.NEXT_PUBLIC_API_URL ?? '',
    token,
  })
}

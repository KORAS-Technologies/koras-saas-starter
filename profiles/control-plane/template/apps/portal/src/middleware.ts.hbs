import { NextResponse } from 'next/server'
import type { NextRequest } from 'next/server'
import { readSession } from '@{{projectSlug}}/auth'

/**
 * The portal is for customer organization users.
 *
 * The gate is the reverse of the admin application: a session is required, and
 * a platform role is a reason to refuse rather than to admit. Staff who need to
 * see customer data have the admin application, where the access is attributed
 * to them.
 */
const PUBLIC_PATHS = ['/login', '/api/auth']

/**
 * A per-request nonce, and the policy that makes it worth having.
 *
 * `frame-ancestors 'none'` is the one that matters most here: this application
 * performs privileged actions with a session cookie, so being framable is
 * clickjacking with extra steps. `X-Frame-Options` in the config says the same
 * thing for browsers that predate CSP.
 *
 * Next emits inline bootstrap script, so a policy without either a nonce or
 * `unsafe-inline` breaks the application outright. The nonce is generated here,
 * passed to the renderer through a request header, and named in the policy --
 * which keeps inline script working for the code we ship and no one else's.
 */
function contentSecurityPolicy(nonce: string, connectSrc: string): string {
  return [
    "default-src 'self'",
    `script-src 'self' 'nonce-${nonce}' 'strict-dynamic'`,
    "style-src 'self' 'unsafe-inline'",
    "img-src 'self' data: blob:",
    "font-src 'self'",
    `connect-src 'self' ${connectSrc}`.trim(),
    "frame-ancestors 'none'",
    "form-action 'self'",
    "base-uri 'self'",
    "object-src 'none'",
  ].join('; ')
}

export async function middleware(request: NextRequest) {
  const nonce = crypto.randomUUID().replace(/-/g, '')
  const response = await authorize(request, nonce)

  // Applied to every response the function can produce, including the refusals.
  // A 403 rendered without a policy is still a page in the user's browser, and
  // the error paths are the ones easiest to forget.
  response.headers.set(
    'Content-Security-Policy',
    contentSecurityPolicy(nonce, process.env.NEXT_PUBLIC_API_BASE_URL ?? ''),
  )
  return response
}

async function authorize(request: NextRequest, nonce: string): Promise<NextResponse> {
  const { pathname } = request.nextUrl
  if (PUBLIC_PATHS.some((path) => pathname.startsWith(path))) {
    return withNonce(request, nonce)
  }

  // No network call. This used to verify the provider's token against
  // ZITADEL's key set on every request, and the edge runtime cannot reach
  // this deployment's ZITADEL host -- so every valid session read as no
  // session and the browser looped back to the login page forever.
  const outcome = await readSession(request, {
    secret: process.env.SESSION_SECRET ?? '',
  })

  if (outcome.status === 'anonymous') {
    const login = new URL('/login', request.url)
    login.searchParams.set('next', pathname)
    return NextResponse.redirect(login)
  }

  // Signed in, staff, and no second factor. Refused, and said out loud:
  // redirecting here sends the browser back through a sign-in it has already
  // completed, which cannot add a factor and so never terminates. The loop
  // looked exactly like a broken session and was neither.
  if (outcome.status === 'mfa-required') {
    return new NextResponse(
      'Multi-factor authentication is required for KORAS staff. ' +
        'Enrol a second factor, then sign in again.',
      { status: 403 },
    )
  }

  const session = outcome.session

  if (session.platformRole) {
    return new NextResponse(
      'This is the customer portal. KORAS staff use the admin application.',
      { status: 403 },
    )
  }

  // A customer token that carries no organization cannot be scoped to one, and
  // the API would refuse every request anyway. Saying so here is clearer than
  // an empty page.
  if (!session.organizationId) {
    return new NextResponse('Your account is not linked to an organization.', {
      status: 403,
    })
  }

  return withNonce(request, nonce)
}

/**
 * Forward the request with the nonce attached.
 *
 * Passed as a request header rather than a module-level value: the renderer
 * reads it per request, and a nonce shared between two concurrent renders would
 * let one page's policy authorise another page's script.
 */
function withNonce(request: NextRequest, nonce: string): NextResponse {
  const headers = new Headers(request.headers)
  headers.set('x-nonce', nonce)
  return NextResponse.next({ request: { headers } })
}

export const config = {
  matcher: ['/((?!_next/static|_next/image|favicon.ico).*)'],
}

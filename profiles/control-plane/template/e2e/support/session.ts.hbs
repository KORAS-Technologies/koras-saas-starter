import type { BrowserContext } from '@playwright/test'
import { mintSession } from '@{{projectSlug}}/auth'
import type { PlatformRole } from '@{{projectSlug}}/permissions'

/**
 * Sign a browser in, using the application's own minting function.
 *
 * Imported rather than reimplemented, and that is the whole history of this
 * file. It used to build a ZITADEL-shaped ID token by hand, because the ID
 * token was the cookie. It is not any more — the provider's token is verified
 * once at sign-in and what it establishes is minted into a cookie the
 * application signs itself — and the hand-built copy went on producing the old
 * shape until every test failed at once. That was the suite working. Had the
 * helper been the thing that changed, it would have been silence.
 *
 * Nothing is bypassed. The middleware verifies this signature on every request,
 * so a test signs in the way a person does and is refused the same way.
 *
 * **No provider token.** That second cookie is forwarded to the platform API,
 * which does not run here; sending a fake one would test a path this suite
 * cannot follow. Its absence is a supported state — the middleware never reads
 * it.
 */
const SESSION_SECRET =
  process.env.SESSION_SECRET ?? 'e2e-session-secret-at-least-32-characters-long'

export async function signInAs(
  context: BrowserContext,
  options: {
    /** Omitted means signed in and not staff, which is a refusal worth testing. */
    role?: PlatformRole
    email?: string
    organizationId?: string
    /** Defaults true: staff without a second factor are refused, and a suite
     *  that quietly omitted it would be testing a configuration nobody runs. */
    withMfa?: boolean
  } = {},
): Promise<void> {
  const cookie = await mintSession(
    {
      userId: 'e2e-subject',
      email: options.email ?? 'staff@korastech.com',
      name: 'Test Staff',
      platformRole: options.role,
      organizationId: options.organizationId,
      usedMfa: options.withMfa !== false,
    },
    SESSION_SECRET,
    Math.floor(Date.now() / 1000) + 3600,
  )

  await context.addCookies([
    {
      name: 'session',
      value: cookie,
      domain: 'localhost',
      path: '/',
      httpOnly: true,
      sameSite: 'Lax',
    },
  ])
}

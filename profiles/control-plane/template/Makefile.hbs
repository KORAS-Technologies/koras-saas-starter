# {{projectName}} — generated by create-koras-app
# Profile:      {{profile}}
# Applications: {{#each enabledApplications}}{{this}} {{/each}}
# Services:     {{#each enabledServices}}{{this}} {{/each}}

PROFILE := {{profile}}
PROJECT_SLUG := {{projectSlug}}
# Raise on a machine with memory to spare; lower if builds die with allocation
# failures. See the `build` target.
BUILD_CONCURRENCY ?= 4

APPS := {{#each enabledApplications}}{{this}} {{/each}}
SERVICES := {{#each enabledServices}}{{this}} {{/each}}

ifeq ($(OS),Windows_NT)
  SHELL := C:/Program Files/Git/bin/bash.exe
else
  SHELL := bash
endif
.SHELLFLAGS := -euo pipefail -c

.DEFAULT_GOAL := help

.PHONY: help profile install bootstrap ports dev down reset seed test health lint typecheck build clean doppler-check doppler-bootstrap doppler-bootstrap-prod

help:
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2}'

profile: ## Show the generator profile and enabled components
	@echo "profile:      $(PROFILE)"
	@echo "project:      $(PROJECT_SLUG)"
	@echo "applications: $(APPS)"
	@echo "services:     $(SERVICES)"

# uv sync --all-packages installs every workspace member. A bare `uv sync`
# installs only the root dev tools, which leaves mypy unable to resolve fastapi,
# pydantic and sqlalchemy -- and, with ignore_missing_imports, silently treating
# them as Any rather than reporting them missing.
install: ## Install all dependencies
	pnpm install
	uv sync --all-packages

bootstrap: install ## Full local environment setup
	bash ./local/scripts/bootstrap.sh

ports: ## Re-resolve host ports (use after freeing a preferred port)
	bash ./local/scripts/ports.sh --reset

dev: ## Start local development stack
	docker compose -f local/docker-compose.yml up -d
	pnpm turbo run dev

down: ## Stop local stack
	docker compose -f local/docker-compose.yml down

reset: down ## Wipe volumes and re-bootstrap
	docker compose -f local/docker-compose.yml down -v
	$(MAKE) bootstrap

seed: ## Populate development fixtures
	bash ./local/scripts/seed.sh

test: ## Run all test suites
	pnpm turbo run test
	uv run pytest

health: ## Poll all services until healthy
	bash ./local/scripts/health.sh

doppler-check: ## Verify every Doppler environment holds every setting (names only, never values)
	bash ./local/scripts/doppler-check.sh

doppler-bootstrap: ## Populate Doppler for dev, test and stg from Terraform outputs and prompts
	bash ./local/scripts/doppler-bootstrap.sh

# prod is a separate target rather than a flag. `make doppler-bootstrap
# --environment prod` does not reach the script: make consumes the option and
# reads `prod` as a target name, so the default set runs and production is
# silently skipped. Anything else the script accepts -- --dry-run, --outputs,
# --overwrite -- has to be run against the script directly.
doppler-bootstrap-prod: ## Populate prod, which doppler-bootstrap deliberately skips
	bash ./local/scripts/doppler-bootstrap.sh --environment prod

lint: ## Lint all sources
	pnpm turbo run lint
	uv run ruff check .

# Every service names its source package `src`, so a repo-wide `mypy .` sees
# duplicate modules and refuses to continue. Check one service root at a time.
typecheck: ## Type-check all sources
	pnpm turbo run typecheck
	uv run mypy python-packages services

# --concurrency is capped deliberately. Turbo defaults to roughly one task per
# core, and each `tsc` reserves a few hundred MB of commit before it does any
# work. On a developer machine already running a local stack, twenty at once
# exhausts the Windows commit limit and the builds fail together with
# VirtualAlloc, DLL-init and zone-allocation errors, none of which name memory
# as the cause.
build: ## Build all packages
	pnpm turbo run build --concurrency=$(BUILD_CONCURRENCY)

clean: ## Remove build artifacts
	pnpm turbo run clean
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true

{
  "name": "{{projectSlug}}",
  "version": "0.1.0",
  "private": true,
  "description": "KORAS Control Plane — platform provisioning and entitlement authority",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm lint:py",
    "lint:py": "uv run ruff check .",
    "typecheck": "turbo run typecheck && pnpm typecheck:py",
    "typecheck:py": "uv run mypy python-packages services",
    "test": "turbo run test && pnpm test:py",
    "test:py": "uv run pytest",
    "dev": "turbo run dev",
    "e2e": "turbo run build --filter=@{{projectSlug}}/admin --filter=@{{projectSlug}}/portal && tsc --noEmit -p tsconfig.e2e.json && playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "bootstrap": "bash local/scripts/bootstrap.sh",
    "stack:ports": "bash local/scripts/ports.sh --reset",
    "stack:preflight": "bash local/scripts/preflight.sh",
    "stack:up": "node local/scripts/stack.mjs up",
    "stack:stop": "node local/scripts/stack.mjs compose stop",
    "stack:down": "node local/scripts/stack.mjs compose down",
    "stack:status": "node local/scripts/stack.mjs status",
    "stack:reset": "bash local/scripts/reset.sh",
    "stack:seed": "bash local/scripts/seed.sh",
    "stack:health": "bash local/scripts/health.sh",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,yaml,json}\" --ignore-path .gitignore",
    "postman:generate": "node tooling/postman/scripts/generate.mjs --profile control-plane --name \"Koras Control Plane\" --repo-root ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@{{projectSlug}}/auth": "workspace:*",
    "@{{projectSlug}}/permissions": "workspace:*",
    "@next/eslint-plugin-next": "^15.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}

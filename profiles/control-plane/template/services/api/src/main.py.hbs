from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

from .core.observability import setup_telemetry
from .core.settings import settings
from .routers import health, products

app = FastAPI(
    title="KORAS Control Plane API",
    version="0.1.0",
    docs_url="/api/docs" if settings.environment != "prod" else None,
    redoc_url=None,
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=[str(origin) for origin in settings.cors_origins],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

setup_telemetry(app, service_name="{{projectSlug}}-api")

app.include_router(health.router, prefix="/api/v1")
app.include_router(products.router, prefix="/api/platform/v1")

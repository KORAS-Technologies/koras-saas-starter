#!/usr/bin/env bash
# Resolves the host ports for the local stack and persists them to local/.env,
# which Docker Compose loads automatically.
#
# Host ports are a machine-global resource. A fixed value collides with anything
# else already using it — another KORAS project, a Supabase CLI stack, a stray
# container from last month, or on Windows a kernel reservation held by http.sys
# (IIS, SQL Server Reporting Services). The values in the compose file are
# therefore *preferences*: this script keeps them when they are free and walks
# upward to the next free port when they are not.
#
# Assignments are written once and then reused, so a stack keeps its ports across
# restarts and the URLs you bookmarked stay correct. To re-resolve from scratch
# (say, after freeing a port you would rather use), run `make ports`.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
ENV_FILE="$ROOT/local/.env"

# Preferred host port for each published service, chosen at generation time.
# Format: VARIABLE PREFERRED
PREFERENCES="
KORAS_PORT_SUPABASE_DB {{ports.supabaseDb}}
KORAS_PORT_ZITADEL {{ports.zitadel}}
KORAS_PORT_REDIS {{ports.redis}}
KORAS_PORT_MAIL_SMTP {{ports.mailSmtp}}
KORAS_PORT_MAIL_UI {{ports.mailUi}}
KORAS_PORT_PROXY_HTTP {{ports.proxyHttp}}
KORAS_PORT_PROXY_HTTPS {{ports.proxyHttps}}
KORAS_PORT_OTLP_GRPC {{ports.otlpGrpc}}
KORAS_PORT_OTLP_HTTP {{ports.otlpHttp}}
{{#if apps.platform_admin}}KORAS_PORT_APP_ADMIN {{ports.appAdmin}}
{{/if}}{{#if apps.portal}}KORAS_PORT_APP_PORTAL {{ports.appPortal}}
{{/if}}{{#if service.api}}KORAS_PORT_SERVICE_API {{ports.serviceApi}}
{{/if}}"

if [ "${1:-}" = "--reset" ]; then
  rm -f "$ENV_FILE"
fi

PY="$(command -v python3 || command -v python || true)"

# Whether the port is genuinely available, which needs two different tests.
#
#   bind    — catches kernel reservations. On Windows a port can sit in an
#             http.sys exclusion range with nothing listening on it; connect
#             says "free" while Docker fails with "forbidden by its access
#             permissions".
#   connect — catches ports Docker has already published. Docker Desktop's
#             relay does not conflict with a plain bind on Windows, so a bind
#             test alone reports an occupied container port as free.
#
# A port is available only when it binds AND refuses connections.
port_free() {
  local port="$1"
  if [ -n "$PY" ]; then
    "$PY" -c '
import socket, sys
port = int(sys.argv[1])
b = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
    b.bind(("0.0.0.0", port))
except OSError:
    sys.exit(1)
finally:
    b.close()
c = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
c.settimeout(0.35)
try:
    c.connect(("127.0.0.1", port))
except OSError:
    sys.exit(0)
else:
    sys.exit(1)
finally:
    c.close()
' "$port" >/dev/null 2>&1
  else
    # Fallback without Python: connect only, so kernel reservations slip past.
    ! (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null
  fi
}

existing_value() {
  [ -f "$ENV_FILE" ] || return 0
  sed -n "s/^$1=//p" "$ENV_FILE" | tail -1
}

CLAIMED=" "
resolved=""
changed=0

while read -r var preferred; do
  [ -n "$var" ] || continue

  # An assignment already made for this project is authoritative: re-probing
  # would report our own running container's port as taken and reassign it.
  keep="$(existing_value "$var")"
  if [ -n "$keep" ]; then
    CLAIMED="$CLAIMED$keep "
    resolved="$resolved$var=$keep"$'\n'
    continue
  fi

  port="$preferred"
  limit=$((preferred + 200))
  while [ "$port" -le "$limit" ]; do
    case "$CLAIMED" in *" $port "*) port=$((port + 1)); continue ;; esac
    if port_free "$port"; then break; fi
    port=$((port + 1))
  done

  if [ "$port" -gt "$limit" ]; then
    echo "    No free host port found near $preferred for $var." >&2
    exit 1
  fi

  if [ "$port" != "$preferred" ]; then
    echo "    $var: $preferred is unavailable, using $port"
  fi
  changed=1
  CLAIMED="$CLAIMED$port "
  resolved="$resolved$var=$port"$'\n'
done <<EOF
$PREFERENCES
EOF

printf '# Generated by local/scripts/ports.sh — machine-specific, not committed.\n# Re-resolve with: make ports\n%s' "$resolved" > "$ENV_FILE"

if [ "$changed" = "1" ]; then
  echo "    Host ports written to local/.env"
fi

#!/usr/bin/env bash
# Full local environment bootstrap.
# Safe to re-run — idempotent where possible.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
PROFILE="${KORAS_PROFILE:-control-plane}"

echo "==> Bootstrapping KORAS local environment (profile: ${PROFILE})"
echo ""

# 1. Node dependencies
echo "--> Installing Node dependencies..."
cd "$ROOT" && pnpm install

# 2. Python dependencies
echo "--> Installing Python dependencies..."
cd "$ROOT" && uv sync --all-packages

# 3. TLS certificates
if [ ! -f "$ROOT/local/certs/admin.localhost.pem" ]; then
  echo "--> Generating TLS certificates..."
  bash "$ROOT/local/certs/generate.sh"
else
  echo "--> TLS certificates already present, skipping."
fi

# Resolve host ports before anything binds them, then load the assignments so
# the URLs below match what Compose actually publishes.
bash "$ROOT/local/scripts/ports.sh"
set -a
. "$ROOT/local/.env"
set +a

# 4. Pull Docker images
echo "--> Pulling Docker images..."
# One rendered compose file per project — the profile decided what went into it
# at generation time. The ZITADEL overrides beside it are applied by stack.mjs
# alone. compose-env.sh carries the values compose needs to read the file at
# all, and no key.
. "$ROOT/local/scripts/compose-env.sh"
docker compose -f "$ROOT/local/docker-compose.yml" pull --quiet

# 5-8. ZITADEL, then every other container. stack.mjs decides: no instance
# recorded means a new secure one (provision --fresh: a generated masterkey,
# escrowed to Doppler and to the encrypted backup *before* the instance
# exists, and a generated admin password); one left half-provisioned is
# finished; a ready one is started through the same checks as `make dev`.
# It refuses rather than guesses -- an unrecorded database, a moved port, a
# key whose fingerprint differs -- and bootstrap stops with it.
#
# KORAS_ZITADEL_OFFLINE=1 creates an unescrowed instance when Doppler is out of
# reach; bootstrap then stops until `node local/scripts/stack.mjs escrow`
# completes both legs (A3). ADRs 0015-0017.
echo "--> Starting the stack through local/scripts/stack.mjs..."
node "$ROOT/local/scripts/stack.mjs" bootstrap

# 9. Create .env.local from the template if it is missing.
if [ ! -f "$ROOT/.env.local" ]; then
  echo "--> Creating .env.local from example..."
  cp "$ROOT/local/config/.env.local.example" "$ROOT/.env.local"
  echo "    Populate the ZITADEL client values before running the services."
fi

# 10. Reconcile .env.local with the ports actually resolved, and add any key the
# template has gained since this file was created. Both matter: `make ports` can
# reassign a port when another stack takes it, and a stale .env.local then aims a
# service at whatever now holds the old number -- possibly another KORAS
# project's database or queue. Replace-or-append, so re-running is idempotent and
# an older .env.local picks up newly required settings instead of failing at
# startup with no explanation.
echo "--> Reconciling .env.local with resolved host ports..."

set_env_var() {
  local key="$1" value="$2" file="$ROOT/.env.local"
  if grep -q "^${key}=" "$file"; then
    sed -i "s#^${key}=.*#${key}=${value}#" "$file"
  else
    echo "    + ${key} (added)"
    echo "${key}=${value}" >> "$file"
  fi
}

set_env_var ENVIRONMENT "dev"
set_env_var DATABASE_URL "postgresql://postgres:postgres@127.0.0.1:${KORAS_PORT_SUPABASE_DB}/postgres"
set_env_var ZITADEL_DOMAIN "http://localhost:${KORAS_PORT_ZITADEL}"

# What provision.py discovered. Sourced rather than duplicated: one writer for
# .env.local, so the file cannot disagree with the instance it describes.
PROVISIONED="$ROOT/local/zitadel/provisioned.env"
if [ -f "$PROVISIONED" ]; then
  while IFS="=" read -r key value; do
    case "$key" in ""|\#*) continue ;; esac
    set_env_var "$key" "$value"
  done < "$PROVISIONED"
else
  echo "    ! local/zitadel/provisioned.env is missing; sign-in will not work."
fi

# Signs the applications' own session cookie. Generated once and kept, so a
# re-bootstrap does not invalidate every open session on the machine.
if ! grep -q "^SESSION_SECRET=" "$ROOT/.env.local" 2>/dev/null; then
  set_env_var SESSION_SECRET "$(head -c 48 /dev/urandom | base64 | tr -d "
")"
fi
set_env_var REDIS_URL "redis://127.0.0.1:${KORAS_PORT_REDIS}"
set_env_var SMTP_PORT "${KORAS_PORT_MAIL_SMTP}"
set_env_var OTEL_EXPORTER_OTLP_ENDPOINT "http://127.0.0.1:${KORAS_PORT_OTLP_GRPC}"

# 11. Apply the Control Plane schema. Without this the local database has no
# tables at all, so nothing touching persistence can be developed or tested.
echo "--> Applying database schema..."
bash "$ROOT/local/scripts/migrate.sh"

echo ""
echo "==> Bootstrap complete."
echo "    Run: make dev"

# KORAS Control Plane — local development environment.
#
# Copy to .env.local and populate. NEVER commit .env.local; it is gitignored.
# In every deployed environment these values come from Doppler, not from a file.
#
# `make bootstrap` writes .env.local from this template and substitutes the host
# ports that local/scripts/ports.sh actually resolved. Ports are a machine-global
# resource, so the values below are only the preferences: if another stack
# already holds one, ports.sh walks to the next free port and bootstrap rewrites
# the URLs here to match. Do not assume the numbers below are what is running.

# ── Environment ──────────────────────────────────────────────────────────────
# One of: dev, test, stg, prod. Required, and deliberately has no default in
# code: a missing or misspelled value must fail at startup rather than silently
# selecting an environment. Local development is always `dev`.
ENVIRONMENT=dev
NODE_ENV=development

# ── Applications ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_URL=https://admin.localhost
NEXT_PUBLIC_PORTAL_URL=https://portal.localhost
NEXT_PUBLIC_API_URL=https://api.localhost

# ── Database (Supabase local) ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:{{ports.supabaseDb}}/postgres

# ── ZITADEL ──────────────────────────────────────────────────────────────────
# Local development runs a single ZITADEL instance standing in for the DEV
# instance. The four real instances are never reachable from a local stack.
ZITADEL_DOMAIN=http://localhost:{{ports.zitadel}}
ZITADEL_PROJECT_ID=<from-zitadel-console>
ZITADEL_CLIENT_ID=<from-zitadel-console>
ZITADEL_CLIENT_SECRET=<from-zitadel-console>

# Signs this application's own session cookie.
#
# Not the provider's secret. The ID token is verified once at sign-in and
# never again, so middleware needs no network call -- which matters because
# the edge runtime cannot always reach the identity provider that the Node
# runtime can. At least 32 characters, and different in every environment:
# one shared key makes a development cookie a production cookie.
#   openssl rand -base64 48
SESSION_SECRET=<generate-one-per-environment>
ZITADEL_ADMIN_REDIRECT_URI=https://admin.localhost/api/auth/callback
ZITADEL_PORTAL_REDIRECT_URI=https://portal.localhost/api/auth/callback

# ── Queue ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:{{ports.redis}}

# ── Mail (Mailpit) ───────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT={{ports.mailSmtp}}
SMTP_SECURE=false
SMTP_FROM=noreply@koras.local

# ── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Only a hosted collector needs this. The local one takes no credential.
OTEL_EXPORTER_OTLP_HEADERS=
# grpc locally; http/protobuf for a managed collector.
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=koras-control-plane

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["https://admin.localhost","https://portal.localhost"]

# ── Not applicable to the Control Plane ──────────────────────────────────────
# This profile has no MinIO/object storage stack, no AI gateway, and no
# CONTROL_PLANE_URL: the Control Plane is not a client of itself. Those settings
# belong to `--profile product` repositories. See docs/ARCHITECTURE.md.

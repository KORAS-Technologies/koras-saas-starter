# Host ports come from local/.env, written by local/scripts/ports.sh so that a
# busy port on one machine does not wedge the whole stack. The `\{{!}}` after each
# preference is an empty Handlebars comment: without it the template's `}}` and
# the shell's closing `}` would collide into `}}}`, which Handlebars misreads as
# a triple-stash. It renders nothing.
name: {{projectSlug}}

services:
  # ── Database (Supabase local) ───────────────────────────────────────────────
  supabase-db:
    image: supabase/postgres:15.6.1.143
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: postgres
    ports:
      - "${KORAS_PORT_SUPABASE_DB:-{{ports.supabaseDb}}{{!}}}:5432"
    volumes:
      - supabase-db:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "postgres"]
      interval: 5s
      timeout: 5s
      retries: 10

  # ── ZITADEL ─────────────────────────────────────────────────────────────────
  zitadel:
    image: ghcr.io/zitadel/zitadel:v4.17.1
    restart: unless-stopped
    command: start-from-init --masterkeyFromEnv --tlsMode disabled
    environment:
      ZITADEL_MASTERKEY: MasterkeyNeedsToHave32Characters
      ZITADEL_DATABASE_POSTGRES_HOST: supabase-db
      ZITADEL_DATABASE_POSTGRES_PORT: 5432
      ZITADEL_DATABASE_POSTGRES_DATABASE: zitadel
      ZITADEL_DATABASE_POSTGRES_USER_USERNAME: postgres
      ZITADEL_DATABASE_POSTGRES_USER_PASSWORD: postgres
      ZITADEL_DATABASE_POSTGRES_USER_SSL_MODE: disable
      ZITADEL_DATABASE_POSTGRES_ADMIN_USERNAME: postgres
      ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD: postgres
      ZITADEL_DATABASE_POSTGRES_ADMIN_SSL_MODE: disable
      ZITADEL_EXTERNALSECURE: "false"
      ZITADEL_EXTERNALPORT: ${KORAS_PORT_ZITADEL:-{{ports.zitadel}}{{!}}}
      ZITADEL_EXTERNALDOMAIN: localhost
    ports:
      - "${KORAS_PORT_ZITADEL:-{{ports.zitadel}}{{!}}}:8080"
    depends_on:
      supabase-db:
        condition: service_healthy
    # No container healthcheck: the image is distroless (no curl/wget) and
    # `zitadel ready` reports not-ready against a server that is serving
    # traffic. `make health` probes http://localhost:8080/debug/ready instead.

  # ── Redis ────────────────────────────────────────────────────────────────────
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    ports:
      - "${KORAS_PORT_REDIS:-{{ports.redis}}{{!}}}:6379"
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5

  # ── Mail ─────────────────────────────────────────────────────────────────────
  mail:
    image: axllent/mailpit:latest
    restart: unless-stopped
    ports:
      - "${KORAS_PORT_MAIL_SMTP:-{{ports.mailSmtp}}{{!}}}:1025"
      - "${KORAS_PORT_MAIL_UI:-{{ports.mailUi}}{{!}}}:8025"
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:8025/"]
      interval: 10s
      timeout: 5s
      retries: 5

  # ── Observability ────────────────────────────────────────────────────────────
  # Services export OTLP to the collector, which fans traces out to Tempo and
  # logs to Loki. Only the collector publishes host ports: Loki and Tempo are
  # reached by service name inside this network, and leaving them unpublished
  # keeps two host ports free on a machine running several stacks.
  otel-collector:
    image: otel/opentelemetry-collector-contrib:0.115.1
    restart: unless-stopped
    command: ["--config=/etc/otel-collector.yml"]
    ports:
      - "${KORAS_PORT_OTLP_GRPC:-{{ports.otlpGrpc}}{{!}}}:4317"
      - "${KORAS_PORT_OTLP_HTTP:-{{ports.otlpHttp}}{{!}}}:4318"
    volumes:
      - ./observability/otel-collector.yml:/etc/otel-collector.yml:ro
    depends_on:
      - loki
      - tempo

  loki:
    image: grafana/loki:3.3.2
    restart: unless-stopped
    command: ["-config.file=/etc/loki/loki.yml"]
    volumes:
      - ./observability/loki.yml:/etc/loki/loki.yml:ro
      - loki-data:/loki

  tempo:
    image: grafana/tempo:2.6.1
    restart: unless-stopped
    command: ["-config.file=/etc/tempo/tempo.yml"]
    volumes:
      - ./observability/tempo.yml:/etc/tempo/tempo.yml:ro
      - tempo-data:/var/tempo

  # ── Proxy (Caddy) ─────────────────────────────────────────────────────────────
  proxy:
    image: caddy:2-alpine
    restart: unless-stopped
    ports:
      - "${KORAS_PORT_PROXY_HTTP:-{{ports.proxyHttp}}{{!}}}:80"
      - "${KORAS_PORT_PROXY_HTTPS:-{{ports.proxyHttps}}{{!}}}:443"
    environment:
{{#if apps.platform_admin}}      KORAS_PORT_APP_ADMIN: ${KORAS_PORT_APP_ADMIN:-{{ports.appAdmin}}{{!}}}
{{/if}}{{#if apps.portal}}      KORAS_PORT_APP_PORTAL: ${KORAS_PORT_APP_PORTAL:-{{ports.appPortal}}{{!}}}
{{/if}}{{#if service.api}}      KORAS_PORT_SERVICE_API: ${KORAS_PORT_SERVICE_API:-{{ports.serviceApi}}{{!}}}
{{/if}}    volumes:
      - ./proxy/Caddyfile:/etc/caddy/Caddyfile:ro
      - ./certs:/certs:ro
      - caddy-data:/data
    depends_on:
      - zitadel

volumes:
  supabase-db:
  redis-data:
  caddy-data:
  loki-data:
  tempo-data:

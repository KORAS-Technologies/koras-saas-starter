import { defineConfig, devices } from '@playwright/test'

/**
 * The one suite here that opens a browser.
 *
 * It exists because the admin application's authorisation lives in middleware,
 * and middleware is the one layer a unit test cannot reach: it runs before
 * routing, on a request that has not become a page yet. `canAccess` is tested
 * as a function; whether the application actually calls it on the URL a browser
 * asks for is a different claim, and it was an untested one.
 *
 * **One server, built and started here**, so the suite owns its lifecycle. The
 * production build, not `next dev`: the middleware, the CSP nonce and the
 * client boundaries all behave differently there, and the build is what ships.
 *
 * **No API and no ZITADEL.** Every assertion below is about a request this
 * application refuses or admits by itself, from a cookie it signed. A suite
 * that needed the platform running to check a 403 would be a suite nobody runs
 * — and the sign-in exchange, which does need ZITADEL, is deliberately out of
 * scope rather than faked.
 */

const PORT = Number(process.env.E2E_PORT ?? 3220)

/**
 * The customer-facing portal, started so its production policy can be read.
 *
 * It carries its own copy of `contentSecurityPolicy()`, identical to the
 * admin application's but a separate file, so a policy checked on `admin`
 * alone leaves half of this profile's CSP-bearing applications unproven.
 */
const PORTAL_PORT = Number(process.env.E2E_PORTAL_PORT ?? 3221)
const PORTAL_URL = `http://localhost:${PORTAL_PORT}`

/**
 * The origins `csp.spec.ts` reads, as `label=origin` pairs. Set here so the
 * ports live in one place; Playwright evaluates this config before workers are
 * spawned, so they inherit it.
 */
process.env.E2E_CSP_ORIGINS ??= [`admin=http://localhost:${PORT}`, `portal=${PORTAL_URL}`].join(',')

export default defineConfig({
  testDir: './e2e',
  timeout: 30_000,
  fullyParallel: false,
  forbidOnly: !!process.env.CI,
  retries: process.env.CI ? 1 : 0,
  workers: 1,
  // `github` annotates the failing line in a pull request; `html` writes the
  // trace that explains it. This repository's downstream suite configured only
  // the first and uploaded a report directory that was never produced, so every
  // failure was read from a text log.
  reporter: process.env.CI ? [['github'], ['html', { open: 'never' }]] : [['list']],
  use: {
    baseURL: `http://localhost:${PORT}`,
    trace: 'retain-on-failure',
  },
  projects: [{ name: 'admin', use: { ...devices['Desktop Chrome'] } }],
  webServer: [
    {
      command: `pnpm --filter @{{projectSlug}}/admin exec next start -p ${PORT}`,
      url: `http://localhost:${PORT}/login`,
      reuseExistingServer: !process.env.CI,
      timeout: 120_000,
      env: {
        // The application refuses a signing key shorter than 32 characters, so
        // a test value has to be a real one. The suite signs cookies with this
        // and the middleware verifies them: nothing is bypassed, and a suite
        // that skipped verification would pass however broken authorisation
        // became.
        SESSION_SECRET:
          process.env.SESSION_SECRET ?? 'e2e-session-secret-at-least-32-characters-long',
      },
    },
    {
      // Started for `csp.spec.ts` alone.
      command: `pnpm --filter @{{projectSlug}}/portal exec next start -p ${PORTAL_PORT}`,
      url: `${PORTAL_URL}/login`,
      reuseExistingServer: !process.env.CI,
      timeout: 120_000,
      env: {
        SESSION_SECRET:
          process.env.SESSION_SECRET ?? 'e2e-session-secret-at-least-32-characters-long',
      },
    },
  ],
})

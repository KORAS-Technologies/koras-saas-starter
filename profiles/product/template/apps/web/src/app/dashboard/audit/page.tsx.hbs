import { AccessDenied, Container } from '@{{projectSlug}}/ui'
import { can, signedInContext } from '../../../lib/access'
import { currentLocale, translator } from '../../../lib/locale'
import { AuditPanel } from './AuditPanel'
import { listExports, searchAudit } from './actions'

/**
 * Audit: what happened in this tenant, for the people entitled to ask.
 *
 * Two gates before anything renders, and a third inside the API. The caller's
 * permission (`audit.view`), checked here as well as in the middleware because
 * a page is reachable by more than one route. Then the API, which decides
 * again with the same token and -- this is the part the page cannot do --
 * decides which *classes* of record the caller may see. A security-classified
 * row never reaches this process for an ordinary member, so there is no
 * client-side redaction that could be got wrong.
 *
 * There is no entitlement gate. Reading one's own audit history is not a paid
 * feature: a customer who cannot answer "who deleted that" has a product they
 * cannot be accountable for. Exporting is the gated half, and only because a
 * copy leaves the product.
 *
 * Both lists are read here so the first paint has them in it; everything after
 * is a server action.
 *
 * **Both**, because for a while only the search was. The exports list started
 * empty and filled on Refresh, so somebody who started an export, went away and
 * came back was told "No exports yet" while their file sat ready. Found by
 * opening the page on 2026-09-17.
 */
export const dynamic = 'force-dynamic'

export default async function AuditPage() {
  const [context, locale, t] = await Promise.all([signedInContext(), currentLocale(), translator()])
  if (context === null || !can(context.access, 'audit.view')) {
    return <AccessDenied locale={locale} />
  }

  const [initial, initialExports] = await Promise.all([searchAudit({}), listExports()])

  // Built here rather than inline: a JSX prop given an object literal opens
  // with two braces, which the generator reads as a Handlebars expression.
  const labels = {
    filters: t('audit.filters'),
    action: t('audit.action'),
    actor: t('audit.actor'),
    outcome: t('audit.outcome'),
    classification: t('audit.classification'),
    any: t('audit.any'),
    apply: t('audit.apply'),
    clear: t('audit.clear'),
    searching: t('audit.searching'),
    empty: t('audit.empty'),
    emptyFiltered: t('audit.emptyFiltered'),
    more: t('audit.more'),
    when: t('audit.when'),
    what: t('audit.what'),
    who: t('audit.who'),
    target: t('audit.target'),
    result: t('audit.result'),
    kind: t('audit.kind'),
    details: t('audit.details'),
    exportTitle: t('audit.exportTitle'),
    exportDescription: t('audit.exportDescription'),
    exportFormat: t('audit.exportFormat'),
    exportStart: t('audit.exportStart'),
    exportPending: t('audit.exportPending'),
    exportDownload: t('audit.exportDownload'),
    exportEmpty: t('audit.exportEmpty'),
    exportRowsOne: t('audit.exportRows.one'),
    exportRowsOther: t('audit.exportRows.other'),
    restricted: t('audit.restricted'),
  }

  return (
    <div className="py-12">
      <Container>
        <h1 className="font-display text-2xl font-bold text-ink">{t('audit.title')}</h1>
        <p className="mt-2 max-w-3xl text-sm leading-6 text-ink-muted">{t('audit.description')}</p>
        <AuditPanel
          initial={initial}
          initialExports={initialExports}
          canExport={can(context.access, 'audit.export')}
          locale={locale}
          labels={labels}
        />
      </Container>
    </div>
  )
}

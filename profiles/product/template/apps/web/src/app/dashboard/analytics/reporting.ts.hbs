import 'server-only'
import { cache } from 'react'
import {
  ApiError,
  fetchReport,
  fetchReportData,
  fetchReportExports,
  fetchReportSchedules,
  fetchReports,
} from '@{{projectSlug}}/api-client'
import type {
  ReportData,
  ReportExportList,
  ReportList,
  ReportQuery,
  ReportSchedule,
  ReportView,
} from '@{{projectSlug}}/api-client'
import { can, signedInContext } from '../../../lib/access'
import { apiErrorMessage } from '../../../lib/api-errors'
import { translator } from '../../../lib/locale'
import { apiBaseUrl, providerToken } from '../../../lib/session'

/**
 * The analytics pages' server half.
 *
 * Every read re-establishes who is calling and what they may do before it
 * talks to the API, and the API decides again with the same token. Nothing
 * here reaches the browser: not the API's address, not the token, and not
 * a resolver's detail -- a refusal arrives as a status and leaves as a
 * sentence in the reader's language.
 *
 * Plain server functions rather than server actions: a page reads a report
 * while rendering, and a form that changes the filters submits to the page
 * itself. Nothing on this surface needs a client to call back.
 */

export type Loaded<T> =
  | { status: 'ok'; value: T }
  | { status: 'locked'; message: string }
  | { status: 'error'; message: string }

const session = cache(async () => {
  const context = await signedInContext()
  if (context === null || !can(context.access, 'reports.read')) return null
  const token = await providerToken()
  const baseUrl = apiBaseUrl()
  if (!token || !baseUrl) return null
  return { baseUrl, token }
})

/** Turn the API's refusal into a sentence, and a plan gate into its own state. */
async function explain<T>(error: unknown): Promise<Loaded<T>> {
  const t = await translator()
  if (error instanceof ApiError) {
    if (error.status === 402) return { status: 'locked', message: t('analytics.error.plan') }
    const coded = apiErrorMessage(t, error.code)
    if (coded !== null) return { status: 'error', message: coded }
    if (error.status === 403 || error.status === 404) {
      return { status: 'error', message: t('analytics.error.forbidden') }
    }
    if (error.status === 422) return { status: 'error', message: t('analytics.error.filters') }
    if (error.status === 0 || error.status >= 500) {
      return { status: 'error', message: t('analytics.error.unavailable') }
    }
  }
  return { status: 'error', message: t('analytics.error.generic') }
}

export const loadReports = cache(async (): Promise<Loaded<ReportList>> => {
  const auth = await session()
  if (auth === null) return { status: 'error', message: (await translator())('analytics.error.forbidden') }
  try {
    return { status: 'ok', value: await fetchReports(auth) }
  } catch (error) {
    return explain(error)
  }
})

export async function loadReport(key: string): Promise<Loaded<ReportView>> {
  const auth = await session()
  if (auth === null) return { status: 'error', message: (await translator())('analytics.error.forbidden') }
  try {
    return { status: 'ok', value: await fetchReport({ ...auth, key }) }
  } catch (error) {
    return explain(error)
  }
}


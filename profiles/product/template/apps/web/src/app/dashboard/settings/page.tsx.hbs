import { fetchSettingDefinitions, fetchTenantSettingValues } from '@{{projectSlug}}/api-client'
import { productConfig } from '@{{projectSlug}}/branding'
import { LOCALE_NAMES, isLocale } from '@{{projectSlug}}/i18n'
import {
  AccessDenied,
  Button,
  Card,
  Container,
  SelectField,
  SettingsForm,
  ThemeToggle,
  codeTag,
  rich,
} from '@{{projectSlug}}/ui'
import { can, signedInContext } from '../../../lib/access'
import { currentLocale, translator } from '../../../lib/locale'
import { apiBaseUrl, providerToken } from '../../../lib/session'
import { settingGroups } from '../../../lib/setting-fields'
import { effectiveSettings } from '../../../lib/settings'
import { tenantSettings } from '../../../lib/tenant-settings'
import { resetOrganizationSetting, saveOrganizationSettings } from './actions'
import { TenantLocaleForm } from './TenantLocaleForm'

/**
 * Product settings, general.
 *
 * What this product is, what this build contains, and what this customer's plan
 * resolved to -- with the file that decides each one named beside it. That is a
 * real page rather than a placeholder: it is the answer to "why can I not see
 * X", which in a product with four independent gates is the question somebody
 * asks every week.
 *
 * It offers two controls, and the exception is instructive. Renaming the
 * product, changing its colours and adding a module are edits to
 * `packages/branding/src/index.ts` -- one file, in the product's own
 * repository, reviewed like any other change -- and a settings screen that
 * wrote them at runtime would put a second authority beside the one the whole
 * frontend already reads from. The language is different: it is a choice about
 * *this person*, it changes nothing for anybody else, and the product already
 * has to honour it from a cookie. So the form here posts to the same route the
 * switcher does, which sets the cookie and -- for a signed-in member -- keeps
 * the choice with their account, so it follows them to the next device.
 *
 * The second control is the organisation's default: what a member sees before
 * they choose. It is a choice about other people, so it is shown to whoever
 * holds `settings.manage`, sent through a server action that checks the same
 * permission, and refused again by the API with the same token.
 *
 * Subscriptions, billing, domains, single sign-on and organization membership
 * are **not** here and never will be. They belong to the KORAS Customer Portal.
 */
export const dynamic = 'force-dynamic'

export default async function SettingsPage({
  searchParams,
}: {
  searchParams: Promise<{ saved?: string }>
}) {
  const [context, locale, t, settings, effective, query] = await Promise.all([
    signedInContext(),
    currentLocale(),
    translator(),
    tenantSettings(),
    effectiveSettings(),
    // `query`, not `params`: this page already binds `params` to the
    // translation parameters a few lines below, and two things called params
    // in one function is one too many.
    searchParams,
  ])

  // Checked here as well as in the middleware, which is not duplication: the
  // middleware guards the URL, and this guards the render. A page is reachable
  // by more than one route, and a check that lives only at the edge is a check
  // the next rewrite can lose.
  if (context === null || !can(context.access, 'settings.read')) {
    return <AccessDenied locale={locale} />
  }

  const { product, i18n } = productConfig
  const { entitlements, capabilities } = context.access
  const params = { product: product.name }
  const code = { code: codeTag }

  // The stored default, held to the offered list before it reaches a
  // `defaultValue`: the API holds it to the catalogues that exist, which is
  // the longer list.
  const storedDefault = settings?.locale
  const tenantDefault =
    isLocale(storedDefault) && i18n.locales.includes(storedDefault) ? storedDefault : null

  const [token, baseUrl] = [await providerToken(), apiBaseUrl()]
  const manage = can(context.access, 'settings.manage')

  // What the organisation holds, and what the platform holds beneath it. Not
  // the effective set: an administrator editing the organisation needs to see
  // the organisation's value, or their own override hides the change they just
  // made and they make it twice.
  const [definitions, held] =
    token && baseUrl
      ? await Promise.all([
          fetchSettingDefinitions({ baseUrl, token }).catch(() => []),
          fetchTenantSettingValues({ baseUrl, token }).catch(() => ({})),
        ])
      : [[], {}]

  const platform = Object.fromEntries(
    Object.entries(effective?.settings ?? {}).map(([key, resolved]) => [key, resolved.global_value]),
  )

  const groups = settingGroups({
    definitions,
    values: held,
    inherited: platform,
    t,
    visible: (definition) => definition.org_admin_visible,
  })

  const settingsLabels = {
    save: t('settings.values.save'),
    saving: t('settings.values.saving'),
    modified: t('settings.values.modified'),
    inheritedFrom: t('settings.values.inherited'),
    reset: t('settings.values.reset'),
    // A template, not a closure: this object is handed to a client
    // component, and a function cannot cross that boundary. The
    // translator returns a message unchanged when given no parameters,
    // so the placeholder survives for `withValue` to fill.
    resetTo: t('settings.values.resetTo'),
    listHint: t('settings.values.listHint'),
    on: t('settings.values.on'),
    off: t('settings.values.off'),
  }

  return (
    <div className="py-12">
      <Container>
        <h1 className="font-display text-3xl font-bold tracking-tight text-ink">{t('settings.title')}</h1>
        <p className="mt-3 max-w-2xl leading-7 text-ink-muted">{t('settings.intro', params)}</p>

        <Card className="mt-8 max-w-3xl">
          <h2 className="font-display text-lg font-bold text-ink">{t('settings.product.title')}</h2>
          <dl className="mt-4 space-y-3 text-sm leading-6">
            <Row label={t('settings.product.name')} value={product.name} />
            <Row label={t('settings.product.identifier')} value={product.slug} />
            <Row label={t('settings.product.tagline')} value={product.tagline} />
          </dl>
          <p className="mt-4 text-sm text-ink-muted">{rich(t('settings.product.configuredIn'), code)}</p>
        </Card>

        {/*
          The organisation's own settings, grouped as the catalogue groups them.
          Rendered for anybody who may read settings; the controls are there for
          everybody and the API refuses a write from somebody without
          `settings.manage`, which the page says before they try.
        */}
        <div className="mt-6 max-w-3xl">
          <h2 className="font-display text-xl font-bold text-ink">{t('settings.values.title')}</h2>
          <p className="mt-2 text-sm leading-6 text-ink-muted">
            {t('settings.values.intro', params)}
          </p>

          {/*
            Announced, because a redirect lands on a page that looks the same as
            the one just left.
          */}
          {query.saved ? (
            <p
              className="mt-4 text-sm text-ink-muted"
              role="status"
              data-testid="settings-outcome"
              data-outcome={query.saved}
            >
              {query.saved === 'ok'
                ? t('settings.values.saved')
                : query.saved === 'forbidden'
                  ? t('settings.values.forbidden')
                  : t('settings.values.error')}
            </p>
          ) : null}

          {!manage ? (
            <p className="mt-4 text-sm text-ink-muted" data-testid="settings-readonly">
              {t('settings.values.forbidden')}
            </p>
          ) : null}

          <div className="mt-4">
            {groups.length === 0 ? (
              <p className="text-sm text-ink-muted" data-testid="settings-unavailable">
                {t('settings.values.unavailable')}
              </p>
            ) : (
              <SettingsForm
                groups={groups}
                labels={settingsLabels}
                save={saveOrganizationSettings}
                reset={resetOrganizationSetting}
                testId="organisation-settings"
              />
            )}
          </div>
        </div>

        {/* Rendered only when there is a choice to make. A form offering one
            option asks a person to decide something already decided. */}
        {i18n.locales.length > 1 && (
          <Card className="mt-6 max-w-3xl">
            <h2 className="font-display text-lg font-bold text-ink">{t('settings.language.title')}</h2>
            <p className="mt-2 text-sm leading-6 text-ink-muted">
              {t('settings.language.description', params)}
            </p>
            <p className="mt-2 text-sm leading-6 text-ink-muted">{t('settings.language.remembered')}</p>
            {/* A plain form to the same route the public switcher uses, so a
                choice made here and one made there are one cookie and one
                stored preference, and the page works before any script has
                attached. */}
            <form method="post" action="/api/locale" className="mt-4 flex max-w-sm flex-col gap-4">
              <input type="hidden" name="next" value="/dashboard/settings" />
              <SelectField
                id="settings-locale"
                name="locale"
                label={t('settings.language.label', params)}
                defaultValue={locale}
              >
                {i18n.locales.map((option) => (
                  <option key={option} value={option} lang={option}>
                    {LOCALE_NAMES[option]}
                  </option>
                ))}
              </SelectField>
              <Button type="submit" variant="secondary" className="self-start">
                {t('settings.language.save')}
              </Button>
            </form>

            {/* Shown to whoever may change it for everybody. Hidden rather
                than disabled for the rest: a control somebody cannot use is
                a question they cannot answer, and the API refuses the write
                for them anyway. */}
            {can(context.access, 'settings.manage') && (
              <div className="mt-8 border-t border-line pt-6">
                <h3 className="font-display text-base font-bold text-ink">
                  {t('settings.language.tenantTitle')}
                </h3>
                <p className="mt-2 text-sm leading-6 text-ink-muted">
                  {t('settings.language.tenantDescription')}
                </p>
                <TenantLocaleForm locale={locale} current={tenantDefault} />
              </div>
            )}
          </Card>
        )}

        {/* The one setting on this page that is not a description of
            configuration. It lives in the browser, applies before paint, and
            used to sit in the header beside the language; both moved here
            because a person looks for them here and changes them rarely. */}
        <Card className="mt-6 max-w-3xl">
          <h2 className="font-display text-lg font-bold text-ink">{t('settings.appearance.title')}</h2>
          <p className="mt-2 text-sm leading-6 text-ink-muted">{t('settings.appearance.description')}</p>
          <ThemeToggle locale={locale} className="mt-4" />
        </Card>

        <Card className="mt-6 max-w-3xl">
          <h2 className="font-display text-lg font-bold text-ink">{t('settings.deployment.title')}</h2>
          <p className="mt-2 text-sm leading-6 text-ink-muted">{t('settings.deployment.description')}</p>
          <ul className="mt-4 flex flex-wrap gap-2">
            {capabilities.map((capability) => (
              <li
                key={capability}
                className="rounded-brand bg-surface-muted px-2.5 py-1 text-sm text-ink-muted"
              >
                {capability}
              </li>
            ))}
          </ul>
        </Card>

        <Card className="mt-6 max-w-3xl">
          <h2 className="font-display text-lg font-bold text-ink">{t('settings.plan.title')}</h2>
          {entitlements.resolved ? (
            <>
              <p className="mt-2 text-sm leading-6 text-ink-muted">{t('settings.plan.resolved')}</p>
              <dl className="mt-4 space-y-3 text-sm leading-6">
                <Row
                  label={t('settings.plan.plan')}
                  value={entitlements.plan ?? t('settings.plan.noneRecorded')}
                />
                <Row
                  label={t('settings.plan.features')}
                  value={
                    Object.keys(entitlements.features).length === 0
                      ? t('common.none')
                      : Object.entries(entitlements.features)
                          .filter(([, value]) => value.enabled)
                          .map(([name]) => name)
                          .join(', ')
                  }
                />
              </dl>
            </>
          ) : (
            <p className="mt-2 text-sm leading-6 text-ink-muted">{t('settings.plan.unavailable')}</p>
          )}
          {product.accountUrl === '' ? (
            <p className="mt-4 text-sm text-ink-muted">{rich(t('settings.plan.portalHint'), code)}</p>
          ) : (
            <p className="mt-4 text-sm text-ink-muted">
              {rich(t('settings.plan.manage'), {
                a: (chunk) => (
                  <a href={product.accountUrl} className="font-semibold text-brand underline">
                    {chunk}
                  </a>
                ),
              })}
            </p>
          )}
        </Card>
      </Container>
    </div>
  )
}

function Row({ label, value }: { label: string; value: string }) {
  return (
    <div className="flex flex-col gap-1 border-b border-line pb-3 last:border-0 last:pb-0 sm:flex-row sm:gap-6">
      <dt className="w-48 shrink-0 font-medium text-ink-muted">{label}</dt>
      <dd className="text-ink">{value === '' ? '—' : value}</dd>
    </div>
  )
}

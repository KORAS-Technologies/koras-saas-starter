export async function writeRetention(
  overrides: RetentionOverrides,
): Promise<ActionResult<RetentionOverrides>> {
  const auth = await session()
  if (auth === null) return denied()
  try {
    // Passed through exactly as the form built it. A kind the form left out
    // keeps its stored value and a kind sent as null is removed; filling in
    // the rest here would silently rewrite settings nobody touched, which is
    // the defect a security review found on the API side on 2026-09-16.
    return { status: 'ok', value: await saveRetentionRequest({ ...auth, overrides }) }
  } catch (error) {
    return { status: 'error', message: await explain(error) }
  }
}

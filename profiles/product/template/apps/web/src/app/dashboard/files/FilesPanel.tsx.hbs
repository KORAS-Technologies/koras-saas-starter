'use client'

import { useCallback, useEffect, useRef, useState } from 'react'
import type { ActionResult } from './actions'
import type { FileList } from '@{{projectSlug}}/api-client'
import type { Locale } from '@{{projectSlug}}/i18n'
import { Button, Card } from '@{{projectSlug}}/ui'
{{#if capability.secure_files}}
import { digestOf, putWithProgress } from '../../../lib/browser-upload'
{{/if}}
import { completeUpload, deleteFile, downloadUrl, listFiles, requestUpload } from './actions'
{{#if capability.secure_files}}
import {
  POLL_DEADLINE_MS,
  RELEASE_REFUSALS,
  anyScanning,
  availabilityOf,
  pollDelay,
} from '@{{projectSlug}}/api-client/src/file-state'
{{/if}}

/**
 * The list, the upload control and the two per-file actions.
 *
 * A client component for the one thing a server cannot do: put the bytes in
 * the bucket from the reader's machine. The upload is an `XMLHttpRequest`
 * rather than `fetch`, because only the former reports progress, and a
 * multi-hundred-megabyte upload with no progress bar is one the reader
 * cancels. Everything else -- tickets, confirmation, the list -- is a server
 * action, so no credential and no API address reaches this file.
 *
 * The list is never edited locally. After every action the panel re-reads it
 * from the server, which is slower by one round trip and right by
 * construction: the API is the only thing that knows whether the object
 * really arrived.
 */

export interface FilesLabels {
  upload: string
  uploading: string
  choose: string
  download: string
  remove: string
  confirmRemove: string
  empty: string
  emptyHint: string
  name: string
  size: string
  uploadedAt: string
  searchable: string
  searchableYes: string
  searchablePending: string
  searchableNo: string
{{#if capability.secure_files}}
  /** Shown while the file's content is not available: nothing is indexed from it yet. */
  searchableAfterAvailable: string
  /** Polite status while the browser reads the file to take its checksum. */
  preparing: string
  status: string
  statusAvailable: string
  statusScanning: string
  statusScanningHint: string
  statusUnavailable: string
  statusUnavailableHint: string
  scanningNotice: string
  scanningStopped: string
  refresh: string
{{else}}
  searchableUnknown: string
{{/if}}
  /** `{used}` and `{limit}` */
  usage: string
  /** `{used}` */
  usageUnlimited: string
  usageUnknown: string
  /** `{provider}` */
  provider: string
  retry: string
}

function fill(template: string, values: Record<string, string>): string {
  return template.replace(/\{(\w+)\}/g, (_, key: string) => values[key] ?? '')
}

function formatBytes(bytes: number, locale: Locale): string {
  const units = ['B', 'KB', 'MB', 'GB', 'TB']
  let value = bytes
  let unit = 0
  while (value >= 1024 && unit < units.length - 1) {
    value /= 1024
    unit += 1
  }
  const digits = unit === 0 ? 0 : value < 10 ? 1 : 0
  return `${new Intl.NumberFormat(locale, { maximumFractionDigits: digits }).format(value)} ${units[unit]}`
}

{{#unless capability.secure_files}}
/**
 * The SHA-256 of what is about to be sent, computed in the browser.
 *
 * `crypto.subtle` needs a secure context, which a deployed product always has
 * and a plain-http development origin does not; and it reads the whole file
 * into memory, which is fine for the five-gigabyte ceiling the API enforces
 * but not free. Either way a failure here is not an upload failure: the digest
 * is corroborating evidence, so the upload proceeds without one rather than
 * refusing a file because a hash could not be taken.
 */
async function digestOf(file: File): Promise<string | null> {
  try {
    if (!globalThis.crypto?.subtle) return null
    const hashed = await globalThis.crypto.subtle.digest('SHA-256', await file.arrayBuffer())
    return Array.from(new Uint8Array(hashed))
      .map((byte) => byte.toString(16).padStart(2, '0'))
      .join('')
  } catch {
    return null
  }
}

function putWithProgress(
  url: string,
  headers: Record<string, string>,
  file: File,
  onProgress: (fraction: number) => void,
): Promise<void> {
  return new Promise((resolve, reject) => {
    const xhr = new XMLHttpRequest()
    xhr.open('PUT', url)
    for (const [name, value] of Object.entries(headers)) xhr.setRequestHeader(name, value)
    xhr.upload.onprogress = (event) => {
      if (event.lengthComputable) onProgress(event.loaded / event.total)
    }
    xhr.onload = () =>
      xhr.status >= 200 && xhr.status < 300
        ? resolve()
        : reject(new Error(`the bucket answered ${xhr.status}`))
    xhr.onerror = () => reject(new Error('the upload could not reach the bucket'))
    xhr.send(file)
  })
}
{{/unless}}

export function FilesPanel({
  initial,
  canUpload,
  canManage,
  locale,
  labels,
}: {
  initial: ActionResult<FileList>
  canUpload: boolean
  canManage: boolean
  locale: Locale
  labels: FilesLabels
}) {
  const [list, setList] = useState<FileList | null>(initial.status === 'ok' ? initial.value : null)
  const [error, setError] = useState<string | null>(initial.status === 'error' ? initial.message : null)
  const [progress, setProgress] = useState<number | null>(null)
  // **Why the table formats times in UTC for exactly one render.**
  //
  // `Intl.DateTimeFormat` with a `timeStyle` uses the running machine's time
  // zone. On the server that is UTC; in the browser it is the customer's. The
  // two produce different text for the same instant, React finds markup it did
  // not send, and the page logs a hydration failure -- #418 on a deployed
  // product, found by opening the Files page on 2026-09-17.
  //
  // So the server pass and the first client pass both format in UTC, which
  // agree by construction, and the zone becomes the customer's once mounted.
  // The alternative, `suppressHydrationWarning`, silences the message and keeps
  // the server's text, which means showing every customer UTC forever.
{{#unless capability.secure_files}}
  // **How long "Indexing…" can honestly mean "in progress".**
  //
  // Reading an upload back and embedding it takes seconds -- a text file on the
  // dev estate took eight. The page infers the in-flight state from the absence
  // of a record, which is right while the work is happening and a lie once it
  // has stopped happening. Nine files on that estate had said "Indexing…" since
  // 9 September: they were uploaded before the assistant's hook existed, so no
  // attempt was ever scheduled and no outcome was ever written. Nothing would
  // ever have written one.
  //
  // An hour is far beyond any real indexing run and short enough that nobody
  // watches a false sentence for a working day. Past it, with no record either
  // way, the honest reading is that nothing indexed this file.
  const INDEXING_GRACE_MS = 60 * 60 * 1000
{{/unless}}
{{#if capability.secure_files}}
  // **Why the "Assistant" column does not say "Indexing…".** Nothing is read, and
  // nothing is indexed, until the file's check has said it is clean, and the index is
  // then taken lazily by a listing. So "waiting to be checked" and "waiting to be
  // indexed" are different states, and the column only speaks of the second for a file
  // the server says is available. A file that is not available says what it is waiting
  // for in the Status column and nothing here. There is no timer: this page cannot see
  // an indexing run, so it says what the record shows -- indexed, could not be, or not yet.
{{/if}}

  const [mounted, setMounted] = useState(false)
  useEffect(() => setMounted(true), [])
  const timeZone = mounted ? undefined : 'UTC'

  const [busy, setBusy] = useState(false)
  const input = useRef<HTMLInputElement>(null)
{{#if capability.secure_files}}
  // A refusal that is not a fault: the file was not available, and the list
  // has been re-read to show what it is now. A status, not an alert.
  const [notice, setNotice] = useState<string | null>(null)
  // The browser is hashing the chosen file, before any ticket is asked for.
  const [preparing, setPreparing] = useState(false)
  const [pollStopped, setPollStopped] = useState(false)
  const [pollRound, setPollRound] = useState(0)
  // A refused Download disables the very button that had focus, and a browser
  // drops focus to the page when that happens. The notice takes it instead.
  const noticeRef = useRef<HTMLParagraphElement>(null)
  useEffect(() => {
    if (notice !== null) noticeRef.current?.focus()
  }, [notice])
  // Only the newest read is applied. A background read that was slow must not
  // land after an upload's or a delete's and put the list back as it was.
  const latestRead = useRef(0)
{{/if}}

  const refresh = useCallback(async () => {
{{#if capability.secure_files}}
    const mine = (latestRead.current += 1)
{{/if}}
    const answer = await listFiles()
{{#if capability.secure_files}}
    if (mine !== latestRead.current) return
{{/if}}
    if (answer.status === 'ok') {
      setList(answer.value)
      setError(null)
    } else {
      setError(answer.message)
    }
  }, [])
{{#if capability.secure_files}}

  const scanning = list !== null && anyScanning(list.files)

  // **Bounded refresh while a file is being checked.** The page's own list
  // read, repeated -- not a row-by-row poll and not a second mechanism -- on a
  // delay that grows from ten seconds to a minute, paused while the tab is
  // hidden, and ended at a fixed deadline or the moment nothing is being
  // checked. Keyed on the *fact* that something is, not on the list, so a
  // refresh that changes the list does not restart the wait. After the
  // deadline the page says it has stopped and offers one explicit refresh,
  // which starts a new round. The delays and the deadline are `file-state.ts`.
  useEffect(() => {
    setPollStopped(false)
    if (!scanning) return
    const started = Date.now()
    let attempt = 0
    let cancelled = false
    let timer: ReturnType<typeof setTimeout> | undefined
    const wait = () => {
      timer = setTimeout(() => void tick(), pollDelay(attempt))
      attempt += 1
    }
    const tick = async () => {
      if (cancelled) return
      if (Date.now() - started >= POLL_DEADLINE_MS) {
        setPollStopped(true)
        return
      }
      if (typeof document === 'undefined' || !document.hidden) await refresh()
      if (!cancelled) wait()
    }
    wait()
    return () => {
      cancelled = true
      if (timer !== undefined) clearTimeout(timer)
    }
  }, [scanning, pollRound, refresh])
{{/if}}

  const upload = useCallback(
    async (file: File) => {
      setBusy(true)
      setError(null)
{{#if capability.secure_files}}
      setNotice(null)
{{/if}}
      setProgress(0)
      try {
{{#if capability.secure_files}}
        // Before the ticket: the digest is the content claim this upload is authorized
        // for, bound to the file when the ticket is issued. A file whose digest cannot
        // be taken throws here and is not uploaded.
{{/if}}
{{#unless capability.secure_files}}
        // Before the ticket, not merely before the PUT: the digest is signed
        // into the upload URL, so the provider stores it and can be asked for
        // it afterwards. Hashing after the ticket was issued -- which is what
        // this did until 2026-09-16 -- left the provider with nothing to
        // corroborate, and `checksum_verified` false for every file forever.
{{/unless}}
{{#if capability.secure_files}}
        // The hashing phase is visible: reading a large file into memory takes a moment in which
        // nothing else moves, and a person who sees nothing clicks again. A file above the
        // browser's ceiling throws here, with the sentence to show, before anything is read.
        setPreparing(true)
        let checksum: string
        try {
          checksum = await digestOf(file)
        } finally {
          setPreparing(false)
        }
{{else}}
        const checksum = await digestOf(file)
{{/if}}
        const ticket = await requestUpload({
          name: file.name,
          sizeBytes: file.size,
          contentType: file.type || 'application/octet-stream',
          checksumSha256: checksum,
        })
        if (ticket.status === 'error') {
          setError(ticket.message)
          return
        }
        await putWithProgress(ticket.value.upload_url, ticket.value.headers, file, setProgress)
        const done = await completeUpload(ticket.value.file_id, checksum)
        if (done.status === 'error') {
          setError(done.message)
          return
        }
        await refresh()
      } catch (failure) {
        setError(failure instanceof Error ? failure.message : String(failure))
      } finally {
        setBusy(false)
        setProgress(null)
        if (input.current) input.current.value = ''
      }
    },
    [refresh],
  )

{{#if capability.secure_files}}
  const download = useCallback(
    async (id: string) => {
      setNotice(null)
      const answer = await downloadUrl(id)
      if (answer.status === 'error') {
        // The server refused because the file is not available, which means
        // this page's row was stale. Re-read first -- the row then shows what
        // it is -- and only then say so, because a re-read clears the error.
        if (answer.code !== undefined && RELEASE_REFUSALS.has(answer.code)) {
          await refresh()
          setNotice(answer.message)
          return
        }
        if (answer.code === 'file_not_found') await refresh()
        setError(answer.message)
        return
      }
      // A signed URL with an attachment disposition: the browser saves it and
      // the tab stays here. Opened directly rather than through an anchor so
      // nothing in the DOM carries a URL that expires.
      window.location.assign(answer.value)
    },
    [refresh],
  )
{{else}}
  const download = useCallback(async (id: string) => {
    const answer = await downloadUrl(id)
    if (answer.status === 'error') {
      setError(answer.message)
      return
    }
    // A signed URL with an attachment disposition: the browser saves it and
    // the tab stays here. Opened directly rather than through an anchor so
    // nothing in the DOM carries a URL that expires.
    window.location.assign(answer.value)
  }, [])
{{/if}}

  const remove = useCallback(
    async (id: string, name: string) => {
      if (!window.confirm(fill(labels.confirmRemove, { name }))) return
{{#if capability.secure_files}}
      setNotice(null)
{{/if}}
      setBusy(true)
      const answer = await deleteFile(id)
      setBusy(false)
      if (answer.status === 'error') {
        setError(answer.message)
        return
      }
      await refresh()
    },
    [labels.confirmRemove, refresh],
  )

  const usage =
    list === null
      ? null
      : !list.resolved
        ? labels.usageUnknown
        : list.limit_bytes === null
          ? fill(labels.usageUnlimited, { used: formatBytes(list.used_bytes, locale) })
          : fill(labels.usage, {
              used: formatBytes(list.used_bytes, locale),
              limit: formatBytes(list.limit_bytes, locale),
            })

  return (
    <div className="mt-8 flex flex-col gap-6" data-testid="files">
      {canUpload && (
        <Card className="max-w-3xl">
          <div className="flex flex-wrap items-center gap-4">
            <label className="inline-flex cursor-pointer items-center">
              <span className="sr-only">{labels.choose}</span>
              <input
                ref={input}
                type="file"
                className="sr-only"
                disabled={busy}
                onChange={(event) => {
                  const file = event.target.files?.[0]
                  if (file) void upload(file)
                }}
              />
              <Button
                type="button"
                loading={busy}
                onClick={() => input.current?.click()}
                data-testid="files-upload"
              >
                {busy && progress !== null ? labels.uploading : labels.upload}
              </Button>
            </label>
{{#if capability.secure_files}}
            {/* Present from the start and announced politely: a live region that is added to
                the page together with its text is often not announced at all. */}
            <p
              role="status"
              className={preparing ? 'text-sm text-ink-muted' : 'sr-only'}
              data-testid="files-preparing"
            >
              {preparing ? labels.preparing : ''}
            </p>
            {progress !== null && !preparing && (
{{else}}
            {progress !== null && (
{{/if}}
              <progress
                className="h-2 w-48 overflow-hidden rounded-brand"
                value={Math.round(progress * 100)}
                max={100}
                aria-label={labels.uploading}
              />
            )}
            {usage !== null && <p className="text-sm text-ink-muted">{usage}</p>}
          </div>
        </Card>
      )}

      {error !== null && (
        <Card className="max-w-3xl border-danger">
          <p className="text-sm text-ink" role="alert">
            {error}
          </p>
{{#if capability.secure_files}}
          <Button
            type="button"
            variant="secondary"
            className="mt-3"
            onClick={() => {
              setNotice(null)
              void refresh()
            }}
          >
            {labels.retry}
          </Button>
        </Card>
      )}

      {notice !== null && (
        <Card className="max-w-3xl">
          <p
            ref={noticeRef}
            tabIndex={-1}
            className="text-sm text-ink outline-none"
            role="status"
            data-testid="files-notice"
          >
            {notice}
          </p>
        </Card>
      )}

      {scanning && (
        <div className="flex max-w-3xl flex-wrap items-center gap-3">
          <p className="text-sm text-ink-muted" role="status" data-testid="files-scanning">
            {pollStopped ? labels.scanningStopped : labels.scanningNotice}
          </p>
          {pollStopped && (
            <Button
              type="button"
              variant="secondary"
              onClick={() => {
                setNotice(null)
                setPollRound((round) => round + 1)
                void refresh()
              }}
            >
              {labels.refresh}
            </Button>
          )}
        </div>
      )}
{{else}}
          <Button type="button" variant="secondary" className="mt-3" onClick={() => void refresh()}>
            {labels.retry}
          </Button>
        </Card>
      )}
{{/if}}

      {list !== null && list.files.length === 0 ? (
        <Card className="max-w-3xl">
          <h2 className="font-display text-lg font-bold text-ink">{labels.empty}</h2>
          <p className="mt-2 text-sm leading-6 text-ink-muted">{labels.emptyHint}</p>
        </Card>
      ) : list !== null ? (
{{#if capability.secure_files}}
        /* `relative`: the table's `sr-only` header cell is absolutely
            positioned, and without a positioned ancestor inside the scroll
            container it escapes it and widens the whole page on a phone. */
        <div className="relative overflow-x-auto rounded-brand border border-line bg-surface">
{{else}}
        <div className="overflow-x-auto rounded-brand border border-line bg-surface">
{{/if}}
          <table className="w-full text-sm">
            <thead className="bg-surface-muted text-left text-ink-muted">
              <tr>
                <th scope="col" className="px-4 py-3 font-medium">{labels.name}</th>
                <th scope="col" className="px-4 py-3 font-medium">{labels.size}</th>
                <th scope="col" className="px-4 py-3 font-medium">{labels.uploadedAt}</th>
{{#if capability.secure_files}}
                <th scope="col" className="px-4 py-3 font-medium">{labels.status}</th>
{{/if}}
                <th scope="col" className="px-4 py-3 font-medium">{labels.searchable}</th>
                <th scope="col" className="px-4 py-3">
                  <span className="sr-only">{labels.download}</span>
                </th>
              </tr>
            </thead>
            <tbody>
{{#if capability.secure_files}}
              {list.files.map((file) => {
                const state = availabilityOf(file)
                const statusId = `file-status-${file.id}`
                return (
                <tr
                  key={file.id}
                  className="border-t border-line"
                  data-testid="file-row"
                  data-state={state}
                >
{{else}}
              {list.files.map((file) => (
                <tr key={file.id} className="border-t border-line">
{{/if}}
                  <td className="px-4 py-3 text-ink">{file.name}</td>
                  <td className="px-4 py-3 text-ink-muted">{formatBytes(file.size_bytes, locale)}</td>
                  <td className="px-4 py-3 text-ink-muted">
                    <time dateTime={file.uploaded_at}>
                      {new Intl.DateTimeFormat(locale, {
                        dateStyle: 'medium',
                        timeStyle: 'short',
                        timeZone,
                      }).format(new Date(file.uploaded_at))}
                    </time>
                  </td>
{{#if capability.secure_files}}
                  <td className="px-4 py-3 text-ink-muted" data-testid="file-status">
                    <span id={statusId}>
                      <span className={state === 'available' ? 'text-ink' : undefined}>
                        {state === 'available'
                          ? labels.statusAvailable
                          : state === 'scanning'
                            ? labels.statusScanning
                            : labels.statusUnavailable}
                      </span>
                      {state !== 'available' && (
                        <span className="block text-xs">
                          {state === 'scanning'
                            ? labels.statusScanningHint
                            : labels.statusUnavailableHint}
                        </span>
                      )}
                    </span>
                  </td>
{{/if}}
                  <td className="px-4 py-3 text-ink-muted" data-testid="file-searchable">
{{#if capability.secure_files}}
                    {state !== 'available' ? (
                      <span>{labels.searchableAfterAvailable}</span>
                    ) : file.indexed_at ? (
{{else}}
                    {file.indexed_at ? (
{{/if}}
                      <span className="text-ink">{labels.searchableYes}</span>
                    ) : file.index_note ? (
                      <span title={file.index_note}>{labels.searchableNo}</span>
{{#if capability.secure_files}}
                    ) : (
                      <span>{labels.searchablePending}</span>
                    )}
{{else}}
                    ) : Date.now() - new Date(file.uploaded_at).getTime() > INDEXING_GRACE_MS ? (
                      <span>{labels.searchableUnknown}</span>
                    ) : (
                      <span>{labels.searchablePending}</span>
                    )}
{{/if}}
                  </td>
                  <td className="px-4 py-3">
                    <div className="flex justify-end gap-2">
{{#if capability.secure_files}}
                      {/* Native `disabled`: not focusable, not clickable, and the
                          server refuses the request regardless. The reason is the
                          Status cell, which the button points at. */}
                      <Button
                        type="button"
                        variant="secondary"
                        disabled={state !== 'available'}
                        aria-describedby={statusId}
                        onClick={() => void download(file.id)}
                      >
                        {labels.download}
                      </Button>
{{else}}
                      <Button type="button" variant="secondary" onClick={() => void download(file.id)}>
                        {labels.download}
                      </Button>
{{/if}}
                      {canManage && (
                        <Button
                          type="button"
                          variant="secondary"
                          disabled={busy}
                          onClick={() => void remove(file.id, file.name)}
                        >
                          {labels.remove}
                        </Button>
                      )}
                    </div>
                  </td>
{{#if capability.secure_files}}
                </tr>
                )
              })}
{{else}}
                </tr>
              ))}
{{/if}}
            </tbody>
          </table>
          {list.provider && (
            <p className="border-t border-line px-4 py-2 text-xs text-ink-muted">
              {fill(labels.provider, { provider: list.provider })}
            </p>
          )}
        </div>
      ) : null}
    </div>
  )
}

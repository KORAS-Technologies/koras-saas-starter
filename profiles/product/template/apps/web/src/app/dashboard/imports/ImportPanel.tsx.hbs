import { Banner, Button, ButtonLink, Card, DownloadMenu, SaveOutcome, SelectField } from '@{{projectSlug}}/ui'
import type {
  ImportAnalysisView,
  ImportRowErrorView,
  ImportRunView,
  ImportTargetView,
} from '@{{projectSlug}}/api-client'
import { useCallback, useEffect, useRef, useState } from 'react'
import {
  allErrors,
  analyseRun,
  cancelRun,
  checkSource,
  commitRun,
  completeSourceUpload,
  getRun,
  listErrors,
  listRuns,
  requestSourceUpload,
  saveMapping,
  startRun,
  validateRun,
} from './actions'
import { ImportStepper } from './ImportStepper'
import type { ImportLabels } from './labels'
import { LocalTime } from './LocalTime'
import { runIdFromSearch, stageOf } from './run-stage'
import {
  CHECK_DEADLINE_MS,
  checkDelay,
  parsePending,
  pendingKey,
  phaseOf,
  purgePending,
} from './source-state'
import type { PendingSource, SourcePhase } from './source-state'
{{#if capability.secure_files}}
import { digestOf } from '../../../lib/browser-upload'
{{/if}}

/**
 * Download a template, upload, map, check -- and, since Phase 2, confirm.
 *
 * **One workflow for both formats.** A CSV and an XLSX go through the same
 * ticket, the same run, the same mapping and the same dry run; the format is
 * decided once, on the server, from the file the run was started against,
 * and nothing on this page branches on it except the sentence naming the
 * sheet a workbook was read from.
 *
 * **The template control is one control.** A disclosure over one plain
 * anchor per format the target accepts, pointing at the web route handler
 * that streams what the API renders. Anchors so the router never prefetches
 * a download, which would be a template download recorded in the audit table
 * as if somebody had asked for it. ADR 0012 D7.
 *
 * **The confirm control is absent rather than disabled for a target that
 * declares no writer.** `committable` is false for such a target and no button
 * renders at all, which is the shape the whole panel had before a commit
 * existed: a disabled control promises a thing this product cannot do, and a
 * person cannot tell "not yet" from "not for you".
 *
 * **Confirming is a second act by a person, and it says what it will do.** The
 * run moves to `commit_requested` and a worker does the writing, so the panel
 * polls the way it already polls a dry run. `committed_by` is what the run
 * records, separately from `requested_by`, and they are frequently the same
 * person -- the fact worth keeping is that somebody read a dry run and said
 * yes.
 *
 * **The figures are predictions until the commit, and say so.** A target
 * that declares a matcher lets the dry run say how many rows would be added,
 * updated or left alone; one that does not gets a sentence saying the figures
 * are unknown rather than three zeros. After the commit the card draws the
 * five-row table -- total, created, updated, skipped, failed -- and failed is
 * zero for every committed run, because a commit is atomic.
 *
 * **The report downloads.** A person fixing a file works in a spreadsheet, not
 * in a table on a web page, and the criterion for a failed run is that they can
 * get every bad row out. The screen still shows the first page, because most
 * files are wrong in one obvious way and scrolling beats downloading.
 *
 * Three refusals a person can hit are worth naming, because each is a sentence
 * rather than a silence: a file whose headings the target cannot use, a file
 * over the row ceiling, and a queue that is not configured. The last is a 503
 * from the API rather than an accepted request, because a dry run that is
 * promised and never happens leaves somebody watching a spinner forever.
 */

{{#unless capability.secure_files}}
/** A digest of what is about to be sent, where the browser can take one. */
async function digestOf(file: File): Promise<string | null> {
  try {
    if (!globalThis.crypto?.subtle) return null
    const hashed = await globalThis.crypto.subtle.digest('SHA-256', await file.arrayBuffer())
    return Array.from(new Uint8Array(hashed))
      .map((byte) => byte.toString(16).padStart(2, '0'))
      .join('')
  } catch {
    return null
  }
}
{{/unless}}

async function put(url: string, headers: Record<string, string>, file: File): Promise<void> {
  const response = await fetch(url, { method: 'PUT', headers, body: file })
  if (!response.ok) throw new Error(`the bucket answered ${response.status}`)
}

/**
 * Neutralise a cell a spreadsheet would otherwise execute.
 *
 * Excel and LibreOffice evaluate a cell whose first character is `=`, `+`, `-`
 * or `@` -- inside quotation marks as much as outside them, because the quotes
 * are the CSV's, and the spreadsheet has already removed them by the time it
 * decides. A leading apostrophe is the documented way to say "this is text",
 * and it is what a person pasting a formula into a cell would type themselves.
 *
 * Tab and carriage return are here too: both can carry the trigger character
 * into the next cell on some importers.
 */
function guardCell(cell: string): string {
  return /^[=+\-@\t\r]/.test(cell) ? `'${cell}` : cell
}

/**
 * Which runs are still moving, and so worth asking about again.
 *
 * **`commit_requested` is in this set, and leaving it out stopped the page
 * dead.** The commit route answers with the run in `commit_requested`; only the
 * worker moves it on to `committing`. So confirming an import used to end the
 * polling it was supposed to start: the card froze on the request sentence
 * while the rows were written, and a person who assumed it had failed pressed
 * Confirm again and got a 409 drawn as an error over a successful import.
 * IMP2-06 in `docs/features/data-import/phase-2-review.md`.
 */
const IN_FLIGHT = new Set(['validating', 'commit_requested', 'committing'])

/** The states in which the API accepts a mapping and a dry run, and refuses both in every other. */
const MAPPABLE = new Set(['created', 'mapped', 'validated', 'validation_failed'])

/** The phases the page draws a sentence for; the rest are drawn by other parts of it. */
type SourceMessage = 'checking' | 'ready' | 'stalled' | 'held' | 'rejected' | 'missing'
const SOURCE_PHASES: ReadonlySet<SourcePhase> = new Set<SourcePhase>([
  'checking',
  'ready',
  'stalled',
  'held',
  'rejected',
  'missing',
])

/**
 * The order the template menu lists formats in, whatever order the target
 * declared them: Excel first, because it is the one with the Instructions
 * sheet, then CSV. A format outside this list -- none today -- lists after.
 */
const TEMPLATE_ORDER = ['xlsx', 'csv']

/** The content types a file input accepts for each format a target takes. */
const ACCEPT: Record<string, string> = {
  csv: '.csv,.tsv,text/csv',
  xlsx: '.xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
}

function fill(template: string, values: Record<string, string>): string {
  return template.replace(/\{(\w+)\}/g, (_, key: string) => values[key] ?? '')
}

/** `1.5 MB`, `640 KB`, `12 B`: enough precision to compare with a ceiling. */
function sizeOf(bytes: number): string {
  if (bytes >= 1024 * 1024) return `${(bytes / (1024 * 1024)).toFixed(bytes >= 10 * 1024 * 1024 ? 0 : 1)} MB`
  if (bytes >= 1024) return `${Math.round(bytes / 1024)} KB`
  return `${bytes} B`
}

function Figure({ label, value, testId }: { label: string; value: string; testId: string }) {
  return (
    <div className="rounded-brand border border-line px-3 py-2" data-testid={testId}>
      <dt className="text-xs uppercase text-ink-muted">{label}</dt>
      <dd className="text-lg font-semibold tabular-nums text-ink">{value}</dd>
    </div>
  )
}

export function ImportPanel({
  targets,
  initialRuns,
  storageScope = '',
  initialRunId,
  locale = 'en',
  recordLinks,
  labels,
}: {
  targets: ImportTargetView[]
  initialRuns: ImportRunView[]
  /** Who the remembered wait belongs to: organisation and person. */
  storageScope?: string
  /** The run `?run=` named when the page was loaded; opened once, read from the server. */
  initialRunId?: string
  /** For dates in Recent imports. Storage and the API stay UTC. */
  locale?: string
  /** Where to see what a completed run wrote, by target key. */
  recordLinks?: Record<string, { href: string; label: string }>
  labels: ImportLabels
}) {
  const [runs, setRuns] = useState<ImportRunView[]>(initialRuns)
  const [error, setError] = useState<string | null>(null)
  const [busy, setBusy] = useState(false)
{{#if capability.secure_files}}
  // The browser is hashing the chosen file, before any ticket is asked for.
  const [preparing, setPreparing] = useState(false)
{{/if}}

  const [targetKey, setTargetKey] = useState<string>(targets[0]?.key ?? '')
  const [operation, setOperation] = useState<string>(targets[0]?.operations[0] ?? '')
  const [chosen, setChosen] = useState<{ name: string; size: number } | null>(null)
  const [run, setRun] = useState<ImportRunView | null>(null)
  const [analysis, setAnalysis] = useState<ImportAnalysisView | null>(null)
  const [mapping, setMapping] = useState<Record<string, string>>({})
  const [problems, setProblems] = useState<ImportRowErrorView[] | null>(null)
  const input = useRef<HTMLInputElement>(null)
  // Where an uploaded file is between "the bytes arrived" and "a run can start".
  // A new upload is withheld until it has been finalized and scanned, about
  // twenty minutes, so this is a wait the page owns and not a refusal.
  const [phase, setPhase] = useState<SourcePhase>('idle')
  const [waiting, setWaiting] = useState<PendingSource | null>(null)
  const [tick, setTick] = useState(0)
  const attempts = useRef(0)
  const restored = useRef(false)
  // A restored wait was begun by a click in an earlier visit, possibly by
  // someone else on this browser: it never starts a run by itself.
  const resumed = useRef<string | null>(null)
  // One ask at a time, and a generation that Stop or a new file moves on, so an
  // answer that arrives after either is dropped.
  const asking = useRef(false)
  const generation = useRef(0)
  // "Check again" is one explicit look, not a return to polling: the page stays
  // `stalled` (so the button a keyboard user pressed stays mounted and focused)
  // and says what the look found.
  const manual = useRef(false)
  const [rechecking, setRechecking] = useState(false)
  const [checkedStill, setCheckedStill] = useState(false)
  // A failed look is a note beside the wait, not an assertive page-level error.
  const [retryNote, setRetryNote] = useState<string | null>(null)
  const sourceBox = useRef<HTMLDivElement>(null)
  const mapHeading = useRef<HTMLHeadingElement>(null)
  const wizardHeading = useRef<HTMLHeadingElement>(null)
  // Things a person did on this page about the open run. Neither is stored: a
  // refresh puts a checked run back at Review, and nothing is ever committed by
  // arriving anywhere.
  const [reviewed, setReviewed] = useState(false)
  const [remap, setRemap] = useState(false)
  // The analysis of the open run is being read from its file.
  const [analysing, setAnalysing] = useState(false)
  // The file of the open run could not be read, so it cannot be mapped.
  const [analysisFailed, setAnalysisFailed] = useState<string | null>(null)
  const [announce, setAnnounce] = useState('')
  const openToken = useRef(0)
  const analysedKey = useRef<string | null>(null)
  const problemsKey = useRef<string | null>(null)
  const initialised = useRef(false)
  const runsRef = useRef<ImportRunView[]>(initialRuns)
  // What the address should say once the page is idle; null when it already says it.
  const wantUrl = useRef<{ id: string | null; mode: 'push' | 'replace' } | null>(null)
  // Where focus goes once the control that held it has left. Decided by the
  // handler, carried out after the render that removes the control, and held
  // back while the chooser is disabled (`busy`): focusing a disabled input does
  // nothing, and focus then falls to the page.
  const [focusTarget, setFocusTarget] = useState<
    'chooser' | 'chooserNow' | 'mapping' | 'mappingNow' | 'source' | 'wizard' | 'wizardIfFree' | null
  >(null)
  // A run is being started from a source the server has cleared: said in words, because the
  // control that was pressed is gone and nothing else on the page changes.
  const [starting, setStarting] = useState(false)

  const target = targets.find((candidate) => candidate.key === targetKey) ?? null
  // **The run's own target, not the picker's.** They are the same until
  // somebody changes the picker with a run in progress, and then the confirm
  // control would be answering a question about a different import.
  const runTarget =
    run === null ? null : (targets.find((candidate) => candidate.key === run.target) ?? null)

  /**
   * Open a run from the history.
   *
   * **Without this the report is unreachable.** `run` starts `null` on every
   * load and `refresh` keeps a null null, so a person who reloaded the page --
   * or came back to it later -- had no current run, and *Download every
   * problem* lives inside the result card, which renders only when there is
   * one. The run stayed listed below, the route went on answering, and nothing
   * on the page could reach it. IMP2-29 in
   * `docs/features/data-import/phase-2-review.md`.
   *
   * The analysis and the problems are cleared rather than kept: both belong to
   * whichever run was open before, and a report from one run shown under
   * another is worse than no report at all.
   */
  // The URL names the open run (`?run=<id>`), so a refresh, a copied link and
  // Back and Forward land on it. History only: nothing here reads the server.
  const syncUrl = useCallback((id: string | null, mode: 'push' | 'replace') => {
    try {
      const url = new URL(window.location.href)
      if (id === null) url.searchParams.delete('run')
      else url.searchParams.set('run', id)
      if (url.href === window.location.href) return
      // The router's own History (it patches pushState and replaceState so that the address it
      // holds follows the page). Called only when the page is idle -- see the effect below: the
      // router answers it with a queued action, and one queued in front of a server action this
      // page is waiting on (the file's analysis) stalls that action.
      if (mode === 'push') window.history.pushState(null, '', url)
      else window.history.replaceState(null, '', url)
    } catch {
      // No history to write (a test): the page works, it just cannot be linked to.
    }
  }, [])

  const clearRun = useCallback(() => {
    openToken.current += 1
    analysedKey.current = null
    problemsKey.current = null
    setError(null)
    setAnalysis(null)
    setProblems(null)
    setReviewed(false)
    setRemap(false)
    setAnalysing(false)
    setAnalysisFailed(null)
    setRun(null)
  }, [])

  const open = useCallback(
    (
      picked: ImportRunView,
      mode: 'push' | 'replace' | 'none' = 'push',
      focus: 'now' | 'ifFree' | 'none' = 'now',
    ) => {
      openToken.current += 1
      analysedKey.current = null
      problemsKey.current = null
      setError(null)
      setAnalysis(null)
      setProblems(null)
      setReviewed(false)
      setRemap(false)
      setAnalysing(false)
      setAnalysisFailed(null)
      setChosen(null)
      setRun(picked)
      setAnnounce(fill(labels.wizard.opened, { file: picked.source_name ?? picked.target }))
      if (mode !== 'none') wantUrl.current = { id: picked.id, mode }
      // Opening by pressing Open is a person's act and must be seen: the heading takes focus. A
      // link or Back and Forward resolves later, so it only moves focus if nothing else has it.
      setFocusTarget(focus === 'now' ? 'wizard' : focus === 'ifFree' ? 'wizardIfFree' : null)
    },
    [labels],
  )

  /** Open the run an address names: from the server first, from the list as a fallback. */
  const openById = useCallback(
    async (id: string, mode: 'push' | 'replace' | 'none', focus: 'ifFree' | 'none') => {
      const answer = await getRun(id)
      if (answer.status === 'ok') {
        open(answer.value, mode, focus)
        return
      }
      const known = runsRef.current.find((row) => row.id === id)
      if (known) {
        open(known, mode, focus)
        return
      }
      clearRun()
      setError(labels.wizard.runUnavailable)
    },
    [clearRun, labels, open],
  )

  const another = useCallback(() => {
    clearRun()
    wantUrl.current = { id: null, mode: 'push' }
    setChosen(null)
    setAnnounce('')
    // The button that was pressed has gone; the chooser is where the next file starts.
    setFocusTarget('chooserNow')
  }, [clearRun])

  // A page loaded on `?run=` opens that run; a run is never inferred from anything else.
  useEffect(() => {
    if (initialised.current) return
    initialised.current = true
    if (initialRunId) void openById(initialRunId, 'none', 'none')
  }, [initialRunId, openById])

  // Back and Forward between runs.
  useEffect(() => {
    if (typeof window === 'undefined' || typeof window.addEventListener !== 'function') return
    const onPop = () => {
      const id = runIdFromSearch(window.location.search)
      if (id === null) clearRun()
      else void openById(id, 'none', 'ifFree')
    }
    const target = window
    target.addEventListener('popstate', onPop)
    return () => target.removeEventListener?.('popstate', onPop)
  }, [clearRun, openById])

  const refresh = useCallback(async () => {
    const answer = await listRuns()
    if (answer.status === 'ok') {
      runsRef.current = answer.value
      setRuns(answer.value)
      setRun((current) =>
        current === null ? null : (answer.value.find((row) => row.id === current.id) ?? current),
      )
    }
  }, [])

  // The mapping, the sample rows and the review all need the file's analysis,
  // and a run that was opened (rather than just started) does not have it yet.
  // One effect reads it, once for each run and state, so a refresh, Back, Open
  // and a dry run that finishes while the page is open all end the same way.
  useEffect(() => {
    if (run === null || analysis !== null || !MAPPABLE.has(run.status)) return
    const key = `${run.id}:${run.status}`
    if (analysedKey.current === key) return
    analysedKey.current = key
    const token = openToken.current
    const opened = run
    setAnalysing(true)
    void analyseRun(opened.id).then((found) => {
      if (token !== openToken.current) return
      setAnalysing(false)
      if (found.status === 'error') {
        setAnalysisFailed(opened.id)
        return
      }
      setAnalysisFailed(null)
      setAnalysis(found.value)
      setMapping(Object.keys(opened.mapping ?? {}).length > 0 ? opened.mapping : found.value.suggested)
      setAnnounce((current) => `${current} ${labels.wizard.detailsReady}`.trim())
    })
  }, [run, analysis, labels])

  // The address follows the run, once nothing is in flight. Opening a run that needs its
  // analysis waits for the analysis, so the router's action never queues in front of it.
  useEffect(() => {
    const want = wantUrl.current
    if (want === null || busy || analysing) return
    if (want.id !== null) {
      if (run === null || run.id !== want.id) return
      if (MAPPABLE.has(run.status) && analysis === null && analysisFailed !== run.id) return
    }
    wantUrl.current = null
    syncUrl(want.id, want.mode)
  }, [busy, analysing, run, analysis, analysisFailed, syncUrl])

  // A run with problems shows them where they were found, without a second click.
  useEffect(() => {
    if (run === null || problems !== null || run.status !== 'validation_failed' || run.errors_total === 0) return
    const key = `${run.id}:${run.status}`
    if (problemsKey.current === key) return
    problemsKey.current = key
    const token = openToken.current
    void listErrors(run.id).then((answer) => {
      if (token === openToken.current && answer.status === 'ok') setProblems(answer.value)
    })
  }, [run, problems])

  // A dry run happens in the worker, so the page has to ask. The polling stops
  // the moment nothing is moving: a page left open on a finished run should
  // cost the API nothing.
  useEffect(() => {
    if (run === null || !IN_FLIGHT.has(run.status)) return
    const timer = setInterval(() => void refresh(), 3000)
    return () => clearInterval(timer)
  }, [run, refresh])

  const remember = useCallback(
    (source: PendingSource) => {
      try {
        window.localStorage.setItem(pendingKey(storageScope), JSON.stringify(source))
      } catch {
        // A convenience only; the page works without it.
      }
    },
    [storageScope],
  )

  const forget = useCallback(() => {
    try {
      window.localStorage.removeItem(pendingKey(storageScope))
    } catch {
      // As above.
    }
  }, [storageScope])

  /** The run for a source the server has said may be read. */
  const startFrom = useCallback(
    async (source: PendingSource) => {
      setBusy(true)
      setStarting(true)
      setError(null)
      try {
        const started = await startRun({
          target: source.target,
          fileId: source.fileId,
          operation: source.operation,
        })
        if (started.status === 'error') {
          setError(started.message)
          return
        }
        openToken.current += 1
        const startedToken = openToken.current
        analysedKey.current = `${started.value.id}:${started.value.status}`
        setReviewed(false)
        setRemap(false)
        setAnalysisFailed(null)
        setRun(started.value)
        wantUrl.current = { id: started.value.id, mode: 'push' }
        setAnnounce(fill(labels.wizard.opened, { file: started.value.source_name ?? started.value.target }))
        const found = await analyseRun(started.value.id)
        // Opened another run, or went back, while this one was being read: its analysis
        // is not the page's any more, and saving it onto the other run is the harm.
        if (startedToken !== openToken.current) return
        if (found.status === 'error') {
          setError(found.message)
          return
        }
        setAnalysis(found.value)
        setMapping(found.value.suggested)
        await refresh()
      } finally {
        setBusy(false)
        setStarting(false)
      }
    },
    [labels, refresh],
  )

  /**
   * Ask where the source is and act on the answer: start the run on `ready`,
   * keep waiting on `checking`, say so plainly on anything else. The server
   * decides what `ready` is; this only follows it.
   */
  const resolve = useCallback(
    async (source: PendingSource) => {
      if (asking.current) return
      asking.current = true
      const mine = generation.current
      const wasManual = manual.current
      manual.current = false
      try {
        const answer = await checkSource(source.fileId)
        if (mine !== generation.current) return
        if (answer.status === 'error') {
          if (answer.final) {
            // Waiting will not change this (permission, ceiling, closed gate).
            setWaiting(null)
            forget()
            setPhase('idle')
            setRetryNote(null)
            setError(answer.message)
            // "Check again" held focus and is leaving.
            if (wasManual) setFocusTarget('chooser')
            return
          }
          // Could not ask. Not a verdict: keep the wait and try again later.
          setRetryNote(fill(labels.source.unreachable, { name: source.name }))
          if (!wasManual) {
            setPhase('checking')
            setTick((current) => current + 1)
          }
          return
        }
        const next = phaseOf(answer.value)
        if (next === 'checking') {
          setError(null)
          setRetryNote(null)
          if (wasManual) {
            // Still checking, and the page said it looked.
            setCheckedStill(true)
            return
          }
          setPhase('checking')
          setTick((current) => current + 1)
          return
        }
        setRetryNote(null)
        if (next === 'ready' && resumed.current === source.fileId) {
          // Found ready on a later visit: say so and let a person start it.
          setError(null)
          setPhase('ready')
          // "Check again" is replaced by Continue; the sentence that says so takes focus.
          if (wasManual) setFocusTarget('source')
          return
        }
        setWaiting(null)
        forget()
        if (next === 'ready') {
          setPhase('idle')
          asking.current = false
          if (wasManual) setFocusTarget('mapping')
          await startFrom(source)
          return
        }
        setPhase(next)
      } finally {
        if (wasManual) setRechecking(false)
        // Only while this call still owns the slot: Stop or a new file moved the generation
        // on and released it already, and a newer ask may hold it now.
        if (mine === generation.current) asking.current = false
      }
    },
    [forget, labels, startFrom],
  )

  // The wait. Ten seconds doubling to a minute, to a deadline; past it the page
  // stops asking and offers one explicit "Check again" (`stalled`).
  useEffect(() => {
    if (waiting === null || phase !== 'checking') return
    if (Date.now() - waiting.at > CHECK_DEADLINE_MS) {
      setPhase('stalled')
      return
    }
    const timer = setTimeout(() => {
      attempts.current += 1
      void resolve(waiting)
    }, checkDelay(attempts.current))
    return () => clearTimeout(timer)
  }, [waiting, phase, tick, resolve])

  // A person who left while a file was being checked comes back to it.
  useEffect(() => {
    if (restored.current) return
    restored.current = true
    let found: PendingSource | null = null
    try {
      // Only this principal's wait on this organisation survives a visit.
      purgePending(storageScope, window.localStorage)
      found = parsePending(window.localStorage.getItem(pendingKey(storageScope)), Date.now())
    } catch {
      found = null
    }
    if (found === null || !targets.some((candidate) => candidate.key === found?.target)) return
    resumed.current = found.fileId
    setChosen({ name: found.name, size: found.size })
    setWaiting(found)
    setPhase('checking')
    void resolve(found)
  }, [resolve, storageScope, targets])

  const continueResumed = useCallback(() => {
    if (waiting === null) return
    const source = waiting
    resumed.current = null
    setWaiting(null)
    forget()
    setPhase('idle')
    // Continue is about to leave the page; the mapping is where the person goes next.
    setFocusTarget('mapping')
    void startFrom(source)
  }, [forget, startFrom, waiting])

  const checkAgain = useCallback(() => {
    if (waiting === null) return
    if (asking.current) return
    attempts.current = 0
    manual.current = true
    setCheckedStill(false)
    setRechecking(true)
    void resolve(waiting)
  }, [resolve, waiting])

  const stopWaiting = useCallback(() => {
    generation.current += 1
    asking.current = false
    manual.current = false
    resumed.current = null
    setWaiting(null)
    setPhase('idle')
    setChosen(null)
    setRechecking(false)
    setCheckedStill(false)
    setRetryNote(null)
    forget()
    // The control that held focus is leaving; the file chooser is where a person goes next.
    setFocusTarget('chooser')
  }, [forget])

  const stage = stageOf({
    status: run?.status ?? null,
    committedBy: run?.committed_by ?? null,
    reviewed,
    remap,
  })

  useEffect(() => {
    if (focusTarget === 'wizard' || focusTarget === 'wizardIfFree' || focusTarget === 'mappingNow') {
      // A person pressed a control that is leaving or has acted: unlike the hand-offs below this
      // is not held back for `busy`, and 'wizard' does not ask whether focus is free -- the
      // control that was pressed has it, and moving is the point.
      // At the Map step, wait for the file's analysis while it is on its way, so focus lands on the
      // form it belongs to rather than on a heading the form then appears above. Every other stage
      // has nothing arriving to wait for.
      if (
        run !== null &&
        stage === 'map' &&
        MAPPABLE.has(run.status) &&
        analysis === null &&
        analysisFailed !== run.id &&
        focusTarget !== 'mappingNow'
      ) {
        return
      }
      const page = input.current?.ownerDocument
      const held = page?.activeElement ?? null
      const free = held === null || held === page?.body
      if (focusTarget === 'wizardIfFree' && !free) {
        setFocusTarget(null)
        return
      }
      const mapping = mapHeading.current
      const onMap = stage === 'map' || focusTarget === 'mappingNow'
      const heading = onMap && mapping !== null ? mapping : wizardHeading.current
      if (heading === null) {
        setFocusTarget(null)
        return
      }
      heading.focus({ preventScroll: true })
      heading.scrollIntoView?.({ block: 'start' })
      setFocusTarget(null)
      return
    }
    if (focusTarget === null || busy) return
    if (focusTarget === 'chooserNow') {
      input.current?.focus()
      setFocusTarget(null)
      return
    }
    // Focus moves only if it has nowhere better to be: the control that held it left, so it is
    // on the page. A person who has tabbed on to something else in the meantime keeps it.
    const page = input.current?.ownerDocument
    const held = page?.activeElement ?? null
    const free = held === null || held === page?.body || sourceBox.current?.contains(held)
    if (free) {
      const heading = mapHeading.current
      if (focusTarget === 'mapping' && heading !== null) heading.focus()
      else if (focusTarget === 'source' && sourceBox.current !== null) sourceBox.current.focus()
      else input.current?.focus()
    }
    setFocusTarget(null)
  }, [focusTarget, busy, analysis, analysisFailed, error, run, stage])

  // The wait ending badly is news the person must not have to hunt for: move focus to it.
  useEffect(() => {
    if (phase === 'held' || phase === 'rejected' || phase === 'missing') sourceBox.current?.focus()
  }, [phase])

  const choose = useCallback(
    async (file: File) => {
      if (target === null) return
      setBusy(true)
      setError(null)
      setProblems(null)
      setAnalysis(null)
      generation.current += 1
      asking.current = false
      resumed.current = null
      setWaiting(null)
      setPhase('idle')
      forget()
      setChosen({ name: file.name, size: file.size })
      try {
{{#if capability.secure_files}}
        // The hashing phase is visible: reading a large file into memory takes a moment in which
        // nothing else moves, and a person who sees nothing clicks again. A file above the
        // browser's ceiling throws here, with the sentence to show, before anything is read.
        setPreparing(true)
        let checksum: string
        try {
          checksum = await digestOf(file)
        } finally {
          setPreparing(false)
        }
{{else}}
        const checksum = await digestOf(file)
{{/if}}
        const ticket = await requestSourceUpload({
          name: file.name,
          sizeBytes: file.size,
          contentType: file.type || 'text/csv',
          checksumSha256: checksum,
        })
        if (ticket.status === 'error') {
          setError(ticket.message)
          return
        }
        await put(ticket.value.upload_url, ticket.value.headers, file)
        const done = await completeSourceUpload(ticket.value.file_id, checksum)
        if (done.status === 'error') {
          setError(done.message)
          return
        }
        // Not started here: the file has only just arrived, and the server
        // withholds it until it has been checked. `resolve` asks, starts the
        // run the moment the answer is `ready`, and otherwise waits.
        const source: PendingSource = {
          fileId: ticket.value.file_id,
          name: file.name,
          size: file.size,
          target: target.key,
          operation,
          at: Date.now(),
        }
        attempts.current = 0
        setWaiting(source)
        setPhase('checking')
        remember(source)
        await resolve(source)
      } catch (failure) {
        setError(failure instanceof Error ? failure.message : String(failure))
      } finally {
        setBusy(false)
        if (input.current) input.current.value = ''
      }
    },
    [forget, operation, remember, resolve, target],
  )

  const check = useCallback(async () => {
    if (run === null) return
    setBusy(true)
    setError(null)
    setProblems(null)
    try {
      const saved = await saveMapping(run.id, mapping)
      if (saved.status === 'error') {
        setError(saved.message)
        return
      }
      const queued = await validateRun(run.id)
      if (queued.status === 'error') {
        setError(queued.message)
        return
      }
      setRemap(false)
      setReviewed(false)
      setRun(queued.value)
      await refresh()
    } finally {
      setBusy(false)
    }
  }, [mapping, refresh, run])

  const confirm = useCallback(async () => {
    if (run === null) return
    setBusy(true)
    setError(null)
    setProblems(null)
    try {
      const queued = await commitRun(run.id)
      if (queued.status === 'error') {
        setError(queued.message)
        return
      }
      setRun(queued.value)
      // The Confirm button leaves with the state; the heading now says Importing.
      setFocusTarget('wizard')
      await refresh()
    } finally {
      setBusy(false)
    }
  }, [refresh, run])

  const download = useCallback(async () => {
    if (run === null) return
    setBusy(true)
    try {
      const answer = await allErrors(run.id, run.errors_total)
      if (answer.status === 'error') {
        setError(answer.message)
        return
      }
      const header = [
        labels.row,
        labels.column,
        labels.field,
        labels.problem,
        labels.value,
        labels.consequence,
      ]
      const lines = [header, ...answer.value.map((problem) => [
        String(problem.row),
        problem.column,
        problem.field,
        labels.problems[problem.code] ?? problem.code,
        problem.value,
        // Every listed row has the same consequence -- it is not imported --
        // and the column says so, because a file headed "every problem" read
        // beside a file of results should say what became of each row.
        labels.consequenceInvalid,
      ])]
      // Quoted unconditionally, and every quote doubled. A cell holding a
      // comma, a newline or a quote is exactly the kind of cell an import
      // rejects, so the error report is the one file in this product most
      // likely to contain all three.
      //
      // And guarded, which is a different job that quoting does not do:
      // quoting defends the *delimiter*, and a spreadsheet strips the quotes
      // before deciding whether the cell is a formula. Every value here --
      // the offending cell, and the file's own column heading -- was chosen by
      // whoever made the file, and a cell that failed its check is the one most
      // likely to be hostile. IMP2-08 in
      // `docs/features/data-import/phase-2-review.md`.
      const csv = lines
        .map((cells) => cells.map((cell) => '"' + guardCell(cell).split('"').join('""') + '"').join(','))
        .join(String.fromCharCode(13, 10))
      const url = URL.createObjectURL(
        new Blob([String.fromCharCode(0xfeff) + csv], { type: 'text/csv;charset=utf-8' }),
      )
      const link = document.createElement('a')
      link.href = url
      link.download = `import-${run.id}-errors.csv`
      link.click()
      URL.revokeObjectURL(url)
    } finally {
      setBusy(false)
    }
  }, [labels, run])

  const report = useCallback(async () => {
    if (run === null) return
    const answer = await listErrors(run.id)
    if (answer.status === 'error') {
      setError(answer.message)
      return
    }
    setProblems(answer.value)
  }, [run])

  const stop = useCallback(async () => {
    if (run === null) return
    setBusy(true)
    const answer = await cancelRun(run.id)
    setBusy(false)
    if (answer.status === 'error') {
      setError(answer.message)
      return
    }
    setRun(answer.value)
    setFocusTarget('wizard')
    await refresh()
  }, [refresh, run])

  if (targets.length === 0) {
    return <Banner tone="info">{labels.noTargets}</Banner>
  }

  // Built outside the JSX: a prop given an object literal opens with two
  // braces, which the generator reads as a Handlebars expression.
  const formats = target?.formats ?? []
  const templateFormats = target?.template_formats ?? []
  const ceiling =
    target === null
      ? ''
      : target.limits
        ? fill(labels.limits, {
            size: sizeOf(target.limits.max_bytes),
            rows: String(target.max_rows),
            formats: formats.join(', '),
          })
        : fill(labels.ceiling, {
            rows: String(target.max_rows),
            formats: formats.join(', '),
          })
  const accept = formats.map((format) => ACCEPT[format] ?? `.${format}`).join(',')
  const orderOf = (format: string) => {
    const at = TEMPLATE_ORDER.indexOf(format)
    return at === -1 ? TEMPLATE_ORDER.length : at
  }
  const templateItems = [...templateFormats].sort((a, b) => orderOf(a) - orderOf(b)).map((format) => ({
    key: format,
    href: `/api/imports/${encodeURIComponent(target?.key ?? '')}/template?format=${format}`,
    label: labels.template.formats[format] ?? format.toUpperCase(),
  }))
  const nameOf = (key: string): string => key
  const stepperLabels = {
    nav: labels.wizard.nav,
    steps: labels.wizard.steps,
    current: labels.wizard.current,
    done: labels.wizard.done,
  }
  const stateText =
    run === null
      ? ''
      : run.status === 'validated' && stage === 'confirm'
        ? labels.wizard.awaitingConfirmation
        : (labels.states[run.status] ?? run.status)
  const resultLink = run === null ? undefined : recordLinks?.[run.target]
  const sampleMapping = run === null ? {} : Object.keys(run.mapping ?? {}).length > 0 ? run.mapping : mapping
  const sampleColumns = Object.entries(sampleMapping)
  const verdict = analysis?.template ?? null
  const predicted = run?.predicted ?? null
  const written = run?.written ?? null
  const invalid = run === null ? 0 : run.rows_total - run.rows_valid

  return (
    <div className="mt-8 space-y-8" data-testid="imports-panel">
      <ImportStepper stage={stage} labels={stepperLabels} />
      <p role="status" className="sr-only" data-testid="imports-opened">
        {announce}
      </p>
      {error === null ? null : <Banner tone="error">{error}</Banner>}

      {run === null || phase !== 'idle' ? (
      <Card>
        <h2
          className="font-display text-lg font-semibold text-ink"
          data-testid="imports-start"
        >
          {labels.startTitle}
        </h2>
        <p className="mt-1 text-sm text-ink-muted">{labels.startDescription}</p>
        <div className="mt-4 grid items-start gap-4 sm:grid-cols-2" data-testid="imports-start-fields">
          <SelectField
            id="import-target"
            label={labels.target}
            value={targetKey}
            onChange={(event) => {
              const next = event.target.value
              setTargetKey(next)
              const picked = targets.find((candidate) => candidate.key === next)
              setOperation(picked?.operations[0] ?? '')
            }}
          >
            {targets.map((candidate) => (
              <option key={candidate.key} value={candidate.key}>
                {candidate.key}
              </option>
            ))}
          </SelectField>
          <SelectField
            id="import-operation"
            label={labels.operation}
            hint={labels.operationHint}
            hintPlacement="below"
            value={operation}
            onChange={(event) => setOperation(event.target.value)}
          >
            {(target?.operations ?? []).map((name) => (
              <option key={name} value={name}>
                {labels.operations[name] ?? name}
              </option>
            ))}
          </SelectField>
        </div>
        {/* The template first, because the workflow starts there: download,
            fill in, upload. One control with the formats inside it, and the
            same control for a target with one format as with two. */}
        <div className="mt-4 flex flex-wrap items-center gap-3" data-testid="imports-template">
          <DownloadMenu
            label={labels.template.download}
            items={templateItems}
            disabled={busy}
            testId="imports-template-menu"
          />
          <p className="text-sm text-ink-muted">{labels.template.hint}</p>
        </div>
        <p className="mt-3 text-xs text-ink-muted" data-testid="imports-limits">
          {ceiling}
        </p>
        <div className="mt-4">
          <label className="text-sm font-medium text-ink" htmlFor="import-file">
            {labels.file}
          </label>
          <input
            id="import-file"
            ref={input}
            type="file"
            accept={accept}
            disabled={busy}
            className="mt-1 block w-full text-sm text-ink"
            onChange={(event) => {
              const file = event.target.files?.[0]
              if (file) void choose(file)
            }}
          />
          {chosen === null ? null : (
            <p className="mt-2 text-sm text-ink" data-testid="imports-chosen">
              {fill(labels.chosenFile, { name: chosen.name, size: sizeOf(chosen.size) })}
            </p>
          )}
{{#if capability.secure_files}}
          {/* Present from the start and announced politely, like the Files page's. */}
          <p
            role="status"
            className={preparing ? 'mt-2 text-sm text-ink-muted' : 'sr-only'}
            data-testid="imports-preparing"
          >
            {preparing ? labels.preparing : ''}
          </p>
{{/if}}
          {/* Always mounted: a live region that arrives with its text is announced
              unreliably, one that is already there and then changes is not. */}
          <div role="status" aria-live="polite" data-testid="imports-source-live">
            {starting ? (
              <p className="mt-3 text-sm text-ink-muted" data-testid="imports-starting">
                {labels.starting}
              </p>
            ) : null}
            {chosen === null || !SOURCE_PHASES.has(phase) ? null : (
              <div
                ref={sourceBox}
                tabIndex={-1}
                className="mt-3 scroll-mt-24 space-y-3 outline-none focus-visible:outline-2 focus-visible:outline-offset-2"
                data-testid="imports-source"
                data-phase={phase}
              >
                <Banner
                  // A long file name has no break opportunity of its own.
                  className="[overflow-wrap:anywhere]"
                  tone={
                    phase === 'checking' || phase === 'stalled' || phase === 'ready'
                      ? 'info'
                      : phase === 'held'
                        ? 'warning'
                        : 'error'
                  }
                >
                  {fill(labels.source[phase as SourceMessage], { name: chosen.name })}
                </Banner>
                {retryNote === null ? null : (
                  <p className="text-sm text-ink-muted" data-testid="imports-source-retry">
                    {retryNote}
                  </p>
                )}
                {checkedStill ? (
                  <p className="text-sm text-ink-muted" data-testid="imports-source-rechecked">
                    {labels.source.checkedStill}
                  </p>
                ) : null}
                {phase === 'checking' || phase === 'stalled' || phase === 'ready' ? (
                  <div className="flex flex-wrap gap-3">
                    {phase === 'ready' ? (
                      <Button type="button" onClick={continueResumed} disabled={busy}>
                        {labels.source.continue}
                      </Button>
                    ) : null}
                    {phase === 'stalled' ? (
                      <Button
                        type="button"
                        variant="secondary"
                        onClick={checkAgain}
                        aria-disabled={rechecking}
                      >
                        {rechecking ? labels.source.rechecking : labels.source.checkAgain}
                      </Button>
                    ) : null}
                    <Button type="button" variant="ghost" onClick={stopWaiting}>
                      {labels.source.stop}
                    </Button>
                  </div>
                ) : null}
              </div>
            )}
          </div>
        </div>
      </Card>
      ) : null}

      {run === null ||
      analysis === null ||
      !MAPPABLE.has(run.status) ||
      (run.status === 'validated' && !remap) ? null : (
        <Card>
          <h2
            ref={mapHeading}
            tabIndex={-1}
            className="scroll-mt-24 font-display text-lg font-semibold text-ink outline-none focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            {labels.mapTitle}
          </h2>
          <p className="mt-1 text-sm text-ink-muted">{labels.mapDescription}</p>
          {analysis.sheet ? (
            <p className="mt-1 text-xs text-ink-muted" data-testid="imports-sheet">
              {fill(labels.sheet, { sheet: analysis.sheet })}
            </p>
          ) : null}
          {verdict === null ? null : (
            <div className="mt-3 space-y-2" data-testid="imports-verdict" data-verdict={verdict.verdict}>
              {verdict.stale ? (
                <Banner tone="warning">
                  {fill(labels.template.stale, {
                    found: String(verdict.version_found ?? ''),
                    current: String(runTarget?.version ?? target?.version ?? ''),
                  })}
                </Banner>
              ) : null}
              {verdict.verdict === 'compatible' ? (
                <Banner tone="info">{labels.template.compatible}</Banner>
              ) : verdict.verdict === 'unknown_columns' ? (
                <Banner tone="info">
                  {fill(labels.template.unknownColumns, {
                    columns: verdict.unknown_columns.join(', '),
                  })}
                </Banner>
              ) : (
                <Banner tone="warning">
                  {fill(labels.template.incompatible, {
                    fields: verdict.missing_required.join(', '),
                  })}
                </Banner>
              )}
            </div>
          )}
          {analysis.over_ceiling ? <Banner tone="warning">{labels.tooManyRows}</Banner> : null}
          {analysis.rows_seen === 0 ? (
            <Banner tone="warning">
              {labels.wizard.emptyFile}
            </Banner>
          ) : null}
          {analysis.replaced ? <Banner tone="warning">{labels.replaced}</Banner> : null}
          <div className="relative mt-4 overflow-x-auto">
            <table className="w-full text-sm">
              <thead>
                <tr className="text-left text-xs uppercase text-ink-muted">
                  <th className="py-2 pr-4">{labels.column}</th>
                  <th className="py-2 pr-4">{labels.sample}</th>
                  <th className="py-2">{labels.field}</th>
                </tr>
              </thead>
              <tbody>
                {analysis.columns.map((column) => (
                  <tr key={column} className="border-t border-border">
                    <td className="py-2 pr-4 font-medium text-ink">{column}</td>
                    <td className="py-2 pr-4 text-ink-muted">
                      {analysis.preview[0]?.[column] ?? ''}
                    </td>
                    <td className="py-2">
                      <SelectField
                        id={`import-map-${column}`}
                        label={fill(labels.mapColumn, { column })}
                        value={mapping[column] ?? ''}
                        onChange={(event) => {
                          const value = event.target.value
                          setMapping((current) => {
                            const next = { ...current }
                            if (value === '') delete next[column]
                            else next[column] = value
                            return next
                          })
                        }}
                      >
                        <option value="">{labels.ignore}</option>
                        {(runTarget?.fields ?? []).map((field) => (
                          <option key={field.name} value={field.name}>
                            {field.name}
                          </option>
                        ))}
                      </SelectField>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div className="mt-4 flex flex-wrap gap-3">
            <Button
              type="button"
              onClick={() => void check()}
              disabled={busy || analysis.over_ceiling || analysis.rows_seen === 0}
            >
              {busy ? labels.checking : labels.check}
            </Button>
            <Button type="button" variant="ghost" onClick={() => void stop()} disabled={busy}>
              {labels.discard}
            </Button>
          </div>
        </Card>
      )}

      {run === null ? null : (
        <Card>
          <h2
            ref={wizardHeading}
            tabIndex={-1}
            className="scroll-mt-24 font-display text-lg font-semibold text-ink outline-none focus-visible:outline-2 focus-visible:outline-offset-2"
            data-testid="imports-wizard-heading"
          >
            {stage === null
              ? (labels.wizard.titles.cancelled ?? labels.resultTitle)
              : (labels.wizard.titles[stage] ?? labels.resultTitle)}
          </h2>
          {run.source_name ? (
            <p className="mt-1 break-words text-sm text-ink" data-testid="imports-run-file">
              {run.source_name} · {nameOf(run.target)}
            </p>
          ) : null}
          <p className="mt-1 text-sm text-ink-muted" role="status" data-testid="imports-state">
            {stateText}
          </p>
          {analysing ? (
            <p className="mt-2 text-sm text-ink-muted" data-testid="imports-analysing">
              {labels.wizard.loadingRun}
            </p>
          ) : null}
          {analysisFailed === run.id && MAPPABLE.has(run.status) ? (
            <Banner tone="warning">
              {labels.wizard.fileGone}
              <span className="mt-2 block">
                <Button type="button" variant="secondary" onClick={() => void stop()} disabled={busy}>
                  {labels.discard}
                </Button>
              </span>
            </Banner>
          ) : null}
          {stage === 'processing' && run.status !== 'failed' ? (
            <p className="mt-2 text-sm text-ink-muted" data-testid="imports-processing">
              {labels.wizard.processingHint}
            </p>
          ) : null}
          {run.status === 'cancelled' ? (
            <Banner tone="info">{labels.wizard.cancelledNote}</Banner>
          ) : null}
          {run.error === null ? null : <Banner tone="error">{run.error}</Banner>}
          {run.status === 'validated' || run.status === 'validation_failed' ? (
            <dl className="mt-3 grid gap-2 sm:grid-cols-4" data-testid="imports-preview">
              <Figure label={labels.preview.total} value={String(run.rows_total)} testId="imports-preview-total" />
              <Figure label={labels.preview.valid} value={String(run.rows_valid)} testId="imports-preview-valid" />
              <Figure label={labels.preview.invalid} value={String(invalid)} testId="imports-preview-invalid" />
              <Figure
                label={labels.preview.duplicate}
                value={String(run.rows_duplicate ?? 0)}
                testId="imports-preview-duplicate"
              />
              {predicted === null ? null : (
                <>
                  <Figure label={labels.preview.create} value={String(predicted.create)} testId="imports-preview-create" />
                  <Figure label={labels.preview.update} value={String(predicted.update)} testId="imports-preview-update" />
                  <Figure label={labels.preview.skip} value={String(predicted.skip)} testId="imports-preview-skip" />
                </>
              )}
            </dl>
          ) : null}
          {(run.status === 'validated' || run.status === 'validation_failed') && predicted === null ? (
            <p className="mt-2 text-xs text-ink-muted" data-testid="imports-preview-unknown">
              {labels.preview.unknown}
            </p>
          ) : null}
          {run.status === 'validated' ? (
            <p className="mt-3 text-sm text-ink">
              {fill(labels.summary, {
                rows: String(run.rows_total),
                valid: String(run.rows_valid),
                errors: String(run.errors_total),
              })}
            </p>
          ) : null}
          {run.status === 'validated' ? <Banner tone="info">{labels.wroteNothing}</Banner> : null}
          {run.status === 'validated' && (stage === 'review' || stage === 'confirm') ? (
            <div className="mt-4 space-y-3" data-testid="imports-review">
              <dl className="grid gap-3 text-sm sm:grid-cols-3">
                <div>
                  <dt className="text-xs uppercase text-ink-muted">{labels.wizard.review.file}</dt>
                  <dd className="break-words text-ink" data-testid="imports-review-file">
                    {run.source_name ?? '—'}
                  </dd>
                </div>
                <div>
                  <dt className="text-xs uppercase text-ink-muted">{labels.wizard.review.records}</dt>
                  <dd className="text-ink">{nameOf(run.target)}</dd>
                </div>
                <div>
                  <dt className="text-xs uppercase text-ink-muted">{labels.wizard.review.policy}</dt>
                  <dd className="text-ink" data-testid="imports-review-policy">
                    {labels.operations[run.operation] ?? run.operation}
                  </dd>
                </div>
              </dl>
              {analysis !== null && sampleColumns.length > 0 && analysis.preview.length > 0 ? (
                <div
                  className="relative overflow-x-auto"
                  tabIndex={0}
                  role="region"
                  aria-label={labels.wizard.review.samples}
                >
                  <table className="w-full text-sm" data-testid="imports-review-sample">
                    <caption className="pb-2 text-left text-xs uppercase text-ink-muted">
                      {labels.wizard.review.samples}
                    </caption>
                    <thead>
                      <tr className="text-left text-xs text-ink-muted">
                        {sampleColumns.map(([column, field]) => (
                          <th key={column} scope="col" className="py-1 pr-4 font-medium">
                            {field}
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {analysis.preview.slice(0, 5).map((row, index) => (
                        <tr key={index} className="border-t border-border">
                          {sampleColumns.map(([column]) => (
                            <td key={column} className="py-1 pr-4 text-ink">
                              {row[column] ?? ''}
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ) : null}
            </div>
          ) : null}
          {run.status === 'validated' && stage === 'review' && runTarget?.committable === true ? (
            <div className="mt-4 flex flex-wrap gap-3" data-testid="imports-review-actions">
              <Button
                type="button"
                onClick={() => {
                  setReviewed(true)
                  setFocusTarget('wizard')
                }}
                disabled={busy}
              >
                {labels.wizard.review.continue}
              </Button>
              <Button
                type="button"
                variant="secondary"
                onClick={() => {
                  setRemap(true)
                  setFocusTarget('mappingNow')
                }}
                disabled={busy}
              >
                {labels.wizard.review.changeMapping}
              </Button>
            </div>
          ) : null}
          {run.status === 'validated' && stage === 'confirm' && runTarget?.committable === true ? (
            <div className="mt-4 space-y-2" data-testid="imports-confirm">
              <p className="text-sm text-ink-muted">{labels.confirmHint}</p>
              <div className="flex flex-wrap gap-3">
                <Button type="button" onClick={() => void confirm()} disabled={busy}>
                  {busy ? labels.committing : labels.confirm}
                </Button>
                <Button
                  type="button"
                  variant="secondary"
                  onClick={() => {
                    setReviewed(false)
                    setFocusTarget('wizard')
                  }}
                  disabled={busy}
                >
                  {labels.wizard.review.back}
                </Button>
              </div>
            </div>
          ) : null}
          {run.status === 'validated' && runTarget?.committable !== true ? (
            <Banner tone="info">{labels.notCommittable}</Banner>
          ) : null}
          {/*
            * **The outcome takes focus, and it is the same fix as SET-24.**
            * Confirming unmounts the button that was activated -- the block
            * above is gated on `validated` -- so focus falls to `BODY`, and
            * this sentence arrives inside a subtree that mounts with it, which
            * a live region does not announce. A person working by screen
            * reader confirmed an irreversible write of thousands of records and
            * was told nothing, twice over. `SaveOutcome` moves focus on mount,
            * so a reader reads what it lands on without depending on
            * live-region semantics at all. IMP2-10 in
            * `docs/features/data-import/phase-2-review.md`.
            */}
          {run.status === 'committed' ? (
            <SaveOutcome
              className="mt-3 text-sm text-ink"
              testId="imports-committed"
              outcome="ok"
              message={
                written === null
                  ? fill(labels.wrote, {
                      created: String(run.rows_valid),
                      total: String(run.rows_total),
                    })
                  : labels.result.title
              }
            />
          ) : null}
          {run.status === 'committed' && written !== null ? (
            <table className="mt-3 w-auto text-sm" data-testid="imports-result">
              <caption className="sr-only">{labels.result.title}</caption>
              <tbody>
                {[
                  [labels.result.total, run.rows_total, 'total'],
                  [labels.result.created, written.created, 'created'],
                  [labels.result.updated, written.updated, 'updated'],
                  [labels.result.skipped, written.skipped, 'skipped'],
                  // Zero for every committed run: a commit is atomic. Drawn
                  // anyway, because a table compared across runs should have
                  // the same rows every time, and a missing row reads as a
                  // figure withheld.
                  [labels.result.failed, 0, 'failed'],
                ].map(([label, value, key]) => (
                  <tr key={String(key)} className="border-t border-border">
                    <th scope="row" className="py-1 pr-8 text-left font-medium text-ink">
                      {label}
                    </th>
                    <td className="py-1 text-right tabular-nums text-ink" data-testid={`imports-result-${key}`}>
                      {String(value)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : null}
          {run.status === 'failed' ? (
            <SaveOutcome
              className="mt-3 text-sm text-ink"
              testId="imports-failed"
              outcome="error"
              message={labels.states[run.status] ?? run.status}
            />
          ) : null}
          {run.status !== 'validating' ? (
            <div className="mt-4 flex flex-wrap gap-3" data-testid="imports-ended-actions">
              {run.status === 'committed' && resultLink !== undefined ? (
                <ButtonLink href={resultLink.href} variant="secondary">
                  {resultLink.label}
                </ButtonLink>
              ) : null}
              <Button type="button" variant="secondary" onClick={another}>
                {labels.wizard.anotherFile}
              </Button>
            </div>
          ) : null}
          {run.errors_total > 0 ? (
            <div className="mt-4 flex flex-wrap gap-2">
              <Button type="button" variant="secondary" onClick={() => void report()}>
                {labels.showReport}
              </Button>
              <Button
                type="button"
                variant="secondary"
                onClick={() => void download()}
                disabled={busy}
              >
                {labels.downloadReport}
              </Button>
            </div>
          ) : null}
          {run.errors_total > 0 && run.errors_cut ? (
            <p className="mt-2 text-xs text-ink-muted">{labels.reportCut}</p>
          ) : null}
          {problems === null ? null : (
            <div className="relative mt-4 overflow-x-auto">
              <table className="w-full text-sm" data-testid="imports-problems">
                <thead>
                  <tr className="text-left text-xs uppercase text-ink-muted">
                    <th className="py-2 pr-4">{labels.row}</th>
                    <th className="py-2 pr-4">{labels.column}</th>
                    <th className="py-2 pr-4">{labels.problem}</th>
                    <th className="py-2">{labels.value}</th>
                  </tr>
                </thead>
                <tbody>
                  {problems.map((problem, index) => (
                    <tr
                      key={`${problem.row}-${problem.column}-${index}`}
                      className="border-t border-border"
                    >
                      <td className="py-2 pr-4 tabular-nums">{problem.row}</td>
                      <td className="py-2 pr-4">{problem.column}</td>
                      <td className="py-2 pr-4">{labels.problems[problem.code] ?? problem.code}</td>
                      <td className="py-2 text-ink-muted">{problem.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </Card>
      )}

      <Card>
        <h2 className="font-display text-lg font-semibold text-ink">{labels.historyTitle}</h2>
        {runs.length === 0 ? (
          <p className="mt-2 text-sm text-ink-muted">{labels.noRuns}</p>
        ) : (
          <div className="relative mt-4 overflow-x-auto">
            <table className="w-full text-sm" data-testid="imports-history">
              <thead>
                <tr className="text-left text-xs uppercase text-ink-muted">
                  <th className="py-2 pr-4">{labels.target}</th>
                  <th className="py-2 pr-4">{labels.file}</th>
                  <th className="py-2 pr-4">{labels.format}</th>
                  <th className="py-2 pr-4">{labels.state}</th>
                  <th className="py-2 pr-4">{labels.rows}</th>
                  <th className="py-2">{labels.started}</th>
                  {/* No heading: a column of controls has nothing to name that
                      the controls do not say themselves, and an empty string
                      here is read out as a blank cell rather than skipped.
                      The wrapper above is `relative` because this span is
                      absolutely positioned by `sr-only`, and an absolute
                      descendant of an unpositioned scroll container escapes
                      its clipping -- at 375 pixels the page scrolled
                      sideways by the width of a table nobody could see.
                      Found by manual case 53 on 2026-09-29. */}
                  <th className="py-2">
                    <span className="sr-only">{labels.open}</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {runs.map((row) => (
                  <tr key={row.id} className="border-t border-border" data-run-id={row.id}>
                    <td className="py-2 pr-4">{row.target}</td>
                    <td className="max-w-[16rem] break-words py-2 pr-4">{row.source_name ?? '—'}</td>
                    <td className="py-2 pr-4 uppercase">{row.format ?? 'csv'}</td>
                    <td className="py-2 pr-4">{labels.states[row.status] ?? row.status}</td>
                    <td className="py-2 pr-4 tabular-nums">{row.rows_total}</td>
                    <td className="py-2 text-ink-muted">
                      <LocalTime iso={row.created_at} locale={locale} />
                    </td>
                    <td className="py-2 text-right">
                      <Button
                        type="button"
                        variant="secondary"
                        aria-label={fill(labels.openRun, { target: row.target })}
                        aria-current={run?.id === row.id ? 'true' : undefined}
                        data-testid="imports-open"
                        disabled={analysing}
                        onClick={() => open(row)}
                      >
                        {labels.open}
                      </Button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </Card>
    </div>
  )
}

'use client'

import { Banner, Button, Card, SaveOutcome, SelectField } from '@{{projectSlug}}/ui'
import type {
  ImportAnalysisView,
  ImportRowErrorView,
  ImportRunView,
  ImportTargetView,
} from '@{{projectSlug}}/api-client'
import { useCallback, useEffect, useRef, useState } from 'react'
import {
  allErrors,
  analyseRun,
  cancelRun,
  commitRun,
  completeSourceUpload,
  listErrors,
  listRuns,
  requestSourceUpload,
  saveMapping,
  startRun,
  validateRun,
} from './actions'
import type { ImportLabels } from './labels'

/**
 * Upload, map, check -- and, since Phase 2, confirm.
 *
 * **The confirm control is absent rather than disabled for a target that
 * declares no writer.** `committable` is false for such a target and no button
 * renders at all, which is the shape the whole panel had before a commit
 * existed: a disabled control promises a thing this product cannot do, and a
 * person cannot tell "not yet" from "not for you".
 *
 * **Confirming is a second act by a person, and it says what it will do.** The
 * run moves to `commit_requested` and a worker does the writing, so the panel
 * polls the way it already polls a dry run. `committed_by` is what the run
 * records, separately from `requested_by`, and they are frequently the same
 * person -- the fact worth keeping is that somebody read a dry run and said
 * yes.
 *
 * **The report downloads.** A person fixing a file works in a spreadsheet, not
 * in a table on a web page, and the criterion for a failed run is that they can
 * get every bad row out. The screen still shows the first page, because most
 * files are wrong in one obvious way and scrolling beats downloading.
 *
 * Three refusals a person can hit are worth naming, because each is a sentence
 * rather than a silence: a file whose headings the target cannot use, a file
 * over the row ceiling, and a queue that is not configured. The last is a 503
 * from the API rather than an accepted request, because a dry run that is
 * promised and never happens leaves somebody watching a spinner forever.
 */

/** A digest of what is about to be sent, where the browser can take one. */
async function digestOf(file: File): Promise<string | null> {
  try {
    if (!globalThis.crypto?.subtle) return null
    const hashed = await globalThis.crypto.subtle.digest('SHA-256', await file.arrayBuffer())
    return Array.from(new Uint8Array(hashed))
      .map((byte) => byte.toString(16).padStart(2, '0'))
      .join('')
  } catch {
    return null
  }
}

async function put(url: string, headers: Record<string, string>, file: File): Promise<void> {
  const response = await fetch(url, { method: 'PUT', headers, body: file })
  if (!response.ok) throw new Error(`the bucket answered ${response.status}`)
}

/**
 * Neutralise a cell a spreadsheet would otherwise execute.
 *
 * Excel and LibreOffice evaluate a cell whose first character is `=`, `+`, `-`
 * or `@` -- inside quotation marks as much as outside them, because the quotes
 * are the CSV's, and the spreadsheet has already removed them by the time it
 * decides. A leading apostrophe is the documented way to say "this is text",
 * and it is what a person pasting a formula into a cell would type themselves.
 *
 * Tab and carriage return are here too: both can carry the trigger character
 * into the next cell on some importers.
 */
function guardCell(cell: string): string {
  return /^[=+\-@\t\r]/.test(cell) ? `'${cell}` : cell
}

/**
 * Which runs are still moving, and so worth asking about again.
 *
 * **`commit_requested` is in this set, and leaving it out stopped the page
 * dead.** The commit route answers with the run in `commit_requested`; only the
 * worker moves it on to `committing`. So confirming an import used to end the
 * polling it was supposed to start: the card froze on the request sentence
 * while the rows were written, and a person who assumed it had failed pressed
 * Confirm again and got a 409 drawn as an error over a successful import.
 * IMP2-06 in `docs/features/data-import/phase-2-review.md`.
 */
const IN_FLIGHT = new Set(['validating', 'commit_requested', 'committing'])

function fill(template: string, values: Record<string, string>): string {
  return template.replace(/\{(\w+)\}/g, (_, key: string) => values[key] ?? '')
}

export function ImportPanel({
  targets,
  initialRuns,
  labels,
}: {
  targets: ImportTargetView[]
  initialRuns: ImportRunView[]
  labels: ImportLabels
}) {
  const [runs, setRuns] = useState<ImportRunView[]>(initialRuns)
  const [error, setError] = useState<string | null>(null)
  const [busy, setBusy] = useState(false)

  const [targetKey, setTargetKey] = useState<string>(targets[0]?.key ?? '')
  const [operation, setOperation] = useState<string>(targets[0]?.operations[0] ?? '')
  const [run, setRun] = useState<ImportRunView | null>(null)
  const [analysis, setAnalysis] = useState<ImportAnalysisView | null>(null)
  const [mapping, setMapping] = useState<Record<string, string>>({})
  const [problems, setProblems] = useState<ImportRowErrorView[] | null>(null)
  const input = useRef<HTMLInputElement>(null)

  const target = targets.find((candidate) => candidate.key === targetKey) ?? null
  // **The run's own target, not the picker's.** They are the same until
  // somebody changes the picker with a run in progress, and then the confirm
  // control would be answering a question about a different import.
  const runTarget =
    run === null ? null : (targets.find((candidate) => candidate.key === run.target) ?? null)

  /**
   * Open a run from the history.
   *
   * **Without this the report is unreachable.** `run` starts `null` on every
   * load and `refresh` keeps a null null, so a person who reloaded the page --
   * or came back to it later -- had no current run, and *Download every
   * problem* lives inside the result card, which renders only when there is
   * one. The run stayed listed below, the route went on answering, and nothing
   * on the page could reach it. IMP2-29 in
   * `docs/features/data-import/phase-2-review.md`.
   *
   * The analysis and the problems are cleared rather than kept: both belong to
   * whichever run was open before, and a report from one run shown under
   * another is worse than no report at all.
   */
  const open = useCallback((chosen: ImportRunView) => {
    setError(null)
    setAnalysis(null)
    setProblems(null)
    setRun(chosen)
  }, [])

  const refresh = useCallback(async () => {
    const answer = await listRuns()
    if (answer.status === 'ok') {
      setRuns(answer.value)
      setRun((current) =>
        current === null ? null : (answer.value.find((row) => row.id === current.id) ?? current),
      )
    }
  }, [])

  // A dry run happens in the worker, so the page has to ask. The polling stops
  // the moment nothing is moving: a page left open on a finished run should
  // cost the API nothing.
  useEffect(() => {
    if (run === null || !IN_FLIGHT.has(run.status)) return
    const timer = setInterval(() => void refresh(), 3000)
    return () => clearInterval(timer)
  }, [run, refresh])

  const choose = useCallback(
    async (file: File) => {
      if (target === null) return
      setBusy(true)
      setError(null)
      setProblems(null)
      setAnalysis(null)
      try {
        const checksum = await digestOf(file)
        const ticket = await requestSourceUpload({
          name: file.name,
          sizeBytes: file.size,
          contentType: file.type || 'text/csv',
          checksumSha256: checksum,
        })
        if (ticket.status === 'error') {
          setError(ticket.message)
          return
        }
        await put(ticket.value.upload_url, ticket.value.headers, file)
        const done = await completeSourceUpload(ticket.value.file_id, checksum)
        if (done.status === 'error') {
          setError(done.message)
          return
        }
        const started = await startRun({
          target: target.key,
          fileId: ticket.value.file_id,
          operation,
        })
        if (started.status === 'error') {
          setError(started.message)
          return
        }
        setRun(started.value)
        const found = await analyseRun(started.value.id)
        if (found.status === 'error') {
          setError(found.message)
          return
        }
        setAnalysis(found.value)
        setMapping(found.value.suggested)
        await refresh()
      } catch (failure) {
        setError(failure instanceof Error ? failure.message : String(failure))
      } finally {
        setBusy(false)
        if (input.current) input.current.value = ''
      }
    },
    [operation, refresh, target],
  )

  const check = useCallback(async () => {
    if (run === null) return
    setBusy(true)
    setError(null)
    try {
      const saved = await saveMapping(run.id, mapping)
      if (saved.status === 'error') {
        setError(saved.message)
        return
      }
      const queued = await validateRun(run.id)
      if (queued.status === 'error') {
        setError(queued.message)
        return
      }
      setRun(queued.value)
      await refresh()
    } finally {
      setBusy(false)
    }
  }, [mapping, refresh, run])

  const confirm = useCallback(async () => {
    if (run === null) return
    setBusy(true)
    setError(null)
    try {
      const queued = await commitRun(run.id)
      if (queued.status === 'error') {
        setError(queued.message)
        return
      }
      setRun(queued.value)
      await refresh()
    } finally {
      setBusy(false)
    }
  }, [refresh, run])

  const download = useCallback(async () => {
    if (run === null) return
    setBusy(true)
    try {
      const answer = await allErrors(run.id, run.errors_total)
      if (answer.status === 'error') {
        setError(answer.message)
        return
      }
      const header = [labels.row, labels.column, labels.field, labels.problem, labels.value]
      const lines = [header, ...answer.value.map((problem) => [
        String(problem.row),
        problem.column,
        problem.field,
        labels.problems[problem.code] ?? problem.code,
        problem.value,
      ])]
      // Quoted unconditionally, and every quote doubled. A cell holding a
      // comma, a newline or a quote is exactly the kind of cell an import
      // rejects, so the error report is the one file in this product most
      // likely to contain all three.
      //
      // And guarded, which is a different job that quoting does not do:
      // quoting defends the *delimiter*, and a spreadsheet strips the quotes
      // before deciding whether the cell is a formula. Every value here --
      // the offending cell, and the file's own column heading -- was chosen by
      // whoever made the file, and a cell that failed its check is the one most
      // likely to be hostile. IMP2-08 in
      // `docs/features/data-import/phase-2-review.md`.
      const csv = lines
        .map((cells) => cells.map((cell) => '"' + guardCell(cell).split('"').join('""') + '"').join(','))
        .join(String.fromCharCode(13, 10))
      const url = URL.createObjectURL(
        new Blob([String.fromCharCode(0xfeff) + csv], { type: 'text/csv;charset=utf-8' }),
      )
      const link = document.createElement('a')
      link.href = url
      link.download = `import-${run.id}-errors.csv`
      link.click()
      URL.revokeObjectURL(url)
    } finally {
      setBusy(false)
    }
  }, [labels, run])

  const report = useCallback(async () => {
    if (run === null) return
    const answer = await listErrors(run.id)
    if (answer.status === 'error') {
      setError(answer.message)
      return
    }
    setProblems(answer.value)
  }, [run])

  const stop = useCallback(async () => {
    if (run === null) return
    setBusy(true)
    const answer = await cancelRun(run.id)
    setBusy(false)
    if (answer.status === 'error') {
      setError(answer.message)
      return
    }
    setRun(answer.value)
    await refresh()
  }, [refresh, run])

  if (targets.length === 0) {
    return <Banner tone="info">{labels.noTargets}</Banner>
  }

  // Built outside the JSX: a prop given an object literal opens with two
  // braces, which the generator reads as a Handlebars expression.
  const ceiling =
    target === null
      ? ''
      : fill(labels.ceiling, {
          rows: String(target.max_rows),
          formats: target.formats.join(', '),
        })

  return (
    <div className="mt-8 space-y-8" data-testid="imports-panel">
      {error === null ? null : <Banner tone="error">{error}</Banner>}

      <Card>
        <h2
          className="font-display text-lg font-semibold text-ink"
          data-testid="imports-start"
        >
          {labels.startTitle}
        </h2>
        <p className="mt-1 text-sm text-ink-muted">{labels.startDescription}</p>
        <div className="mt-4 grid gap-4 sm:grid-cols-2">
          <SelectField
            id="import-target"
            label={labels.target}
            value={targetKey}
            onChange={(event) => {
              const next = event.target.value
              setTargetKey(next)
              const chosen = targets.find((candidate) => candidate.key === next)
              setOperation(chosen?.operations[0] ?? '')
            }}
          >
            {targets.map((candidate) => (
              <option key={candidate.key} value={candidate.key}>
                {candidate.key}
              </option>
            ))}
          </SelectField>
          <SelectField
            id="import-operation"
            label={labels.operation}
            hint={labels.operationHint}
            value={operation}
            onChange={(event) => setOperation(event.target.value)}
          >
            {(target?.operations ?? []).map((name) => (
              <option key={name} value={name}>
                {labels.operations[name] ?? name}
              </option>
            ))}
          </SelectField>
        </div>
        <p className="mt-3 text-xs text-ink-muted">{ceiling}</p>
        <div className="mt-4">
          <label className="text-sm font-medium text-ink" htmlFor="import-file">
            {labels.file}
          </label>
          <input
            id="import-file"
            ref={input}
            type="file"
            accept=".csv,.tsv,text/csv"
            disabled={busy}
            className="mt-1 block w-full text-sm text-ink"
            onChange={(event) => {
              const file = event.target.files?.[0]
              if (file) void choose(file)
            }}
          />
        </div>
      </Card>

      {run === null || analysis === null ? null : (
        <Card>
          <h2 className="font-display text-lg font-semibold text-ink">{labels.mapTitle}</h2>
          <p className="mt-1 text-sm text-ink-muted">{labels.mapDescription}</p>
          {analysis.over_ceiling ? <Banner tone="warning">{labels.tooManyRows}</Banner> : null}
          {analysis.replaced ? <Banner tone="warning">{labels.replaced}</Banner> : null}
          <div className="mt-4 overflow-x-auto">
            <table className="w-full text-sm">
              <thead>
                <tr className="text-left text-xs uppercase text-ink-muted">
                  <th className="py-2 pr-4">{labels.column}</th>
                  <th className="py-2 pr-4">{labels.sample}</th>
                  <th className="py-2">{labels.field}</th>
                </tr>
              </thead>
              <tbody>
                {analysis.columns.map((column) => (
                  <tr key={column} className="border-t border-border">
                    <td className="py-2 pr-4 font-medium text-ink">{column}</td>
                    <td className="py-2 pr-4 text-ink-muted">
                      {analysis.preview[0]?.[column] ?? ''}
                    </td>
                    <td className="py-2">
                      <SelectField
                        id={`import-map-${column}`}
                        label={fill(labels.mapColumn, { column })}
                        value={mapping[column] ?? ''}
                        onChange={(event) => {
                          const value = event.target.value
                          setMapping((current) => {
                            const next = { ...current }
                            if (value === '') delete next[column]
                            else next[column] = value
                            return next
                          })
                        }}
                      >
                        <option value="">{labels.ignore}</option>
                        {(target?.fields ?? []).map((field) => (
                          <option key={field.name} value={field.name}>
                            {field.name}
                          </option>
                        ))}
                      </SelectField>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div className="mt-4 flex flex-wrap gap-3">
            <Button
              type="button"
              onClick={() => void check()}
              disabled={busy || analysis.over_ceiling}
            >
              {busy ? labels.checking : labels.check}
            </Button>
            <Button type="button" variant="ghost" onClick={() => void stop()} disabled={busy}>
              {labels.discard}
            </Button>
          </div>
        </Card>
      )}

      {run === null ? null : (
        <Card>
          <h2 className="font-display text-lg font-semibold text-ink">{labels.resultTitle}</h2>
          <p className="mt-1 text-sm text-ink-muted">{labels.states[run.status] ?? run.status}</p>
          {run.error === null ? null : <Banner tone="error">{run.error}</Banner>}
          {run.status === 'validated' ? (
            <p className="mt-3 text-sm text-ink">
              {fill(labels.summary, {
                rows: String(run.rows_total),
                valid: String(run.rows_valid),
                errors: String(run.errors_total),
              })}
            </p>
          ) : null}
          {run.status === 'validated' ? <Banner tone="info">{labels.wroteNothing}</Banner> : null}
          {run.status === 'validated' && runTarget?.committable === true ? (
            <div className="mt-4 space-y-2" data-testid="imports-confirm">
              <p className="text-sm text-ink-muted">{labels.confirmHint}</p>
              <Button type="button" onClick={() => void confirm()} disabled={busy}>
                {busy ? labels.committing : labels.confirm}
              </Button>
            </div>
          ) : null}
          {run.status === 'validated' && runTarget?.committable !== true ? (
            <Banner tone="info">{labels.notCommittable}</Banner>
          ) : null}
          {/*
            * **The outcome takes focus, and it is the same fix as SET-24.**
            * Confirming unmounts the button that was activated -- the block
            * above is gated on `validated` -- so focus falls to `BODY`, and
            * this sentence arrives inside a subtree that mounts with it, which
            * a live region does not announce. A person working by screen
            * reader confirmed an irreversible write of thousands of records and
            * was told nothing, twice over. `SaveOutcome` moves focus on mount,
            * so a reader reads what it lands on without depending on
            * live-region semantics at all. IMP2-10 in
            * `docs/features/data-import/phase-2-review.md`.
            */}
          {run.status === 'committed' ? (
            <SaveOutcome
              className="mt-3 text-sm text-ink"
              testId="imports-committed"
              outcome="ok"
              message={fill(labels.wrote, {
                created: String(run.rows_valid),
                total: String(run.rows_total),
              })}
            />
          ) : null}
          {run.status === 'failed' ? (
            <SaveOutcome
              className="mt-3 text-sm text-ink"
              testId="imports-failed"
              outcome="error"
              message={labels.states[run.status] ?? run.status}
            />
          ) : null}
          {run.errors_total > 0 ? (
            <div className="mt-4 flex flex-wrap gap-2">
              <Button type="button" variant="secondary" onClick={() => void report()}>
                {labels.showReport}
              </Button>
              <Button
                type="button"
                variant="secondary"
                onClick={() => void download()}
                disabled={busy}
              >
                {labels.downloadReport}
              </Button>
            </div>
          ) : null}
          {run.errors_total > 0 && run.errors_cut ? (
            <p className="mt-2 text-xs text-ink-muted">{labels.reportCut}</p>
          ) : null}
          {problems === null ? null : (
            <div className="mt-4 overflow-x-auto">
              <table className="w-full text-sm">
                <thead>
                  <tr className="text-left text-xs uppercase text-ink-muted">
                    <th className="py-2 pr-4">{labels.row}</th>
                    <th className="py-2 pr-4">{labels.column}</th>
                    <th className="py-2 pr-4">{labels.problem}</th>
                    <th className="py-2">{labels.value}</th>
                  </tr>
                </thead>
                <tbody>
                  {problems.map((problem, index) => (
                    <tr
                      key={`${problem.row}-${problem.column}-${index}`}
                      className="border-t border-border"
                    >
                      <td className="py-2 pr-4 tabular-nums">{problem.row}</td>
                      <td className="py-2 pr-4">{problem.column}</td>
                      <td className="py-2 pr-4">{labels.problems[problem.code] ?? problem.code}</td>
                      <td className="py-2 text-ink-muted">{problem.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </Card>
      )}

      <Card>
        <h2 className="font-display text-lg font-semibold text-ink">{labels.historyTitle}</h2>
        {runs.length === 0 ? (
          <p className="mt-2 text-sm text-ink-muted">{labels.noRuns}</p>
        ) : (
          <div className="mt-4 overflow-x-auto">
            <table className="w-full text-sm">
              <thead>
                <tr className="text-left text-xs uppercase text-ink-muted">
                  <th className="py-2 pr-4">{labels.target}</th>
                  <th className="py-2 pr-4">{labels.state}</th>
                  <th className="py-2 pr-4">{labels.rows}</th>
                  <th className="py-2">{labels.started}</th>
                  {/* No heading: a column of controls has nothing to name that
                      the controls do not say themselves, and an empty string
                      here is read out as a blank cell rather than skipped. */}
                  <th className="py-2">
                    <span className="sr-only">{labels.open}</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {runs.map((row) => (
                  <tr key={row.id} className="border-t border-border" data-run-id={row.id}>
                    <td className="py-2 pr-4">{row.target}</td>
                    <td className="py-2 pr-4">{labels.states[row.status] ?? row.status}</td>
                    <td className="py-2 pr-4 tabular-nums">{row.rows_total}</td>
                    <td className="py-2 text-ink-muted">{row.created_at}</td>
                    <td className="py-2 text-right">
                      <Button
                        type="button"
                        variant="secondary"
                        aria-label={fill(labels.openRun, { target: row.target })}
                        aria-current={run?.id === row.id ? 'true' : undefined}
                        data-testid="imports-open"
                        onClick={() => open(row)}
                      >
                        {labels.open}
                      </Button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </Card>
    </div>
  )
}

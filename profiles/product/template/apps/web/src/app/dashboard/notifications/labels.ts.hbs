import type { Translator } from '@{{projectSlug}}/i18n'
import type { NotificationLabels } from '@{{projectSlug}}/ui'

/**
 * Every word the bell, the drawer and the centre draw, in the reader's
 * language.
 *
 * Built here rather than inside the components, because nothing in
 * `@{{projectSlug}}/ui` holds a sentence: a default string in a component is an
 * English string shipped to a German customer. The same shape the assistant's
 * labels use.
 */
export function notificationLabels(t: Translator): NotificationLabels {
  return {
    title: t('notifications.title'),
    // The template, not a finished sentence: the translator returns a message
    // unchanged when it is given no parameters, so this is the right locale's
    // "{count} unread" and the component fills in the number it already has.
    // It was a closure until 2026-09-20, which React refused to serialise into
    // the client bell -- and since the bell is in the layout, that refusal
    // broke every signed-in page.
    unread: t('notifications.unread'),
    empty: t('notifications.empty'),
    emptyHint: t('notifications.emptyHint'),
    markAllRead: t('notifications.markAllRead'),
    markRead: t('notifications.markRead'),
    dismiss: t('notifications.dismiss'),
    close: t('notifications.close'),
    viewAll: t('notifications.viewAll'),
  }
}

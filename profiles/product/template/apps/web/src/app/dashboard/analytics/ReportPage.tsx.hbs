import { isEntitled } from '@{{projectSlug}}/branding'
import {
  AccessDenied,
  Card,
  Container,
  ExportList,
  ExportMenu,
  MetricCard,
  MetricGrid,
  ReportChart,
  ReportErrorState,
  ReportFilters,
  ReportHeader,
  ReportList,
  ReportTable,
  ScheduleForm,
  ScheduleList,
  rich,
  strongTag,
} from '@{{projectSlug}}/ui'
import type { ReportResultData, ReportingLabels } from '@{{projectSlug}}/ui'
import type { ReportQuery } from '@{{projectSlug}}/api-client'
import { can, signedInContext } from '../../../lib/access'
import type { Locale, Translator } from '@{{projectSlug}}/i18n'
import { translator } from '../../../lib/locale'
import { createSchedule, removeSchedule } from './actions'
import { reportingLabels } from './labels'
import {
  loadReport,
  loadReportData,
  loadReportExports,
  loadReportSchedules,
  loadReports,
} from './reporting'
import type { Outcome } from './reporting'

/**
 * One report, beside the list of every report this caller may open.
 *
 * Shared by the landing page and the per-report route, so both render the
 * same frame: three gates answered on the server -- the permission, the
 * plan, the API's own answer -- then the list, the header, the filters,
 * the cards, the chart and the rows, each rendered from what the API said
 * and nothing computed here. A product that registers a report in its
 * extension point gets this page for it with no page of its own.
 *
 * Below the rows, for a caller who may export: the report's schedules and
 * the tenant's background exports. Both are read from the API on every
 * render, and both change only through the server actions in `actions.ts`.
 */
export const ANALYTICS_PATH = '/dashboard/analytics'

export function reportHref(key: string, query: ReportQuery = {}): string {
  const params = new URLSearchParams()
  for (const [name, value] of Object.entries(query)) params.set(name, value)
  const encoded = params.toString()
  const base = key === 'usage.overview' ? ANALYTICS_PATH : `${ANALYTICS_PATH}/${encodeURIComponent(key)}`
  return encoded === '' ? base : `${base}?${encoded}`
}

export async function ReportPage({
  reportKey,
  query,
  outcome,
  locale,
}: {
  reportKey: string
  query: ReportQuery
  /** What the last export or schedule action said, if the URL carries it. */
  outcome: Outcome
  /** Resolved by the page, once, the way every page resolves it. */
  locale: Locale
}) {
  const [context, t] = await Promise.all([signedInContext(), translator()])
  if (context === null || !can(context.access, 'reports.read')) {
    return <AccessDenied locale={locale} />
  }

  const { entitlements } = context.access
  if (entitlements.resolved && !isEntitled(entitlements, 'reporting.basic')) {
    const plan = { plan: entitlements.plan ?? t('analytics.notIncluded.notRecorded') }
    const tags = { strong: strongTag }
    return (
      <div className="py-12">
        <Container>
          <h1 className="font-display text-2xl font-bold text-ink">{t('analytics.title')}</h1>
          <Card className="mt-6 max-w-3xl">
            <h2 className="font-display text-lg font-bold text-ink">
              {t('analytics.notIncluded.title')}
            </h2>
            <p className="mt-2 text-sm leading-6 text-ink-muted">
              {rich(t('analytics.notIncluded.description', plan), tags)}
            </p>
          </Card>
        </Container>
      </div>
    )
  }

  const labels = reportingLabels(t)
  const exporter = can(context.access, 'reports.export')
  const [list, report, data, schedules, exports] = await Promise.all([
    loadReports(),
    loadReport(reportKey),
    loadReportData(reportKey, query),
    exporter ? loadReportSchedules(reportKey) : null,
    exporter ? loadReportExports() : null,
  ])
  const pagePath = reportHref(reportKey)
  const retryHref = reportHref(reportKey, query)
  const notice = noticeFor(outcome, t, labels)

  return (
    <div className="py-8 sm:py-12">
      <Container>
        {!entitlements.resolved && (
          <p className="mb-6 max-w-2xl text-sm leading-6 text-ink-muted" data-testid="analytics-unresolved">
            {t('analytics.unresolved')}
          </p>
        )}
        {notice !== null && (
          <p
            role="status"
            className="mb-6 max-w-2xl rounded-md border border-line bg-surface px-4 py-3 text-sm leading-6 text-ink"
            data-testid="analytics-notice"
          >
            {notice}
          </p>
        )}
        <div className="grid grid-cols-1 gap-8 lg:grid-cols-[14rem_minmax(0,1fr)]">
          <aside className="min-w-0">
            {list.status === 'ok' ? (
              <ReportList
                reports={list.value.reports}
                current={reportKey}
                hrefFor={(key) => reportHref(key)}
                labels={labels}
              />
            ) : (
              <p className="text-sm text-ink-muted" data-testid="report-list-unavailable">
                {list.message}
              </p>
            )}
          </aside>
          <section className="min-w-0" data-testid="report">
            {report.status !== 'ok' ? (
              <>
                <h1 className="font-display text-2xl font-bold text-ink">{t('analytics.title')}</h1>
                <div className="mt-6">
                  <ReportErrorState message={report.message} retryHref={retryHref} labels={labels} />
                </div>
              </>
            ) : (
              <>
                <ReportHeader
                  title={report.value.name}
                  description={report.value.description}
                  range={data.status === 'ok' ? data.value.range : null}
                  locale={locale}
                  notes={data.status === 'ok' ? data.value.notes : undefined}
                  actions={
                    report.value.export_formats.length > 0 ? (
                      <ExportMenu
                        hrefFor={(format, background) =>
                          exportHref(reportKey, query, format, background)
                        }
                        formats={report.value.export_formats}
                        allowed={report.value.can_export}
                        labels={labels}
                      />
                    ) : undefined
                  }
                />
                <div className="mt-6">
                  <ReportFilters
                    action={pagePath}
                    filters={report.value.filters}
                    values={query}
                    labels={labels}
                  />
                </div>
                <div className="mt-6">
                  {data.status === 'ok' ? (
                    <ReportBody data={data.value} locale={locale} labels={labels} caption={report.value.name} />
                  ) : (
                    <ReportErrorState message={data.message} retryHref={retryHref} labels={labels} />
                  )}
                </div>
                {report.value.can_export && (
                  <Card className="mt-8" data-testid="report-schedules">
                    <h2 className="font-display text-lg font-bold text-ink">{labels.schedule.heading}</h2>
                    <p className="mt-1 text-sm leading-6 text-ink-muted">{labels.schedule.intro}</p>
                    <div className="mt-4">
                      {schedules === null || schedules.status !== 'ok' ? (
                        <p className="text-sm text-ink-muted" role="status">
                          {schedules === null ? labels.schedule.empty : schedules.message}
                        </p>
                      ) : (
                        <ScheduleList
                          schedules={schedules.value.schedules}
                          locale={locale}
                          labels={labels}
                          remove={removeSchedule}
                        />
                      )}
                    </div>
                    <div className="mt-4">
                      {report.value.can_schedule ? (
                        <ScheduleForm
                          action={createSchedule}
                          reportKey={reportKey}
                          formats={report.value.export_formats}
                          hiddenFilters={nonPeriod(query)}
                          labels={labels}
                          error={outcome.schedule === 'invalid' ? t('analytics.schedule.invalid') : undefined}
                        />
                      ) : (
                        <p className="text-sm text-ink-muted" data-testid="schedule-not-included">
                          {labels.schedule.notIncluded}
                        </p>
                      )}
                    </div>
                  </Card>
                )}
                {report.value.can_export && exports !== null && (
                  <Card className="mt-8" data-testid="report-exports">
                    <h2 className="font-display text-lg font-bold text-ink">{labels.exports.heading}</h2>
                    <p className="mt-1 text-sm leading-6 text-ink-muted">{labels.exports.intro}</p>
                    <div className="mt-4">
                      {exports.status !== 'ok' ? (
                        <p className="text-sm text-ink-muted" role="status">
                          {exports.message}
                        </p>
                      ) : (
                        <ExportList
                          exports={exports.value.exports}
                          retentionDays={exports.value.retention_days}
                          locale={locale}
                          labels={labels}
                          downloadHref={(id) => `/api/reports/exports/${encodeURIComponent(id)}/download`}
                        />
                      )}
                    </div>
                  </Card>
                )}
              </>
            )}
          </section>
        </div>
      </Container>
    </div>
  )
}

function exportHref(key: string, query: ReportQuery, format: string, background: boolean): string {
  const params = new URLSearchParams()
  for (const [name, value] of Object.entries(query)) params.set(name, value)
  params.set('format', format)
  if (background) params.set('background', '1')
  return `/api/reports/${encodeURIComponent(key)}/export?${params.toString()}`
}

/** The filters a schedule keeps: everything but the period, which its cadence decides. */
function nonPeriod(query: ReportQuery): Record<string, string> {
  const kept: Record<string, string> = {}
  for (const [name, value] of Object.entries(query)) {
    if (name !== 'from' && name !== 'to' && name !== 'bucket') kept[name] = value
  }
  return kept
}

function noticeFor(outcome: Outcome, t: Translator, labels: ReportingLabels): string | null {
  if (outcome.export === 'queued') return labels.export.queued
  switch (outcome.schedule) {
    case 'created':
      return t('analytics.schedule.created')
    case 'removed':
      return t('analytics.schedule.removed')
    case 'plan':
      return t('analytics.error.plan')
    case 'forbidden':
      return t('analytics.error.forbidden')
    case 'failed':
      return t('analytics.error.generic')
    default:
      return null
  }
}

function ReportBody({
  data,
  locale,
  labels,
  caption,
}: {
  data: ReportResultData
  locale: string
  labels: ReportingLabels
  caption: string
}) {
  const timeSeries = data.series.filter((s) => s.points.some((p) => /^\d{4}-\d{2}-\d{2}$/.test(p.x)))
  const categorical = data.series.filter((s) => !timeSeries.includes(s))
  return (
    <div className="space-y-8">
      {data.metrics.length > 0 && (
        <MetricGrid testId="report-metrics">
          {data.metrics.map((metric) => (
            <MetricCard key={metric.key} metric={metric} locale={locale} labels={labels} />
          ))}
        </MetricGrid>
      )}
      {timeSeries.length > 0 && data.visualization !== 'table' && (
        <Card>
          <ReportChart
            series={timeSeries}
            kind="line"
            locale={locale}
            labels={labels}
            title={timeSeries.map((s) => s.label).join(', ')}
            testId="report-chart"
          />
        </Card>
      )}
      {categorical.map((series) => (
        <Card key={series.key}>
          <ReportChart
            series={[series]}
            kind="bar"
            locale={locale}
            labels={labels}
            title={series.label}
            testId={`report-chart-${series.key}`}
          />
        </Card>
      ))}
      {data.table !== null && (
        <Card>
          <ReportTable table={data.table} caption={caption} locale={locale} labels={labels} testId="report-table" />
        </Card>
      )}
    </div>
  )
}

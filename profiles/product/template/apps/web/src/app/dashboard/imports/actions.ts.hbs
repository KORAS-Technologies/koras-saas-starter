/**
 * The Imports page's server half.
 *
 * **Every action checks `imports.manage`, reads included.** A run names a
 * customer's own records and its mapping shows their column headings, so the
 * history is not less sensitive than the act — and the API checks the same
 * permission again with the same token, because a check in this process is a
 * check a typed URL never reaches.
 *
 * The one exception in shape, not in authority, is the upload ticket: the file
 * is uploaded through the ordinary `/files` route with the `imports` category,
 * so a source file inherits retention, legal hold, reconciliation, virus
 * scanning and the storage quota without any of that being restated here. What
 * this file adds is the permission: `files.upload` is not enough to feed an
 * import, because the import is what writes rows.
 */

export type ActionResult<T> = { status: 'ok'; value: T } | { status: 'error'; message: string }

async function session() {
  const context = await signedInContext()
  if (context === null || !can(context.access, 'imports.manage')) return null
  const token = await providerToken()
  const baseUrl = apiBaseUrl()
  if (!token || !baseUrl) return null
  return { baseUrl, token }
}

async function explain(error: unknown): Promise<string> {
  const t = await translator()
  if (error instanceof ApiError) {
    const coded = apiErrorMessage(t, error.code)
    if (coded !== null) return coded
    if (error.status === 403) return t('imports.error.forbidden')
  }
  return t('imports.error.unavailable')
}

async function denied<T>(): Promise<ActionResult<T>> {
  return { status: 'error', message: (await translator())('imports.error.forbidden') }
}

export async function listTargets(): Promise<ActionResult<ImportTargetView[]>> {
  const auth = await session()
  if (auth === null) return denied()
  try {
    return { status: 'ok', value: await fetchImportTargets(auth) }
  } catch (error) {
    return { status: 'error', message: await explain(error) }
  }
}


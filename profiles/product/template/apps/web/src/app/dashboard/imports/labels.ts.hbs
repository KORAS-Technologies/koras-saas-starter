import type { Translator } from '@{{projectSlug}}/i18n'

/**
 * Every sentence the import panel renders, resolved on the server.
 *
 * The panel is a client component, so it cannot hold a translator: the
 * catalogue would be in the browser bundle and the request's language would
 * not be. Built here instead, from the same translator the page already has,
 * and passed down as plain strings — the arrangement the Restore and Files
 * panels use for the same reason.
 *
 * Several of these are maps rather than strings. A run's state, a row error's
 * code and a template format all arrive from the API as stable identifiers,
 * and mapping them here means a state the catalogue has no sentence for falls
 * back to the identifier rather than rendering nothing. That fallback is
 * deliberate: a new state should look untranslated, not invisible.
 *
 * Sentences with a value in them cross the boundary as templates and are
 * filled on the client, because a function cannot -- `withValue` in the
 * settings form and `withCount` in the bell are the same rule.
 */
export interface ImportLabels {
  startTitle: string
  startDescription: string
  target: string
  operation: string
  operationHint: string
  file: string
  ceiling: string
  /** `{size}`, `{rows}` and `{formats}`. */
  limits: string
  /** `{name}` and `{size}`. */
  chosenFile: string
  format: string
  template: {
    download: string
    hint: string
    formatRefused: string
    /** Keyed by format: `xlsx`, `csv`. */
    formats: Record<string, string>
    compatible: string
    /** `{columns}`. */
    unknownColumns: string
    /** `{fields}`. */
    incompatible: string
    /** `{found}` and `{current}`. */
    stale: string
  }
  /** `{sheet}`. */
  sheet: string
  mapTitle: string
  mapDescription: string
  mapColumn: string
  column: string
  sample: string
  field: string
  ignore: string
  check: string
  checking: string
  discard: string
  tooManyRows: string
  replaced: string
  resultTitle: string
  summary: string
  wroteNothing: string
  confirm: string
  confirmHint: string
  committing: string
  notCommittable: string
  wrote: string
  preview: {
    total: string
    valid: string
    invalid: string
    duplicate: string
    create: string
    update: string
    skip: string
    unknown: string
  }
  result: {
    title: string
    total: string
    created: string
    updated: string
    skipped: string
    failed: string
  }
  consequence: string
  consequenceInvalid: string
  showReport: string
  downloadReport: string
  reportCut: string
  row: string
  problem: string
  value: string
  historyTitle: string
  /** The control on each history row. */
  open: string
  /** Its accessible name. A template: every row would otherwise be a
   *  button called "Open", which is a list of identical names to anybody
   *  reading them out of context. Filled on the client, because a
   *  function cannot cross the server boundary. */
  openRun: string
  noRuns: string
  noTargets: string
  state: string
  rows: string
  started: string
  operations: Record<string, string>
  states: Record<string, string>
  problems: Record<string, string>
}

export function importLabels(t: Translator): ImportLabels {
  const operations: Record<string, string> = {
    create: t('imports.op.create'),
    update: t('imports.op.update'),
    upsert: t('imports.op.upsert'),
    skip_duplicate: t('imports.op.skipDuplicate'),
  }
  // Every member of `koras_import.RunState`, including the four Phase 2 only
  // reaches. They are translated now rather than when the commit ships,
  // because the state machine already has them and a run that somehow arrives
  // in one should not render a bare identifier.
  const states: Record<string, string> = {
    created: t('imports.state.created'),
    mapped: t('imports.state.mapped'),
    validating: t('imports.state.validating'),
    validated: t('imports.state.validated'),
    validation_failed: t('imports.state.validationFailed'),
    commit_requested: t('imports.state.commitRequested'),
    committing: t('imports.state.committing'),
    committed: t('imports.state.committed'),
    failed: t('imports.state.failed'),
    cancelled: t('imports.state.cancelled'),
  }
  // Keyed by the exact codes `koras_import.mapping` and `koras_import.matching`
  // raise. A code with no sentence falls back to the identifier in the panel,
  // which is what makes a new rule look untranslated rather than invisible.
  const problems: Record<string, string> = {
    'import.error.required': t('imports.problem.required'),
    'import.error.too_long': t('imports.problem.tooLong'),
    'import.error.not_an_option': t('imports.problem.notAnOption'),
    'import.error.integer': t('imports.problem.integer'),
    'import.error.decimal': t('imports.problem.decimal'),
    'import.error.ambiguous_decimal': t('imports.problem.ambiguousDecimal'),
    'import.error.boolean': t('imports.problem.boolean'),
    'import.error.date': t('imports.problem.date'),
    'import.error.email': t('imports.problem.email'),
    'import.error.extra_cells': t('imports.problem.extraCells'),
    'import.error.duplicate_in_file': t('imports.problem.duplicateInFile'),
    'import.error.already_exists': t('imports.problem.alreadyExists'),
  }
  return {
    startTitle: t('imports.startTitle'),
    startDescription: t('imports.startDescription'),
    target: t('imports.target'),
    operation: t('imports.operation'),
    operationHint: t('imports.operationHint'),
    file: t('imports.file'),
    ceiling: t('imports.ceiling'),
    limits: t('imports.limits'),
    chosenFile: t('imports.chosenFile'),
    format: t('imports.format'),
    template: {
      download: t('imports.template.download'),
      hint: t('imports.template.hint'),
      formatRefused: t('imports.template.formatRefused'),
      formats: {
        xlsx: t('imports.template.xlsx'),
        csv: t('imports.template.csv'),
      },
      compatible: t('imports.template.compatible'),
      unknownColumns: t('imports.template.unknownColumns'),
      incompatible: t('imports.template.incompatible'),
      stale: t('imports.template.stale'),
    },
    sheet: t('imports.sheet'),
    mapTitle: t('imports.mapTitle'),
    mapDescription: t('imports.mapDescription'),
    mapColumn: t('imports.mapColumn'),
    column: t('imports.column'),
    sample: t('imports.sample'),
    field: t('imports.field'),
    ignore: t('imports.ignore'),
    check: t('imports.check'),
    checking: t('imports.checking'),
    discard: t('imports.discard'),
    tooManyRows: t('imports.tooManyRows'),
    replaced: t('imports.replaced'),
    resultTitle: t('imports.resultTitle'),
    summary: t('imports.summary'),
    wroteNothing: t('imports.wroteNothing'),
    confirm: t('imports.confirm'),
    // The product's own name, filled here rather than in the panel: the panel
    // is a client component and the name is a server-side setting.
    confirmHint: t('imports.confirmHint').replace('{product}', '{{projectName}}'),
    committing: t('imports.committing'),
    notCommittable: t('imports.notCommittable'),
    wrote: t('imports.wrote'),
    preview: {
      total: t('imports.preview.total'),
      valid: t('imports.preview.valid'),
      invalid: t('imports.preview.invalid'),
      duplicate: t('imports.preview.duplicate'),
      create: t('imports.preview.create'),
      update: t('imports.preview.update'),
      skip: t('imports.preview.skip'),
      unknown: t('imports.preview.unknown'),
    },
    result: {
      title: t('imports.result.title'),
      total: t('imports.result.total'),
      created: t('imports.result.created'),
      updated: t('imports.result.updated'),
      skipped: t('imports.result.skipped'),
      failed: t('imports.result.failed'),
    },
    consequence: t('imports.consequence'),
    consequenceInvalid: t('imports.consequence.invalid'),
    showReport: t('imports.showReport'),
    downloadReport: t('imports.downloadReport'),
    reportCut: t('imports.reportCut'),
    row: t('imports.row'),
    problem: t('imports.problem'),
    value: t('imports.value'),
    historyTitle: t('imports.historyTitle'),
    open: t('imports.open'),
    openRun: t('imports.openRun'),
    noRuns: t('imports.noRuns'),
    noTargets: t('imports.noTargets'),
    state: t('imports.state'),
    rows: t('imports.rows'),
    started: t('imports.started'),
    operations,
    states,
    problems,
  }
}

import type { Translator } from '@{{projectSlug}}/i18n'
import type { DataTableLabels } from '@{{projectSlug}}/ui'

/**
 * Every string the shared table renders, in the caller's language.
 *
 * Built on the server from the request's translator and handed down as plain
 * data, the way the reporting and assistant labels are. The component knows
 * nothing of the catalogue, which is what lets it live in `packages/ui` without
 * pulling every language into the bundle of anything that imports it.
 *
 * `showing`, `page`, `moveColumnLeft` and `moveColumnRight` are templates
 * rather than pre-filled strings, because their numbers and column names
 * change as somebody pages or reorders and a label bundle is built once per
 * request. They must also be strings rather than functions: `KorasDataTable`
 * is a Client Component and this function runs on the server, and a function
 * cannot cross that boundary as a prop. Calling the translator with no params
 * leaves each `{placeholder}` in the returned string, which is what
 * `KorasDataTable` fills in once it knows the numbers.
 */
export function dataTableLabels(t: Translator): DataTableLabels {
  return {
    pagination: t('grid.pagination'),
    rowsPerPage: t('grid.rowsPerPage'),
    previous: t('grid.previous'),
    next: t('grid.next'),
    showing: t('grid.showing'),
    page: t('grid.page'),
    moveColumnLeft: t('grid.moveColumnLeft'),
    moveColumnRight: t('grid.moveColumnRight'),
  }
}

import type { SettingDefinitionResponse } from '@{{projectSlug}}/api-client'
import type { Translator } from '@{{projectSlug}}/i18n'
import {
  isHeldHere,
  valuesForCategory,
  type HeldMeans,
  type SettingField,
  type SettingGroup,
} from '@{{projectSlug}}/ui'

/**
 * Turning the published catalogue into something a settings page can render.
 *
 * Two jobs, both server-side, and both here rather than in the component for
 * the same reason: a definition carries i18n *keys* and the component must not
 * carry a catalogue. The words are resolved once, with the request's
 * translator, and handed down as data.
 *
 * The other job is the reverse — reading a submitted form back into the values
 * the API takes. That has to be driven by the same definitions the form was
 * drawn from, or a checkbox becomes the string "on" and a list becomes one long
 * string with commas in it.
 */

/** The seven the two pages lay their settings out in, in the order shown. */
const CATEGORY_ORDER = [
  'general',
  'appearance',
  'grid',
  'notifications',
  'files',
  'reporting',
  'accessibility',
] as const

type Values = Record<string, unknown>

/**
 * The groups one scope's page renders.
 *
 * `values` is what this scope holds — the presence of a key is what makes a
 * field "changed here" — and `inherited` is what applies when it holds nothing.
 * Neither page passes the *effective* settings: an administrator editing the
 * organisation needs to see what the organisation holds, not what their own
 * override does to it, or they change a value, see no difference, and change it
 * again.
 */
export function settingGroups({
  definitions,
  values,
  inherited,
  t,
  visible,
  heldMeans = 'a-row-exists',
}: {
  definitions: SettingDefinitionResponse[]
  values: Values
  inherited: Values
  t: Translator
  /** Which half of the catalogue this page shows. */
  visible: (definition: SettingDefinitionResponse) => boolean
  /**
   * What "this scope has chosen a value" means on this page. **SET-06.**
   *
   * At member scope it is `a-row-exists`, and that is exactly right: a
   * member row is written only when a person chooses one, so its presence
   * *is* the choice. Deriving it by comparison there would be wrong the
   * moment somebody deliberately picks the value their organisation already
   * has -- the caveat `SettingField.isSet` has carried since it was written.
   *
   * At organisation scope a row exists for **every** organisation-scoped key
   * from the moment the tenant is provisioned, because the snapshot copies
   * the whole catalogue in. So `a-row-exists` is true of everything, every
   * field reads as modified, none ever reads as inherited, and the marker
   * carries no information at all. `differs-from-inherited` is the only
   * signal left on that page.
   *
   * Its own caveat is real and strictly smaller, and it has two halves. The
   * Reset button disappears, which costs nothing: an organisation reset is a
   * *copy* of the platform's current value, and the two are equal by
   * construction, so the button would have written what was already there.
   * The marker also flips, which costs a little more — a value the
   * organisation deliberately chose reads as inherited, and an organisation's
   * value is a pinned snapshot that never tracks the platform, so the label
   * becomes wrong the moment the platform moves. Against a marker that was
   * previously wrong for *every* field on the page, that is the better trade;
   * it is not a free one.
   */
  heldMeans?: HeldMeans
}): SettingGroup[] {
  const groups: SettingGroup[] = []

  for (const category of CATEGORY_ORDER) {
    const fields = definitions
      .filter((definition) => definition.category === category && visible(definition))
      .map((definition) => toField(definition, values, inherited, t, heldMeans))

    // A category with nothing in it is left out rather than rendered empty.
    // My preferences shows fewer settings than the organisation's page, and an
    // empty "Files" heading would read as something failing to load.
    if (fields.length > 0) {
      groups.push({
        category,
        title: t(`settings.category.${category}` as never),
        fields,
      })
    }
  }

  return groups
}

function toField(
  definition: SettingDefinitionResponse,
  values: Values,
  inherited: Values,
  t: Translator,
  heldMeans: HeldMeans,
): SettingField {
  const hasRow = Object.hasOwn(values, definition.key)
  const fallback = inherited[definition.key] ?? definition.default
  const value = hasRow ? values[definition.key] : fallback
  const isSet = isHeldHere(hasRow, values[definition.key], fallback, heldMeans)

  return {
    key: definition.key,
    label: t(definition.label_key as never),
    description: t(definition.description_key as never),
    dataType: definition.data_type as SettingField['dataType'],
    ui: definition.ui as SettingField['ui'],
    options: definition.options.map((option) => ({
      value: option,
      // Options are translated by value rather than per setting: `compact`
      // means the same thing wherever it appears. A value with no entry --
      // a currency code, a page size -- shows as itself, which is what people
      // recognise.
      label: optionText(option, t),
    })),
    minimum: definition.minimum,
    maximum: definition.maximum,
    value: value as SettingField['value'],
    isSet,
    inherited: fallback as SettingField['inherited'],
  }
}

function optionText(option: string, t: Translator): string {
  const key = `settings.option.${option}`
  const text = t(key as never)
  // `createTranslator` answers with the key when it has no sentence for it,
  // which is exactly the signal wanted here: show the raw value instead.
  return text === key ? option : text
}

/**
 * One category's submitted values, typed the way the definitions say, and
 * only the ones somebody changed.
 *
 * The deciding is `valuesForCategory` in `@{{projectSlug}}/ui`, which is plain
 * TypeScript with no generated import and is therefore the half this
 * repository can actually execute — see `product-settings-logic.test.ts`. This
 * wrapper exists to hold the generated definition type and nothing else.
 */
export function valuesFromForm(
  definitions: SettingDefinitionResponse[],
  category: string,
  form: FormData,
  visible: (definition: SettingDefinitionResponse) => boolean,
): Values {
  return valuesForCategory(definitions, category, form, visible)
}

import { productConfig } from '@{{projectSlug}}/branding'
import { translator } from '../../lib/locale'

/**
 * The sign-in page.
 *
 * A KORAS page with a KORAS button. The button starts an OAuth redirect through
 * ZITADEL and the browser lands back here; staff never see a ZITADEL-hosted
 * screen, which invariant 4 requires of customers and which there is no reason
 * to relax for staff.
 *
 * Every word is read from the catalogue in the visitor's language. The
 * product's name is the one thing that is not.
 */
export default async function LoginPage({
  searchParams,
}: {
  searchParams: Promise<{ next?: string }>
}) {
  const [{ next }, t] = await Promise.all([searchParams, translator()])
  // The link points at a route handler rather than straight at ZITADEL: the
  // flow needs to store a CSRF token and a PKCE verifier first, and only a
  // handler can set cookies.
  const href = `/api/auth/start?next=${encodeURIComponent(next ?? '/')}`
  const params = { product: productConfig.product.name }

  return (
    <main id="main-content" className="mx-auto flex w-full max-w-md flex-1 flex-col justify-center px-6 py-16">
      <h1 className="font-display text-2xl font-bold tracking-tight text-ink">
        {t('admin.title', params)}
      </h1>
      <p className="mt-3 leading-7 text-ink-muted">{t('admin.login.audience')}</p>
      <a
        className="mt-8 inline-flex h-11 items-center justify-center rounded-brand bg-brand px-5 font-semibold text-white"
        href={href}
        data-testid="sign-in"
      >
        {t('common.signIn')}
      </a>
    </main>
  )
}

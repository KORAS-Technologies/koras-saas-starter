import {
  CtaSection,
  FeatureGrid,
  HeroSection,
  HowItWorks,
  OutcomeSection,
  ProductPreview,
  PublicFooter,
  PublicHeader,
  TrustSection,
  ValueStrip,
} from '@{{projectSlug}}/ui'
import { currentLocale } from '../lib/locale'

/**
 * The marketing homepage.
 *
 * The same sections, from the same package, driven by the same configuration as
 * the public homepage in `apps/web`. Two applications, one page -- because a
 * product that says one thing on its marketing site and another on its front
 * door has two things to keep in step, and will not.
 *
 * The difference is what it can know. There is no session here, so the header
 * always offers sign-in; `apps/web` reads its cookie and offers the dashboard
 * instead to somebody already signed in.
 *
 * Rendered per request since the page learned to speak more than one language:
 * the locale comes from a cookie and a header, and neither is a property of the
 * build. `docs/FOLLOW_UPS.md` records the locale-in-the-URL variant that would
 * make this a cached document again.
 */
export default async function MarketingPage() {
  const locale = await currentLocale()

  return (
    <>
      <PublicHeader locale={locale} />
      <main id="main-content" className="flex-1">
        <HeroSection locale={locale} />
        <ValueStrip locale={locale} />
        <FeatureGrid locale={locale} />
        <OutcomeSection locale={locale} />
        <HowItWorks locale={locale} />
        <ProductPreview locale={locale} />
        <TrustSection locale={locale} />
        <CtaSection locale={locale} />
      </main>
      <PublicFooter locale={locale} />
    </>
  )
}

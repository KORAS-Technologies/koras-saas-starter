import { notFound } from 'next/navigation'
import {
  CtaSection,
  FeatureGrid,
  HeroSection,
  HowItWorks,
  OutcomeSection,
  PricingSection,
  ProductPreview,
  PublicFooter,
  PublicHeader,
  TrustSection,
  ValueStrip,
} from '@{{projectSlug}}/ui'
import { localeFromSegment } from '../../lib/locale'
import { loadPublicPlans } from '../../lib/plans'

/**
 * The marketing homepage, in one language.
 *
 * The same sections, from the same package, driven by the same configuration as
 * the public homepage in `apps/web`. Two applications, one page -- because a
 * product that says one thing on its marketing site and another on its front
 * door has two things to keep in step, and will not.
 *
 * The difference is what it can know. There is no session here, so the header
 * always offers sign-in; `apps/web` reads its cookie and offers the dashboard
 * instead to somebody already signed in.
 *
 * A cached document again. The language is the `[locale]` segment rather
 * than a cookie, so nothing here reads the request, and the page is built
 * once per offered language. The plans are the one thing that can change
 * underneath it, and `loadPublicPlans` revalidates them on a schedule rather
 * than on every request -- a price is not something that has to be fresh to
 * the second, and a page that asks the platform on every visit was the cost
 * FOLLOW_UPS F20 recorded.
 */
export default async function MarketingPage({ params }: { params: Promise<{ locale: string }> }) {
  const locale = localeFromSegment((await params).locale)
  if (locale === null) notFound()

  // The plans are the platform's, read on the server when the page is built
  // and revalidated on a schedule, and the prices arrive with them -- the
  // platform reads those from the provider. Neither is typed into this
  // repository.
  const plans = await loadPublicPlans()

  return (
    <>
      <PublicHeader locale={locale} />
      <main id="main-content" className="flex-1">
        <HeroSection locale={locale} />
        <ValueStrip locale={locale} />
        <FeatureGrid locale={locale} />
        <OutcomeSection locale={locale} />
        <HowItWorks locale={locale} />
        <ProductPreview locale={locale} />
        <PricingSection
          locale={locale}
          plans={plans}
        />
        <TrustSection locale={locale} />
        <CtaSection locale={locale} />
      </main>
      <PublicFooter locale={locale} />
    </>
  )
}

import { expect, test } from '@playwright/test'
import { signInAs } from './support/session'

/**
 * The governance page, in a browser without an API.
 *
 * The suite runs against `next start` with a session secret and no API, so
 * every read fails. That is the state worth proving: the page renders its
 * frame and says plainly that nothing answered, rather than showing an empty
 * card that reads as "you have no holds" -- which, on this page of all pages,
 * is the worst possible lie. "Nothing is being kept for the matter" and "we
 * could not find out" are different sentences.
 *
 * The two-person rule and the manager requirement are proved by the API's own
 * tests. What a browser can prove without a database is that the surface is
 * reachable, operable by keyboard, honest when the thing behind it is silent,
 * and usable at a phone width.
 */

test('the page renders its frame and says when nothing answers', async ({ page, context }) => {
  await signInAs(context)
  await page.goto('/dashboard/governance')

  await expect(page.getByRole('heading', { level: 1 })).toHaveText('Governance')
  await expect(page.getByTestId('governance')).toBeVisible()

  // Scoped by test id: the shell carries its own live region, and an unscoped
  // alert query would assert on whichever rendered first.
  await expect(page.getByTestId('governance-error')).toBeVisible()
  await expect(page.locator('#main-content')).toHaveCount(1)
})

test('an empty list is a sentence, not a blank card', async ({ page, context }) => {
  await signInAs(context)
  await page.goto('/dashboard/governance')

  await expect(page.getByRole('heading', { name: 'Legal holds' })).toBeVisible()
  await expect(page.getByText('No hold has been asked for.')).toBeVisible()
})

test('asking for a hold needs a reason', async ({ page, context }) => {
  await signInAs(context)
  await page.goto('/dashboard/governance')

  // The submit is disabled until a reason is typed. A hold with no stated
  // matter is one nobody can review later, so the form will not send one --
  // and the API refuses it as well.
  const submit = page.getByTestId('governance-ask').getByRole('button', { name: 'Ask for a hold' })
  await expect(submit).toBeDisabled()

  await page.getByLabel('Why this hold is needed').fill('Regulatory request 2026-114')
  await expect(submit).toBeEnabled()
})

test('nothing on the page can approve or lift by itself', async ({ page, context }) => {
  await signInAs(context)
  await page.goto('/dashboard/governance')

  // The safety property of this surface, asserted from the outside: with no
  // holds there is nothing to approve and nothing to lift.
  await expect(page.getByRole('button', { name: 'Approve' })).toHaveCount(0)
  await expect(page.getByRole('button', { name: 'Lift this hold' })).toHaveCount(0)
})

test('it is usable at a phone width', async ({ page, context }) => {
  await signInAs(context)
  await page.setViewportSize({ width: 375, height: 800 })
  await page.goto('/dashboard/governance')

  await expect(page.getByRole('heading', { level: 1 })).toBeVisible()
  await expect(page.getByTestId('governance')).toBeVisible()

  const overflows = await page.evaluate(
    () => document.documentElement.scrollWidth > document.documentElement.clientWidth + 1,
  )
  expect(overflows).toBe(false)
})

# KORAS local development environment variables.
# Copy this to .env.local and populate values.
# NEVER commit .env.local — it is in .gitignore.
# In production all secrets come from Doppler.

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://app.localhost
NEXT_PUBLIC_API_URL=https://api.localhost

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:{{ports.supabaseDb}}/postgres

# ── ZITADEL ──────────────────────────────────────────────────────────────────
ZITADEL_DOMAIN=http://localhost:{{ports.zitadel}}
ZITADEL_PROJECT_ID=<from-zitadel-console>
ZITADEL_CLIENT_ID=<from-zitadel-console>
ZITADEL_CLIENT_SECRET=<from-zitadel-console>
ZITADEL_REDIRECT_URI=https://app.localhost/api/auth/callback
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:{{ports.redis}}

# ── Mail ──────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT={{ports.mailSmtp}}
SMTP_SECURE=false
SMTP_FROM=noreply@koras.local

# ── Storage (MinIO) ───────────────────────────────────────────────────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniominio
STORAGE_ENDPOINT=http://localhost:{{ports.minioApi}}
STORAGE_BUCKET=local-dev

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=koras-local

# ── AI Gateway (product profile — opt-in) ────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LITELLM_MASTER_KEY=sk-local-dev
AI_GATEWAY_URL=http://localhost:4000

# ── Control Plane client (product profile) ───────────────────────────────────
CONTROL_PLANE_URL=http://localhost:8001
CONTROL_PLANE_API_KEY=

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

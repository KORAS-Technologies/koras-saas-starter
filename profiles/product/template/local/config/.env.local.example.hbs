# {{projectName}} — local development environment.
#
# Copy to .env.local and populate. NEVER commit .env.local; it is gitignored.
# In every deployed environment these values come from Doppler, not from a file.
#
# `make bootstrap` writes .env.local from this template and substitutes the host
# ports that local/scripts/ports.sh actually resolved. Ports are a machine-global
# resource, so the values below are only the preferences: if another stack
# already holds one, ports.sh walks to the next free port and bootstrap rewrites
# the URLs here to match. Do not assume the numbers below are what is running.

# ── Environment ──────────────────────────────────────────────────────────────
# One of: dev, test, stg, prod. Required, and deliberately has no default in
# code -- services/api/koras_api/core/settings.py declares it with no fallback, so a
# missing or misspelled value must fail at startup rather than silently
# selecting an estate. Absent here, `make bootstrap && make dev` could not start
# the API at all. Local development is always `dev`.
ENVIRONMENT=dev

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://app.localhost
NEXT_PUBLIC_API_URL=https://api.localhost

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:{{ports.supabaseDb}}/postgres

# ── ZITADEL ──────────────────────────────────────────────────────────────────
ZITADEL_DOMAIN=http://localhost:{{ports.zitadel}}
ZITADEL_PROJECT_ID=<from-zitadel-console>
ZITADEL_CLIENT_ID=<from-zitadel-console>
ZITADEL_CLIENT_SECRET=<from-zitadel-console>
ZITADEL_REDIRECT_URI=https://app.localhost/api/auth/callback
# One per application: a redirect URI names a single hostname, so the internal
# operations app cannot share the customer application's.
ZITADEL_ADMIN_REDIRECT_URI=https://admin.localhost/api/auth/callback

# Signs this application's own session cookie.
#
# Not the provider's secret. The ID token is verified once at sign-in and never
# again, so middleware needs no network call -- which matters because the edge
# runtime cannot always reach the identity provider that the Node runtime can.
# At least 32 characters, and different in every environment: one shared key
# makes a development cookie a production cookie.
#   openssl rand -base64 48
SESSION_SECRET=<generate-one-per-environment>
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:{{ports.redis}}

# ── Mail ──────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT={{ports.mailSmtp}}
SMTP_SECURE=false
SMTP_FROM=noreply@koras.local

# ── Storage (MinIO) ───────────────────────────────────────────────────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniominio
STORAGE_ENDPOINT=http://localhost:{{ports.minioApi}}
STORAGE_BUCKET=local-dev

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origins allowed to read an API response, as a JSON array. Built from the
# application URLs rather than by hand: an application moved to a new hostname
# and a CORS list still naming the old one is an outage that reads as an
# authentication bug.
CORS_ORIGINS=["https://app.localhost","https://admin.localhost"]

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Only a hosted collector needs this. The local one takes no credential.
OTEL_EXPORTER_OTLP_HEADERS=
# grpc locally; http/protobuf for a managed collector.
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=koras-local

{{#if service.ai_gateway}}# ── AI Gateway ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LITELLM_MASTER_KEY=sk-local-dev
AI_GATEWAY_URL=http://localhost:4000

{{/if}}
# ── Control Plane ─────────────────────────────────────────────────────────────
KORAS_CONTROL_PLANE_URL=http://localhost:8001
KORAS_CONTROL_PLANE_TOKEN=
# The platform's ZITADEL project id, asked for as an extra token audience at
# sign-in so this product can read a customer's own plan as that customer.
KORAS_CONTROL_PLANE_PROJECT_ID=

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

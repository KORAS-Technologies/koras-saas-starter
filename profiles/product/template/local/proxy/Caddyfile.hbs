# Local development reverse proxy for {{projectName}} ({{profile}} profile).
#
# Only the applications selected at generation time get a host block — Caddy
# fails to start if it is told to load a certificate that was never generated.
# TLS certificates come from local/certs/generate.sh (run by `make bootstrap`)
# and are mounted read-only at /certs.
#
# Upstreams use host.docker.internal because the apps and API run on the host
# via `pnpm turbo run dev`, not inside this network.

{
	local_certs
	auto_https off
}

{{#if apps.web}}
app.localhost {
	tls /certs/app.localhost.pem /certs/app.localhost-key.pem
	reverse_proxy host.docker.internal:{env.KORAS_PORT_APP_WEB}
}
{{/if}}
{{#if apps.admin}}
admin.localhost {
	tls /certs/admin.localhost.pem /certs/admin.localhost-key.pem
	reverse_proxy host.docker.internal:{env.KORAS_PORT_APP_ADMIN}
}
{{/if}}
{{#if apps.marketing}}
www.localhost {
	tls /certs/www.localhost.pem /certs/www.localhost-key.pem
	reverse_proxy host.docker.internal:{env.KORAS_PORT_APP_MARKETING}
}
{{/if}}
{{#if service.api}}
api.localhost {
	tls /certs/api.localhost.pem /certs/api.localhost-key.pem
	reverse_proxy host.docker.internal:{env.KORAS_PORT_SERVICE_API}
}
{{/if}}
{{#if service.ai_gateway}}
ai.localhost {
	tls /certs/ai.localhost.pem /certs/ai.localhost-key.pem
	reverse_proxy host.docker.internal:{env.KORAS_PORT_SERVICE_AI_GATEWAY}
}
{{/if}}

# ZITADEL runs inside this network, so it is reached by service name.
auth.localhost {
	tls /certs/auth.localhost.pem /certs/auth.localhost-key.pem
	reverse_proxy zitadel:8080
}

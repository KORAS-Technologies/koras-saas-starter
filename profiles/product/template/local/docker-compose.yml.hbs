# Host ports come from local/.env, written by local/scripts/ports.sh so that a
# busy port on one machine does not wedge the whole stack. The `\{{!}}` after each
# preference is an empty Handlebars comment: without it the template's `}}` and
# the shell's closing `}` would collide into `}}}`, which Handlebars misreads as
# a triple-stash. It renders nothing.
name: {{projectSlug}}

services:
  # ── Database (Supabase local) ───────────────────────────────────────────────
  supabase-db:
    image: supabase/postgres:15.6.1.143
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: postgres
    ports:
      - "127.0.0.1:${KORAS_PORT_SUPABASE_DB:-{{ports.supabaseDb}}{{!}}}:5432"
    volumes:
      - supabase-db:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "postgres"]
      interval: 5s
      timeout: 5s
      retries: 10

  # ── ZITADEL (identity provider) ────────────────────────────────────────────
  # Started by local/scripts/stack.mjs (`make dev`, `pnpm stack:up`), never by a
  # bare `docker compose up`: the masterkey is a file stack.mjs names after
  # verifying it, and the guards below fail closed without it. ADR 0015.
  #
  # `start`, never `start-from-init`: this file can start an instance and can
  # never create one. Creating one is `stack.mjs provision --fresh`, through
  # local/docker-compose.init.yml. Every ZITADEL_FIRSTINSTANCE_* setting lives
  # there, because it applies only when an instance is created.
  zitadel:
    image: ghcr.io/zitadel/zitadel:v4.17.1
    restart: unless-stopped
    # Never root. On Linux stack.mjs supplies the host user, so the owner-only
    # key file and the token directories are readable and writable without
    # widening either; elsewhere the image's own non-root user. ADR 0015.
    user: "${KORAS_ZITADEL_USER:?start the stack through local/scripts/stack.mjs}"
    command: start --masterkeyFile /run/secrets/zitadel_masterkey --tlsMode disabled
    secrets:
      - zitadel_masterkey
    environment:
      ZITADEL_DATABASE_POSTGRES_HOST: supabase-db
      ZITADEL_DATABASE_POSTGRES_PORT: 5432
      ZITADEL_DATABASE_POSTGRES_DATABASE: zitadel
      ZITADEL_DATABASE_POSTGRES_USER_USERNAME: postgres
      ZITADEL_DATABASE_POSTGRES_USER_PASSWORD: postgres
      ZITADEL_DATABASE_POSTGRES_USER_SSL_MODE: disable
      ZITADEL_DATABASE_POSTGRES_ADMIN_USERNAME: postgres
      ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD: postgres
      ZITADEL_DATABASE_POSTGRES_ADMIN_SSL_MODE: disable
      ZITADEL_EXTERNALSECURE: "false"
      ZITADEL_EXTERNALPORT: ${KORAS_PORT_ZITADEL:-{{ports.zitadel}}{{!}}}
      ZITADEL_EXTERNALDOMAIN: localhost
      ZITADEL_TLS_ENABLED: "false"
      # Login v2 (ADR 0016), verified against v4.17.1's defaults.yaml. The
      # login runs on its own port, so every login URL is absolute: the
      # defaults are relative and work only when both share one origin.
      # LOGINV2_* applies to instances created from now on; an existing
      # instance's feature flags are never written.
      ZITADEL_DEFAULTINSTANCE_FEATURES_LOGINV2_REQUIRED: "true"
      ZITADEL_DEFAULTINSTANCE_FEATURES_LOGINV2_BASEURI: http://localhost:${KORAS_PORT_ZITADEL_LOGIN:-{{ports.zitadelLogin}}{{!}}}/ui/v2/login/
      ZITADEL_OIDC_DEFAULTLOGINURLV2: http://localhost:${KORAS_PORT_ZITADEL_LOGIN:-{{ports.zitadelLogin}}{{!}}}/ui/v2/login/login?authRequest=
      ZITADEL_OIDC_DEFAULTLOGOUTURLV2: http://localhost:${KORAS_PORT_ZITADEL_LOGIN:-{{ports.zitadelLogin}}{{!}}}/ui/v2/login/logout?post_logout_redirect=
      ZITADEL_SAML_DEFAULTLOGINURLV2: http://localhost:${KORAS_PORT_ZITADEL_LOGIN:-{{ports.zitadelLogin}}{{!}}}/ui/v2/login/login?samlRequest=
    ports:
      # Loopback only: an identity provider for one developer's machine.
      - "127.0.0.1:${KORAS_PORT_ZITADEL:-{{ports.zitadel}}{{!}}}:8080"
    volumes:
      # Where ZITADEL writes the machine user's and the login client's access
      # tokens at first start. Gitignored; real credentials for this instance.
      # stack.mjs creates both directories first, so they belong to the host
      # user rather than to whichever user Docker would create them as.
      - ./zitadel/machinekey:/machinekey
      - ./zitadel/bootstrap:/zitadel/bootstrap
    healthcheck:
      test: ["CMD", "/app/zitadel", "ready"]
      interval: 10s
      timeout: 30s
      retries: 12
      start_period: 20s
    depends_on:
      supabase-db:
        condition: service_healthy

  # The hosted login (v2). ZITADEL resolves an instance from the Host header,
  # and this container reaches the API as http://zitadel:8080 -- a host that
  # matches no instance -- so CUSTOM_REQUEST_HEADERS names the public one. On
  # v4.17.1 a browser sign-in forwards its own host and works without it. CI
  # case T-I13 asserts that this header, and only it, makes zitadel:8080
  # resolve the instance (ADR 0016).
  zitadel-login:
    image: ghcr.io/zitadel/zitadel-login:v4.17.1
    restart: unless-stopped
    user: "${KORAS_ZITADEL_LOGIN_USER:?start the stack through local/scripts/stack.mjs}"
    environment:
      ZITADEL_API_URL: http://zitadel:8080
      NEXT_PUBLIC_BASE_PATH: /ui/v2/login
      ZITADEL_SERVICE_USER_TOKEN_FILE: /zitadel/bootstrap/login-client.pat
      CUSTOM_REQUEST_HEADERS: Host:localhost,X-Forwarded-Proto:http
    ports:
      - "127.0.0.1:${KORAS_PORT_ZITADEL_LOGIN:-{{ports.zitadelLogin}}{{!}}}:3000"
    volumes:
      - ./zitadel/bootstrap:/zitadel/bootstrap:ro
    healthcheck:
      test: ["CMD", "/bin/sh", "-c", "node /app/healthcheck.mjs http://localhost:3000/ui/v2/login/healthy"]
      interval: 10s
      timeout: 30s
      retries: 12
      start_period: 20s
    depends_on:
      zitadel:
        condition: service_healthy

  # ── Redis (queue + cache) ───────────────────────────────────────────────────
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    ports:
      - "127.0.0.1:${KORAS_PORT_REDIS:-{{ports.redis}}{{!}}}:6379"
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5

  # ── Mail (Mailpit) ──────────────────────────────────────────────────────────
  mail:
    image: axllent/mailpit:latest
    restart: unless-stopped
    ports:
      - "127.0.0.1:${KORAS_PORT_MAIL_SMTP:-{{ports.mailSmtp}}{{!}}}:1025"   # SMTP
      - "127.0.0.1:${KORAS_PORT_MAIL_UI:-{{ports.mailUi}}{{!}}}:8025"   # Web UI
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:8025/"]
      interval: 10s
      timeout: 5s
      retries: 5

  # ── Storage (MinIO) ─────────────────────────────────────────────────────────
  storage:
    image: minio/minio:latest
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: minio
      MINIO_ROOT_PASSWORD: miniominio
    ports:
      - "127.0.0.1:${KORAS_PORT_MINIO_API:-{{ports.minioApi}}{{!}}}:9000"
      - "127.0.0.1:${KORAS_PORT_MINIO_CONSOLE:-{{ports.minioConsole}}{{!}}}:9001"
    volumes:
      - minio-data:/data
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 10s
      timeout: 5s
      retries: 5

  # ── Observability ────────────────────────────────────────────────────────────
  # Services export OTLP to the collector, which fans traces out to Tempo and
  # logs to Loki. Only the collector publishes host ports: Loki and Tempo are
  # reached by service name inside this network, and leaving them unpublished
  # keeps two host ports free on a machine running several stacks.
  otel-collector:
    image: otel/opentelemetry-collector-contrib:0.115.1
    restart: unless-stopped
    command: ["--config=/etc/otel-collector.yml"]
    ports:
      - "127.0.0.1:${KORAS_PORT_OTLP_GRPC:-{{ports.otlpGrpc}}{{!}}}:4317"
      - "127.0.0.1:${KORAS_PORT_OTLP_HTTP:-{{ports.otlpHttp}}{{!}}}:4318"
    volumes:
      - ./observability/otel-collector.yml:/etc/otel-collector.yml:ro
    depends_on:
      - loki
      - tempo

  loki:
    image: grafana/loki:3.3.2
    restart: unless-stopped
    command: ["-config.file=/etc/loki/loki.yml"]
    volumes:
      - ./observability/loki.yml:/etc/loki/loki.yml:ro
      - loki-data:/loki

  tempo:
    image: grafana/tempo:2.6.1
    restart: unless-stopped
    command: ["-config.file=/etc/tempo/tempo.yml"]
    volumes:
      - ./observability/tempo.yml:/etc/tempo/tempo.yml:ro
      - tempo-data:/var/tempo

  # ── Proxy (Caddy) ───────────────────────────────────────────────────────────
  proxy:
    image: caddy:2-alpine
    restart: unless-stopped
    ports:
      - "127.0.0.1:${KORAS_PORT_PROXY_HTTP:-{{ports.proxyHttp}}{{!}}}:80"
      - "127.0.0.1:${KORAS_PORT_PROXY_HTTPS:-{{ports.proxyHttps}}{{!}}}:443"
    environment:
{{#if apps.web}}      KORAS_PORT_APP_WEB: ${KORAS_PORT_APP_WEB:-{{ports.appWeb}}{{!}}}
{{/if}}{{#if apps.admin}}      KORAS_PORT_APP_ADMIN: ${KORAS_PORT_APP_ADMIN:-{{ports.appAdmin}}{{!}}}
{{/if}}{{#if apps.marketing}}      KORAS_PORT_APP_MARKETING: ${KORAS_PORT_APP_MARKETING:-{{ports.appMarketing}}{{!}}}
{{/if}}{{#if service.api}}      KORAS_PORT_SERVICE_API: ${KORAS_PORT_SERVICE_API:-{{ports.serviceApi}}{{!}}}
{{/if}}{{#if service.ai_gateway}}      KORAS_PORT_SERVICE_AI_GATEWAY: ${KORAS_PORT_SERVICE_AI_GATEWAY:-{{ports.serviceAiGateway}}{{!}}}
{{/if}}    volumes:
      - ./proxy/Caddyfile:/etc/caddy/Caddyfile:ro
      - ./certs:/certs:ro
      - caddy-data:/data
    depends_on:
      - zitadel

volumes:
  supabase-db:
  redis-data:
  minio-data:
  caddy-data:
  loki-data:
  tempo-data:

# The masterkey reaches ZITADEL as a file, so it is never in the container's
# environment and `docker inspect` cannot show it. stack.mjs names the file
# after verifying it; without stack.mjs this fails before anything starts.
secrets:
  zitadel_masterkey:
    file: ${KORAS_ZITADEL_MASTERKEY_FILE:?start the stack through local/scripts/stack.mjs, not docker compose directly}

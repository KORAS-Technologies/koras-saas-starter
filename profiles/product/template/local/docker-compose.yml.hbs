name: {{projectSlug}}

services:
  # ── Database (Supabase local) ───────────────────────────────────────────────
  supabase-db:
    image: supabase/postgres:15.6.1.143
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: postgres
    ports:
      - "{{ports.supabaseDb}}:5432"
    volumes:
      - supabase-db:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "postgres"]
      interval: 5s
      timeout: 5s
      retries: 10

  # ── ZITADEL (identity provider) ────────────────────────────────────────────
  zitadel:
    image: ghcr.io/zitadel/zitadel:v4.17.1
    restart: unless-stopped
    command: start-from-init --masterkeyFromEnv --tlsMode disabled
    environment:
      ZITADEL_MASTERKEY: MasterkeyNeedsToHave32Characters
      ZITADEL_DATABASE_POSTGRES_HOST: supabase-db
      ZITADEL_DATABASE_POSTGRES_PORT: 5432
      ZITADEL_DATABASE_POSTGRES_DATABASE: zitadel
      ZITADEL_DATABASE_POSTGRES_USER_USERNAME: postgres
      ZITADEL_DATABASE_POSTGRES_USER_PASSWORD: postgres
      ZITADEL_DATABASE_POSTGRES_USER_SSL_MODE: disable
      ZITADEL_DATABASE_POSTGRES_ADMIN_USERNAME: postgres
      ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD: postgres
      ZITADEL_DATABASE_POSTGRES_ADMIN_SSL_MODE: disable
      ZITADEL_EXTERNALSECURE: "false"
      ZITADEL_EXTERNALPORT: {{ports.zitadel}}
      ZITADEL_EXTERNALDOMAIN: localhost
    ports:
      - "{{ports.zitadel}}:8080"
    depends_on:
      supabase-db:
        condition: service_healthy
    # No container healthcheck: the image is distroless (no curl/wget) and
    # `zitadel ready` reports not-ready against a server that is serving
    # traffic. `make health` probes http://localhost:8080/debug/ready instead.

  # ── Redis (queue + cache) ───────────────────────────────────────────────────
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    ports:
      - "{{ports.redis}}:6379"
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5

  # ── Mail (Mailpit) ──────────────────────────────────────────────────────────
  mail:
    image: axllent/mailpit:latest
    restart: unless-stopped
    ports:
      - "{{ports.mailSmtp}}:1025"   # SMTP
      - "{{ports.mailUi}}:8025"   # Web UI
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:{{ports.mailUi}}/"]
      interval: 10s
      timeout: 5s
      retries: 5

  # ── Storage (MinIO) ─────────────────────────────────────────────────────────
  storage:
    image: minio/minio:latest
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: minio
      MINIO_ROOT_PASSWORD: miniominio
    ports:
      - "{{ports.minioApi}}:9000"
      - "{{ports.minioConsole}}:9001"
    volumes:
      - minio-data:/data
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 10s
      timeout: 5s
      retries: 5

  # ── Proxy (Caddy) ───────────────────────────────────────────────────────────
  proxy:
    image: caddy:2-alpine
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./proxy/Caddyfile:/etc/caddy/Caddyfile:ro
      - ./certs:/certs:ro
      - caddy-data:/data
    depends_on:
      - zitadel

volumes:
  supabase-db:
  redis-data:
  minio-data:
  caddy-data:

# ── a refusal names both states ──────────────────────────────────────────────


@pytest.mark.asyncio
async def test_cancelling_a_finished_run_is_refused_before_any_statement() -> None:
    session = _Session()
    finished = replace(A_RUN, status=RunState.COMMITTED.value)
    with pytest.raises(TransitionRefused) as refused:
        await store.cancel(session, finished)  # type: ignore[arg-type]
    assert "committed" in str(refused.value)
    # Nothing was issued: the machine answered while the caller was on the stack.
    assert session.statements == []


@pytest.mark.asyncio
async def test_validating_a_run_that_was_never_mapped_is_refused() -> None:
    session = _Session()
    fresh = replace(A_RUN, status=RunState.CREATED.value)
    with pytest.raises(TransitionRefused):
        await store.begin_validation(session, fresh)  # type: ignore[arg-type]
    assert session.statements == []


@pytest.mark.asyncio
async def test_a_failure_reason_is_cut_to_something_a_column_holds() -> None:
    session = _Session()
    await store.fail(session, A_RUNNING, "x" * 900)  # type: ignore[arg-type]
    written = next(row for row in session.parameters if "error" in row)
    assert len(written["error"]) == 400


# ── a move is a compare-and-set (GR-383) ─────────────────────────────────────


def _moves() -> list[tuple[str, Any]]:
    """Every public mover, with the snapshot it is valid from."""
    return [
        ("set_mapping", lambda s: store.set_mapping(
            s, A_RUN, delimiter=",", encoding="utf-8", columns=["Name"], mapping={"Name": "name"}
        )),
        ("begin_validation", lambda s: store.begin_validation(s, A_RUN)),
        ("cancel", lambda s: store.cancel(s, A_RUN)),
        ("fail", lambda s: store.fail(s, A_RUNNING, "no")),
        ("request_commit", lambda s: store.request_commit(
            s, replace(A_RUN, status=RunState.VALIDATED.value), by="u"
        )),
        ("begin_commit", lambda s: store.begin_commit(
            s, replace(A_RUN, status=RunState.COMMIT_REQUESTED.value)
        )),
        ("record_commit", lambda s: store.record_commit(
            s, replace(A_RUN, status=RunState.COMMITTING.value), created=1, updated=0, skipped=0
        )),
    ]


@pytest.mark.asyncio
@pytest.mark.parametrize("name", [name for name, _ in _moves()])
async def test_every_move_names_the_status_it_expects_in_its_update(name: str) -> None:
    session = _Session()
    move = dict(_moves())[name]
    await move(session)
    update = next(s for s in session.statements if "update public.import_runs" in s)
    assert "and status = :expected" in update
    assert "returning id" in update
    assert session.parameters[-1]["expected"] in {s.value for s in RunState}


@pytest.mark.asyncio
async def test_the_expected_status_is_the_one_the_caller_saw() -> None:
    session = _Session()
    await store.begin_validation(session, A_RUN)
    assert session.parameters[-1]["expected"] == RunState.MAPPED.value
    assert session.parameters[-1]["status"] == RunState.VALIDATING.value


@pytest.mark.asyncio
@pytest.mark.parametrize("name", [name for name, _ in _moves()])
async def test_a_move_that_matches_no_row_is_refused_as_not_transitionable(name: str) -> None:
    session = _Session(moved_on=True)
    move = dict(_moves())[name]
    with pytest.raises(store.StaleRun) as refused:
        await move(session)
    # The existing refusal type, so every handler that maps it to 409
    # IMPORT_NOT_TRANSITIONABLE keeps doing so.
    assert isinstance(refused.value, TransitionRefused)



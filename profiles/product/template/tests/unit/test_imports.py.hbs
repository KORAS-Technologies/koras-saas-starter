class _File:
    def __init__(
        self, status: str = "ready", scan_status: str = "clean", category: str = "imports"
    ) -> None:
        self.category = category
{{#if capability.secure_files}}
        # A releasable file of a product with `secure_files` is a clean verdict on a final key
        # of the tenant the session is bound to, stamped by the scanner (core/file_release.py).
        self.storage_key = f"tenants/{TENANT}/imports/{FILE_ID}/final/{GENERATION}/customers.csv"
        self.tenant_id: str | None = TENANT
        self.session_tenant_id: str | None = TENANT
        self.scan_object_etag: str | None = "etag-1"
{{else}}
        self.storage_key = "tenants/t/imports/f/customers.csv"
{{/if}}
        self.size_bytes = 11
        self.checksum_sha256: str | None = None
        self.checksum_verified_at: object | None = None
        self.status = status
        self.scan_status = scan_status
        self.name = "customers.csv"


class _Store:
    """A bucket of the shape `ObjectStore` has: plain functions, not coroutines.

    It was a coroutine until IMPORT-DEF-014, and that is why the defect
    survived -- `source_bytes` awaited it, and the real store cannot be
    awaited. `threads` records where each call ran.
    """

    def __init__(self, content: bytes | None = b"Name,Email\n", size: int | None = None) -> None:
        self.content = content
        self.size = size
        self.read: list[str] = []
        self.threads: list[int] = []

    def head(self, key: str) -> int | None:
        del key
        self.threads.append(threading.get_ident())
        if self.size is not None:
            return self.size
        return None if self.content is None else len(self.content)

    def get(self, key: str) -> bytes | None:
        self.read.append(key)
        self.threads.append(threading.get_ident())
        return self.content



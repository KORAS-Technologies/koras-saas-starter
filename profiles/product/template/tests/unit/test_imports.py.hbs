def _mutated(**changes: object) -> _File:
    row = _File()
    for name, value in changes.items():
        setattr(row, name, value)
    return row


@pytest.mark.parametrize(
    "changes",
    [
        # The row is another tenant's, or the session is bound to no tenant at all.
        {"tenant_id": OTHER_TENANT},
        {"session_tenant_id": OTHER_TENANT},
        {"session_tenant_id": None},
        {"tenant_id": None},
        # The key is not this tenant's final key.
        {"storage_key": f"tenants/{OTHER_TENANT}/imports/{FILE_ID}/final/{GENERATION}/c.csv"},
        {"storage_key": f"tenants/{TENANT}/imports/{FILE_ID}/incoming/{GENERATION}/c.csv"},
        {"storage_key": f"tenants/{TENANT}/imports/{FILE_ID}/c.csv"},
        # The scanner did not stamp the object the verdict is about.
        {"scan_object_etag": None},
        {"scan_object_etag": ""},
    ],
)

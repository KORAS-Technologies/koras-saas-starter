    session = _Session(moved_on=True)
    with pytest.raises(TransitionRefused):
        await store.record_validation(
            session,  # type: ignore[arg-type]
            A_RUNNING,
            tenant_id="tenant-1",
            result=Validation(rows=1, valid=1, errors=(), truncated=False),
        )


@pytest.mark.asyncio
async def test_remembering_the_job_id_stays_keyed_on_the_id_alone() -> None:
    """No state changes, so there is nothing to compare."""
    session = _Session()
    await store.set_job(session, A_RUNNING, "job-1")  # type: ignore[arg-type]
    assert "status" not in session.statements[-1]



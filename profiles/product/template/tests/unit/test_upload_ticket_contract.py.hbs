@pytest.mark.parametrize(
    "claim",
    ["not-a-digest", "AB" * 32, "ab" * 31, "ab" * 33, "zz" * 32, " " + "ab" * 32, "", 12],
)
def test_a_malformed_claim_is_refused_in_either_mode_and_nothing_is_made(
    monkeypatch: pytest.MonkeyPatch, claim: object
) -> None:
    """Lowercase 64-hex or nothing. Upper-case is not canonicalized by the server: a claim is
    what the client computed, and the server never rewrites it into one that is accepted."""
    session, store = _Session(), _Store()
    answer = _client(session, store, monkeypatch).post(
        "/api/v1/files/uploads", json=_request(checksum_sha256=claim)
    )
    assert answer.status_code == 422, answer.text
    assert "checksum_sha256" in answer.text
    assert session.inserted == [] and store.presigned == []


def test_the_ticket_has_the_same_fields_in_either_mode(monkeypatch: pytest.MonkeyPatch) -> None:
    session, store = _Session(), _Store()
    answer = _client(session, store, monkeypatch).post(
        "/api/v1/files/uploads", json=_request(checksum_sha256=DIGEST)
    )
    assert answer.status_code == 201, answer.text
    body = answer.json()
    assert set(body) == TICKET_FIELDS
    assert body["method"] == "PUT" and body["expires_in"] == 15 * 60
    assert body["headers"]["Content-Type"] == "application/octet-stream"
    # The digest, when there is one, is signed in the same header in both modes.
    import base64

    signed = base64.b64encode(bytes.fromhex(DIGEST)).decode()
    assert body["headers"]["x-amz-checksum-sha256"] == signed
    assert store.claims == [DIGEST]


def test_the_file_row_a_confirmation_answers_with_has_the_same_fields_in_either_mode(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    answer = _client(_Session(_pending(DIGEST)), _Store(size=12), monkeypatch).post(
        f"/api/v1/files/{FILE_A}/complete", json={"checksum_sha256": DIGEST}
    )
    assert answer.status_code == 200, answer.text
    assert FILE_ROW_REQUIRED <= set(answer.json())



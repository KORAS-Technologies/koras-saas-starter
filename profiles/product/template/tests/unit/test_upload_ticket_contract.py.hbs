def test_the_legacy_completion_records_the_clients_claim_and_corroborates_it_when_it_can(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """The behaviour that is deliberately not carried into a secure product."""
    session = _Session(_pending(None))
    store = _Store(size=12, digest=DIGEST)
    answer = _client(session, store, monkeypatch).post(
        f"/api/v1/files/{FILE_A}/complete", json={"checksum_sha256": DIGEST}
    )
    assert answer.status_code == 200, answer.text
    ((sql, params), *_) = [u for u in session.updates if "status = 'ready'" in u[0]]
    assert "checksum_sha256" in sql and params["checksum"] == DIGEST
    assert store.checksum_asked, "the provider's own digest is consulted"
    assert answer.json()["checksum_verified"] is True



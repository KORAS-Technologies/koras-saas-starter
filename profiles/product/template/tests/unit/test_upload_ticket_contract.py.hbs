def test_the_claim_is_bound_to_the_row_and_the_ticket_names_an_incoming_key(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    session, store = _Session(), _Store()
    answer = _client(session, store, monkeypatch).post(
        "/api/v1/files/uploads", json=_request(checksum_sha256=DIGEST)
    )
    assert answer.status_code == 201, answer.text
    (row,) = session.inserted
    assert row["checksum"] == DIGEST
    (signed,) = store.presigned
    assert "/incoming/" in signed and row["key"] == signed
    (upload_id,) = store.provenance
    assert upload_id is not None and upload_id == signed.split("/")[5]
    headers = answer.json()["headers"]
    assert headers["x-amz-meta-koras-upload"] == upload_id
    assert headers["x-amz-metadata-directive"] == "COPY"
    assert "x-amz-copy-source-if-match" in headers


def test_a_completion_cannot_change_the_claim_and_the_server_never_invents_one(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    other = "cd" * 32
    session = _Session(_pending(DIGEST))
    refused = _client(session, _Store(size=12), monkeypatch).post(
        f"/api/v1/files/{FILE_A}/complete", json={"checksum_sha256": other}
    )
    assert refused.status_code == 422 and refused.json()["detail"]["code"] == (
        "upload_checksum_claim_invalid"
    )
    assert not [u for u in session.updates if "status = 'ready'" in u[0]]

    unclaimed = _Session(_pending(None))
    refused = _client(unclaimed, _Store(size=12, digest=DIGEST), monkeypatch).post(
        f"/api/v1/files/{FILE_A}/complete", json={"checksum_sha256": DIGEST}
    )
    assert refused.status_code == 422, "a digest read from the object is not a claim"
    assert not [u for u in unclaimed.updates if "status = 'ready'" in u[0]]


def test_the_completion_update_names_no_checksum_column(monkeypatch: pytest.MonkeyPatch) -> None:
    session = _Session(_pending(DIGEST))
    store = _Store(size=12, digest=DIGEST)
    answer = _client(session, store, monkeypatch).post(
        f"/api/v1/files/{FILE_A}/complete", json={"checksum_sha256": DIGEST}
    )
    assert answer.status_code == 200, answer.text
    ((sql, _), *_) = [u for u in session.updates if "status = 'ready'" in u[0]]
    assert "checksum" not in sql
    assert store.checksum_asked == [], "the provider's digest is never a trust anchor"
    assert answer.json()["checksum_verified"] is False

def test_the_claim_is_optional_and_a_ticket_without_one_is_what_it_always_was(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    session, store = _Session(), _Store()
    answer = _client(session, store, monkeypatch).post("/api/v1/files/uploads", json=_request())
    assert answer.status_code == 201, answer.text
    body = answer.json()
    assert set(body) == TICKET_FIELDS
    # Exactly the headers it always signed: a content type, and no digest, no guard.
    assert body["headers"] == {"Content-Type": "application/octet-stream"}
    (row,) = session.inserted
    assert "checksum" not in row and "checksum_sha256" not in " ".join(session.inserted_sql)
    (signed,) = store.presigned
    assert "/incoming/" not in signed, "the legacy key shape is unchanged"
    assert signed.startswith(f"tenants/{TENANT_A}/documents/")
    assert store.provenance == [None], "the legacy ticket is not guarded"
    assert store.claims == [None]



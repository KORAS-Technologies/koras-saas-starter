)
def test_the_edges_of_every_range_are_accepted(
    on: ModuleType, attribute: str, value: object
) -> None:
    on.validate_secure_files_settings(settings_with(**{attribute: value}))


def test_the_ranges_are_the_ones_the_scanner_package_enforces() -> None:
    from koras_worker.scanning.config import (
        MAX_CONNECT_TIMEOUT_SECONDS,
        MAX_RECORDED_ATTEMPTS,
        MAX_SCAN_BYTES,
        MAX_SCAN_TIMEOUT_SECONDS,
        ScannerSettings,
    )
    from pydantic import ValidationError

    assert api_sf.SCAN_CEILING_BYTES == worker_sf.SCAN_CEILING_BYTES == MAX_SCAN_BYTES
    # The package's own validators and this module's checks accept the same edges.
    for name, high in (
        ("file_scan_connect_timeout_seconds", MAX_CONNECT_TIMEOUT_SECONDS),
        ("file_scan_timeout_seconds", MAX_SCAN_TIMEOUT_SECONDS),
        ("file_scan_max_bytes", MAX_SCAN_BYTES),
        ("file_scan_max_attempts", MAX_RECORDED_ATTEMPTS),
    ):
        ScannerSettings(**{name: high})
        with pytest.raises(ValidationError):
            ScannerSettings(**{name: high + 1})
        for module in (api_sf, worker_sf):
            check = next(c for c in module.SECURE_FILES_CHECKS if c.attribute == name)
            assert check.accepts(high) and not check.accepts(high + 1)


@pytest.mark.parametrize(
    "variable",
    [
        "FILE_SCAN_CONNECT_TIMEOUT_SECONDS",
        "FILE_SCAN_TIMEOUT_SECONDS",
        "FILE_SCAN_MAX_BYTES",
        "FILE_SCAN_MAX_ATTEMPTS",
    ],
)
def test_a_value_that_is_not_a_number_stops_the_worker_naming_the_variable_only(
    monkeypatch: pytest.MonkeyPatch, variable: str
) -> None:
    monkeypatch.setattr(worker_sf, "SECURE_FILES", True)
    for attribute, env in ENV_NAMES.items():
        if attribute not in DERIVED:
            monkeypatch.setenv(env, str(VALID[attribute]))
    monkeypatch.setenv(variable, "not-a-number-ZZZ")
    with pytest.raises(worker_sf.SecureFilesConfigurationError, match=variable) as raised:
        worker_sf.enforce_secure_files_at_startup()
    assert "ZZZ" not in str(raised.value)


@pytest.mark.parametrize(
    "variable",
    [
        "FILE_SCAN_ALLOW_NONE",
        "FILE_SCAN_DISABLED",
        "FILE_SCAN_SKIP",
        "SECURE_FILES",
        "FILE_SCAN_OPTIONAL",
    ],
)
def test_no_environment_variable_relaxes_the_scanner_requirement(
    monkeypatch: pytest.MonkeyPatch, variable: str
) -> None:
    monkeypatch.setattr(worker_sf, "SECURE_FILES", True)
    for attribute, env in ENV_NAMES.items():
        if attribute not in DERIVED:
            monkeypatch.setenv(env, str(VALID[attribute]))
    monkeypatch.setenv("FILE_SCAN_BACKEND", "none")
    for value in ("1", "true", "yes", "on", "none"):
        monkeypatch.setenv(variable, value)
        with pytest.raises(worker_sf.SecureFilesConfigurationError, match="FILE_SCAN_BACKEND"):
            worker_sf.enforce_secure_files_at_startup()

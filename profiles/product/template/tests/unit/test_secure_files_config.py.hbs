# What follows exists only in a product generated WITH the capability: the
# wiring that makes the refusal happen at start, which is generated only there.


@pytest.mark.asyncio
async def test_the_api_refuses_to_start_without_a_scanner(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    from koras_api import main

    monkeypatch.setattr(api_sf, "SECURE_FILES", True)
    monkeypatch.setattr(main, "settings", settings_with(file_scan_backend="none"))
    with pytest.raises(api_sf.SecureFilesConfigurationError, match="FILE_SCAN_BACKEND"):
        async with main.lifespan(main.app):
            pytest.fail("the API started without a scanner")


@pytest.mark.asyncio
async def test_the_worker_refuses_to_start_without_a_scanner(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    from koras_worker import worker

    monkeypatch.setattr(worker_sf, "SECURE_FILES", True)
    for env in ENV_NAMES.values():
        monkeypatch.delenv(env, raising=False)
    with pytest.raises(worker_sf.SecureFilesConfigurationError) as raised:
        await worker.verify_isolation({})
    # Every unset mandatory setting, in one refusal. The port and the scanner's limits have
    # valid defaults, so they are the ones that are not a problem.
    assert len(raised.value.problems) == len(ENV_NAMES) - len(HAS_DEFAULT)


def test_the_generated_constant_is_true() -> None:
    assert api_sf.SECURE_FILES is True
    assert worker_sf.SECURE_FILES is True


# ---- the scanner's limits (layer 3) ------------------------------------------------------

LIMITS_OUTSIDE_THEIR_RANGE = [
    ("file_scan_connect_timeout_seconds", 0, "FILE_SCAN_CONNECT_TIMEOUT_SECONDS"),
    ("file_scan_connect_timeout_seconds", -1, "FILE_SCAN_CONNECT_TIMEOUT_SECONDS"),
    ("file_scan_connect_timeout_seconds", 61, "FILE_SCAN_CONNECT_TIMEOUT_SECONDS"),
    ("file_scan_connect_timeout_seconds", True, "FILE_SCAN_CONNECT_TIMEOUT_SECONDS"),
    ("file_scan_connect_timeout_seconds", "5", "FILE_SCAN_CONNECT_TIMEOUT_SECONDS"),
    ("file_scan_timeout_seconds", 0, "FILE_SCAN_TIMEOUT_SECONDS"),
    ("file_scan_timeout_seconds", 601, "FILE_SCAN_TIMEOUT_SECONDS"),
    ("file_scan_max_bytes", 0, "FILE_SCAN_MAX_BYTES"),
    ("file_scan_max_bytes", 100 * 1024 * 1024 + 1, "FILE_SCAN_MAX_BYTES"),
    ("file_scan_max_bytes", 1.5, "FILE_SCAN_MAX_BYTES"),
    ("file_scan_max_attempts", 0, "FILE_SCAN_MAX_ATTEMPTS"),
    ("file_scan_max_attempts", 32768, "FILE_SCAN_MAX_ATTEMPTS"),
    ("file_scan_max_attempts", False, "FILE_SCAN_MAX_ATTEMPTS"),
    ("file_scan_timeouts_consistent", False, "FILE_SCAN_CONNECT_TIMEOUT_SECONDS"),
]


@pytest.mark.parametrize(("attribute", "value", "env"), LIMITS_OUTSIDE_THEIR_RANGE)
def test_a_scanner_limit_outside_its_range_is_refused_by_name(
    on: ModuleType, attribute: str, value: object, env: str
) -> None:
    with pytest.raises(on.SecureFilesConfigurationError, match=env):
        on.validate_secure_files_settings(settings_with(**{attribute: value}))


@pytest.mark.parametrize(
    ("attribute", "value"),
    [
        ("file_scan_connect_timeout_seconds", 60),
        ("file_scan_timeout_seconds", 600),
        ("file_scan_max_bytes", 1),

"""Run inside the worker's own image. Not a test, and not imported by one.

`test_worker_image.py` beside this file feeds it to `python -` in a container
made from the image the product's Dockerfile builds, with nothing mounted. So
what runs here runs against exactly the files the image carries -- which is
the one thing no other suite in this repository does: every one of them runs
where the whole source tree is on the path, and IMPORT-DEF-020 was a module
the tree has and the image did not.

It prints one line of JSON, last, and judges nothing. The assertions are in
the test, where a failure names what it was looking for.

Two things are replaced, because a generated product has neither:

- **the import's object store**, with one that answers from memory and has
  the shape `ObjectStore` has: plain functions, and a `head`. Until
  IMPORT-DEF-014 it was a coroutine, which is what `source_bytes` awaited
  and what no real bucket is;
- **the import target registry**, with one target that has a writer. The
  starter owns no table, so the writer puts its rows in `import_row_errors`,
  as `test_import_commit_atomic.py` does.

Nothing else. The task, the run store, the audit sink, the notice and the
dispatch point are the image's own.
"""

from __future__ import annotations

import ast
import asyncio
import importlib
import importlib.util
import json
import logging
import os
import sys
import uuid
from pathlib import Path
from typing import Any

#: The organisation `e2e/support/seed.sql` creates.
TENANT = "00000000-0000-4e2e-8000-000000000001"
{{#if capability.secure_files}}
GENERATION = "00000000-0000-4000-8000-000000000001"
{{/if}}
SUBJECT = "e2e-owner"
ROWS = 25


def _named_by_the_worker() -> list[str]:
    """Every `koras_api` module the worker in this image passes to `import_module`."""
    import koras_worker

    named: set[str] = set()
    for path in Path(koras_worker.__file__).parent.rglob("*.py"):
        for node in ast.walk(ast.parse(path.read_text(encoding="utf-8"))):
            if (
                isinstance(node, ast.Call)
                and isinstance(node.func, ast.Attribute)
                and node.func.attr == "import_module"
                and node.args
                and isinstance(node.args[0], ast.Constant)
                and str(node.args[0].value).startswith("koras_api")
            ):
                named.add(str(node.args[0].value))
    return sorted(named)


def _present(module: str) -> bool:
    try:
        return importlib.util.find_spec(module) is not None
    except (ImportError, ValueError):
        return False


class _Complaints(logging.Handler):
    """Every warning and error the worker's own code logged while this ran."""

    def __init__(self) -> None:
        super().__init__(level=logging.WARNING)
        self.lines: list[str] = []

    def emit(self, record: logging.LogRecord) -> None:
        self.lines.append(f"{record.name}: {record.getMessage()}")


class _Bucket:
    def __init__(self) -> None:
        self.objects: dict[str, bytes] = {}

    def head(self, key: str) -> int | None:
        return len(self.objects[key]) if key in self.objects else None

    def get(self, key: str) -> bytes | None:
        return self.objects.get(key)


def _csv(rows: int = ROWS) -> bytes:
    lines = ["Email,Name"]
    lines.extend(f"person{number}@example.test,Person {number}" for number in range(rows))
    return ("\n".join(lines) + "\n").encode()


async def _probe() -> dict[str, Any]:
    from sqlalchemy import text
    from sqlalchemy.ext.asyncio import async_sessionmaker, create_async_engine

    report: dict[str, Any] = {}

    # ── what the image is ────────────────────────────────────────────────────
    report["image"] = {
        # The source tree has all three. The image has none of them, and if it
        # ever does this is no longer a test of the image.
        "api_main": _present("koras_api.main"),
        "api_database": _present("koras_api.core.database"),
        "api_settings": _present("koras_api.core.settings"),
    }

    # ── every module the worker names, loaded here ──────────────────────────
    loads: dict[str, str] = {}
    for module in _named_by_the_worker():
        try:
            importlib.import_module(module)
            loads[module] = "ok"
        except Exception as problem:  # noqa: BLE001 - the report is the point
            loads[module] = f"{type(problem).__name__}: {problem}"
    report["loads"] = loads

    import koras_worker.tasks.imports as task
    from koras_import import (
        COMMIT_RUN,
        VALIDATE_RUN,
        FieldKind,
        FieldSpec,
        ImportTarget,
        Operation,
        Written,
        build_registry,
    )
    from koras_queue import JobEnvelope
    from koras_worker.settings import settings

    complaints = _Complaints()
    logging.getLogger("koras_worker").addHandler(complaints)

    as_tenant = text(
        "select set_config('app.provisioning', '', true), "
        "set_config('app.tenant_id', :tenant_id, true)"
    )

    async def writer(session: Any, request: Any) -> Any:  # noqa: ANN401
        for position, row in enumerate(request.rows):
            await session.execute(
                text(
                    "insert into public.import_row_errors"
                    " (run_id, tenant_id, row_number, code, value)"
                    " values (cast(:run as uuid), cast(:t as uuid), :n, 'probe.written', :v)"
                ),
                {"run": request.run_id, "t": TENANT, "n": position + 2, "v": row["email"]},
            )
        return Written(created=len(request.rows))

    target = ImportTarget(
        key="test.image_probe",
        label_key="import.target.test.image_probe",
        permission="imports.manage",
        fields=(
            FieldSpec("email", "import.field.test.email", kind=FieldKind.EMAIL, required=True),
            FieldSpec("name", "import.field.test.name", required=True),
        ),
        match_keys=("email",),
        operations=(Operation.SKIP_DUPLICATE,),
        writer=writer,
    )
    bucket = _Bucket()
    task._object_store = lambda: bucket  # type: ignore[assignment]
    task._registry = lambda: build_registry([target])  # type: ignore[assignment]

    engine = create_async_engine(
        settings.database_url.replace("postgresql://", "postgresql+asyncpg://", 1)
    )

    async def seed(status: str, *, stored: bool = True, target_key: str = target.key) -> str:
        run_id, file_id = str(uuid.uuid4()), str(uuid.uuid4())
        raw = _csv()
{{#if capability.secure_files}}
        key = f"tenants/{TENANT}/imports/{file_id}/final/{GENERATION}/probe.csv"
{{else}}
        key = f"imports/{file_id}.csv"
{{/if}}
        if stored:
            bucket.objects[key] = raw
        async with async_sessionmaker(engine, expire_on_commit=False)() as session:
            await session.execute(as_tenant, {"tenant_id": TENANT})
            await session.execute(
                text(
                    "insert into public.files (id, tenant_id, category, name, storage_key,"
{{#if capability.secure_files}}
                    " size_bytes, content_type, status, scan_status, scan_object_etag, uploaded_by)"
                    " values (cast(:id as uuid), cast(:t as uuid), 'imports', 'probe.csv',"
                    " :key, :size, 'text/csv', 'ready', 'clean', 'etag-1', :by)"
{{else}}
                    " size_bytes, content_type, status, scan_status, uploaded_by)"
                    " values (cast(:id as uuid), cast(:t as uuid), 'imports', 'probe.csv',"
                    " :key, :size, 'text/csv', 'ready', 'clean', :by)"
{{/if}}
                ),
                {"id": file_id, "t": TENANT, "key": key, "size": len(raw), "by": SUBJECT},
            )
            await session.execute(
                text(
                    "insert into public.import_runs (id, tenant_id, target, status, format,"
                    " source_file_id, delimiter, encoding, columns, mapping, operation,"
                    " rows_total, rows_valid, errors_total, requested_by, committed_by)"
                    " values (cast(:id as uuid), cast(:t as uuid), :target,"
                    " :status, 'csv', cast(:f as uuid), ',', 'utf-8-sig', :cols,"
                    " cast(:map as jsonb), 'skip_duplicate', 0, 0, 0, :by, :by)"
                ),
                {
                    "id": run_id,
                    "t": TENANT,
                    "target": target_key,
                    "f": file_id,
                    "status": status,
                    "cols": ["Email", "Name"],
                    "map": '{"Email":"email","Name":"name"}',
                    "by": SUBJECT,
                },
            )
            await session.commit()
        return run_id

    async def state(run_id: str) -> dict[str, Any]:
        """The run, its writer's rows and its audit rows, on a session of their own."""
        async with async_sessionmaker(engine, expire_on_commit=False)() as session:
            await session.execute(as_tenant, {"tenant_id": TENANT})
            run = (
                await session.execute(
                    text(
                        "select status, error, rows_total, rows_valid, rows_created"
                        " from public.import_runs where id = cast(:id as uuid)"
                    ),
                    {"id": run_id},
                )
            ).first()
            written = (
                await session.execute(
                    text(
                        "select count(*) from public.import_row_errors"
                        " where run_id = cast(:id as uuid) and code = 'probe.written'"
                    ),
                    {"id": run_id},
                )
            ).scalar_one()
            audit = (
                await session.execute(
                    text(
                        "select action, outcome from public.audit_events"
                        " where target_type = 'import_run' and target_id = :id"
                        " order by created_at"
                    ),
                    {"id": run_id},
                )
            ).all()
        return {
            "status": run.status if run else None,
            "error": run.error if run else None,
            "rows_total": run.rows_total if run else None,
            "rows_created": run.rows_created if run else None,
            "written": int(written),
            "audit": [[row.action, row.outcome] for row in audit],
        }

    async def run_job(function: Any, name: str, run_id: str) -> dict[str, Any]:  # noqa: ANN401
        envelope = JobEnvelope(
            task=name, tenant_id=TENANT, payload={"run_id": run_id}, actor_id=SUBJECT
        )
        del complaints.lines[:]
        try:
            answer: Any = await function({}, envelope)
            raised = None
        except Exception as problem:  # noqa: BLE001 - the report is the point
            answer, raised = None, f"{type(problem).__name__}: {problem}"
        return {
            "answer": answer,
            "raised": raised,
            "run": await state(run_id),
            "complaints": list(complaints.lines),
        }

    try:
        # ── a dry run that succeeds ─────────────────────────────────────────
        report["dry_run"] = await run_job(
            task.validate_run, VALIDATE_RUN.name, await seed("validating")
        )

        # ── a commit that succeeds ──────────────────────────────────────────
        report["commit"] = await run_job(
            task.commit_run, COMMIT_RUN.name, await seed("commit_requested")
        )

        # ── a dry run whose file cannot be read: a failure the job reports ──
        report["dry_run_refused"] = await run_job(
            task.validate_run, VALIDATE_RUN.name, await seed("validating", stored=False)
        )

        # ── a dry run that raises: a failure the job does not catch ─────────
        record = task._record

        async def no_evidence(*_: object, **__: object) -> None:
            raise RuntimeError("the audit table refused the row")

        task._record = no_evidence  # type: ignore[assignment]
        try:
            report["dry_run_raised"] = await run_job(
                task.validate_run, VALIDATE_RUN.name, await seed("validating")
            )
        finally:
            task._record = record  # type: ignore[assignment]

        # ── through the worker this image starts, when there is one ─────────
        if os.environ.get("PROBE_QUEUE") == "1":
            from arq.connections import RedisSettings, create_pool
            from arq.jobs import Job
            from koras_queue import queue_for

            pool = await create_pool(RedisSettings.from_dsn(str(settings.redis_url)))
            queue = queue_for(str(settings.redis_url))
            through: dict[str, Any] = {}
            try:
                light = await pool.enqueue_job("example_task", {"n": 1})
                assert light is not None
                through["example_task"] = await light.result(timeout=120, poll_delay=0.5)

                # A run for a target the worker's own registry does not hold:
                # the job the worker picks up loads the registry and the run
                # store for itself, refuses the run and says so on it.
                unknown = await seed("validating", target_key="nobody.declared_this")
                queued = await queue.enqueue(
                    VALIDATE_RUN, tenant_id=TENANT, payload={"run_id": unknown}, actor_id=SUBJECT
                )
                job = Job(queued.job_id, pool)
                try:
                    answer = await job.result(timeout=120, poll_delay=0.5)
                    raised = None
                except Exception as problem:  # noqa: BLE001 - the report is the point
                    answer, raised = None, f"{type(problem).__name__}: {problem}"
                through["imports.validate"] = {
                    "answer": answer,
                    "raised": raised,
                    "run": await state(unknown),
                }
            finally:
                await queue.aclose()
                await pool.aclose()
            report["through_the_worker"] = through
    finally:
        await engine.dispose()
    return report


if __name__ == "__main__":
    logging.basicConfig(level=logging.ERROR, stream=sys.stderr)
    print(json.dumps(asyncio.run(_probe()), default=str))

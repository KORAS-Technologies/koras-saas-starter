# ruff: noqa: ANN001, ANN201, ANN202, ANN401, E501, S101
"""Derived content is gated and withdrawn against a real PostgreSQL with RLS on (`secure_files`).

A scripted session has no row locks, no second connection and no trigger, so it cannot
show what the withdrawal rests on: that the retrieval statement hides a chunk whose file is not
releasable, that the indexer's write guard reads the verdict and refuses, that the
scanner's own `commit_infected` -- unedited -- removes the chunks in its own
transaction, and that an index write racing a late `clean -> infected` verdict cannot
leave a usable chunk behind in either order.

Skipped without a database, on the variable `playwright.config.ts` names. The role in
`E2E_DATABASE_URL` must be the restricted application role, not a superuser; the test
refuses to run as one. CI runs this module in a step that fails on a skip.
"""

from __future__ import annotations

import asyncio
import json
import os
import uuid
from collections.abc import AsyncIterator, Sequence

import pytest
from sqlalchemy import text
from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker, create_async_engine


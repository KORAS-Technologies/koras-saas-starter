    embed, started, release = _held_embed()
    indexing = asyncio.create_task(_index_in_a_session(engine, tenant, file_id, read, embed))
    await asyncio.wait_for(started.wait(), 10)
    await _replace_object(
        engine, tenant, file_id, key=f"{read.storage_key}.b", scan_status="pending", etag=None

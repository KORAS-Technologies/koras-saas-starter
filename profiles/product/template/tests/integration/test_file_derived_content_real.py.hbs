# -- the index write is bound to the object that was read  ----------------
#
# The indexer reads object A, embeds for a while holding no lock, and only then takes the
# write guard. A restore can replace the file in that window: the row then references B,
# and chunks of A's bytes must not be attached to it, nor an outcome note about A.


def _held_embed():
    """An embedder that reports it started and waits to be released: the indexer's gap."""
    started, release = asyncio.Event(), asyncio.Event()

    async def embed(texts):
        started.set()
        await release.wait()
        return [VECTOR for _ in texts]

    return embed, started, release


async def _index_in_a_session(engine, tenant, file_id, read, embed):
    async with async_sessionmaker(engine, expire_on_commit=False)() as s:
        await s.execute(AS_TENANT, {"tenant_id": tenant})
        return await knowledge_store.index_file_document(
            s, scope=_scope(tenant), document=_document(tenant, file_id), embed=embed, read=read
        )


async def _replace_object(engine, tenant, file_id, *, key, scan_status, etag) -> None:
    """What a restore's `_REPLACE_FILE` does to the row, then (optionally) a verdict on it."""
    async with async_sessionmaker(engine, expire_on_commit=False)() as s:
        await s.execute(AS_TENANT, {"tenant_id": tenant})
        await s.execute(
            text(
                "update public.files set storage_key = :k, scan_status = :scan, "
                "scan_object_etag = :etag, indexed_at = null, index_note = null "
                "where id = cast(:f as uuid)"
            ),
            {"k": key, "scan": scan_status, "etag": etag, "f": file_id},
        )
        await s.commit()


async def test_a_file_that_still_references_the_object_that_was_read_is_indexed(
    engine, session
) -> None:
    tenant = await _tenant(session)
    file_id = await _file(session, tenant, scan_status="clean", etag="etag-a")
    read = _read(tenant, file_id, "etag-a")
    embed, _started, release = _held_embed()
    release.set()
    count = await _index_in_a_session(engine, tenant, file_id, read, embed)
    assert count >= 1 and await _chunks(engine, tenant, file_id) == count
    await ai._record_index(tenant, file_id, indexed=True, note=f"{count} chunk(s)", read=read)
    row = await _row(engine, tenant, file_id)
    assert row["indexed_at"] is not None and row["index_note"] == f"{count} chunk(s)"
    assert await _search(session, tenant) == {file_id}


async def test_an_indexer_that_read_generation_a_cannot_commit_once_the_row_holds_b(
    engine, session
) -> None:
    tenant = await _tenant(session)
    file_id = await _file(session, tenant, scan_status="clean", etag="etag-a")
    read_a = _read(tenant, file_id, "etag-a")
    embed, started, release = _held_embed()

    indexing = asyncio.create_task(_index_in_a_session(engine, tenant, file_id, read_a, embed))
    await asyncio.wait_for(started.wait(), 10)  # A was read; no lock is held while it embeds
    key_b = f"tenants/{tenant}/documents/{file_id}/final/{GENERATION}/restored-b.txt"
    await _replace_object(engine, tenant, file_id, key=key_b, scan_status="pending", etag=None)
    await _replace_object(
        engine, tenant, file_id, key=key_b, scan_status="clean", etag="etag-b"
    )  # B was scanned clean while A's chunks were still being embedded
    release.set()

    with pytest.raises(knowledge_store.ObjectChanged):
        await asyncio.wait_for(indexing, 10)
    assert await _chunks(engine, tenant, file_id) == 0, "no chunk of A on a row that holds B"
    assert await _search(session, tenant) == set(), "nothing derived from A is retrievable"

    # A's outcome note is not written onto B either, so B is still due for indexing.
    await ai._record_index(tenant, file_id, indexed=True, note="3 chunk(s)", read=read_a)
    row = await _row(engine, tenant, file_id)
    assert row["indexed_at"] is None and row["index_note"] is None

    # B itself indexes, under its own identity.
    read_b = knowledge_store.ReadIdentity(storage_key=key_b, etag="etag-b")
    assert await _index_in_a_session(engine, tenant, file_id, read_b, embed) >= 1
    assert await _search(session, tenant) == {file_id}


async def test_the_same_key_with_a_new_verdict_etag_is_not_the_object_that_was_read(
    engine, session
) -> None:
    """A mutation or re-verdict of the same key changes the identity the scanner bound."""
    tenant = await _tenant(session)
    file_id = await _file(session, tenant, scan_status="clean", etag="etag-1")
    read = _read(tenant, file_id, "etag-1")
    embed, started, release = _held_embed()
    indexing = asyncio.create_task(_index_in_a_session(engine, tenant, file_id, read, embed))
    await asyncio.wait_for(started.wait(), 10)
    await _replace_object(
        engine, tenant, file_id, key=read.storage_key, scan_status="clean", etag="etag-2"
    )
    release.set()
    with pytest.raises(knowledge_store.ObjectChanged):
        await asyncio.wait_for(indexing, 10)
    assert await _chunks(engine, tenant, file_id) == 0


async def test_a_replacement_that_is_not_yet_clean_refuses_the_old_indexer_as_not_releasable(
    engine, session
) -> None:
    tenant = await _tenant(session)
    file_id = await _file(session, tenant, scan_status="clean", etag="etag-a")

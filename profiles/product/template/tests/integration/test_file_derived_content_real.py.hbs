async def test_the_object_binding_never_crosses_tenants(engine, session) -> None:
    owner = await _tenant(session)
    other = await _tenant(session)
    file_id = await _file(session, owner, scan_status="clean", etag="etag-a")
    read = _read(owner, file_id, "etag-a")  # the exact identity of the owner's object
    embed, _started, release = _held_embed()
    release.set()
    with pytest.raises(knowledge_store.FileNotReleasable):
        await _index_in_a_session(engine, other, file_id, read, embed)
    assert await _chunks(engine, owner, file_id) == 0
    assert await _chunks(engine, other, file_id) == 0
    await ai._record_index(other, file_id, indexed=True, note="1 chunk(s)", read=read)
    row = await _row(engine, owner, file_id)
    assert row["indexed_at"] is None and row["index_note"] is None, (
        "another tenant's outcome is never written on this row"
    )

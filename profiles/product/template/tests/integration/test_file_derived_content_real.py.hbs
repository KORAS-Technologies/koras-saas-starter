AS_PROVISIONING = text("select set_config('app.provisioning', 'on', true)")
AS_TENANT = text(
    "select set_config('app.provisioning', '', true), set_config('app.tenant_id', :tenant_id, true)"
)
STATES = (
    ("ready", "clean"),
    ("ready", "pending"),
    ("ready", "skipped"),
    ("ready", "infected"),
    ("quarantined", "infected"),
    ("pending", "clean"),
)
NAME = "private-name-xyz.txt"
GENERATION = "2222222a-2222-4222-8222-22222222222b"
NOTE = "Eicar-Signature-must-never-leak"
VECTOR = tuple([0.1] * 1536)


async def _embed(texts: Sequence[str]) -> list[tuple[float, ...]]:
    return [VECTOR for _ in texts]


class _Store:
    """Counts reads, so "no byte was read" is an assertion and not a hope."""

    def __init__(self) -> None:
        self.reads: list[str] = []

    def get(self, key: str) -> bytes:
        self.reads.append(key)
        return b"alpha beta gamma"



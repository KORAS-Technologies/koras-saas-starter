app.include_router(health.router, prefix="/api/v1")
# The customer-facing surface. Tier 2 limiting: keyed on the organization and
# subject a verified token proved, rather than on an address a caller asserts.
# A tenant sharing one office address is not one caller, and a verified caller
# can still be abusive.
app.include_router(
    tenant.router,
    prefix="/api/v1",
    dependencies=[Depends(limit_authenticated)],
)
# Settings: the catalogue, what it resolves to for this caller, and the two
# scopes a customer may write. Never capability-gated -- the shell resolves a
# customer's settings before it paints, so a product generated without anything
# optional still serves these.
#
# **Imported under another name, and it has to be.** This module already binds
# `settings` to the process's configuration on line 12, and `from .routers
# import settings` would rebind it to a module with no `environment` on it --
# so the app would fail at import, in every generated product, on the line that
# decides whether to publish the docs. Found on 2026-09-17 by running a
# generated product's own tests; nothing about the template reads wrongly.
#
# Registered after `tenant`, which owns `/tenant/settings` and the two locale
# routes. Neither router takes a path parameter at that level, so the order is
# readability rather than resolution: the settings routes sit beside the tenant
# ones a reader will compare them with.
app.include_router(
    settings_router.router,
    prefix="/api/v1",
    dependencies=[Depends(limit_authenticated)],
)
# Files: the same customer surface, the same limiter, its own module because
# it is the first route family that mints signed URLs and touches a bucket.
app.include_router(
    files.router,
    prefix="/api/v1",
    dependencies=[Depends(limit_authenticated)],
)
{{#if capability.data_import}}# Loading a file of records into a table this product owns. Upload, map, dry
# run -- and nothing here writes a row of a target table: a run reaching
# `validated` is a terminal state that wrote nothing, which is what makes a dry
# run a dry run rather than a promise. `imports.manage` on every route, reads
# included: a run names a customer's own records and the mapping shows their
# column headings.
#
# `/imports/targets` is registered inside the router ahead of `/imports/{id}`,
# because Starlette matches in registration order and would otherwise read
# "targets" as a run id.
app.include_router(
    imports.router,
    prefix="/api/v1",
    dependencies=[Depends(limit_authenticated)],
)
{{/if}}{{#if capability.notifications}}# A person's own feed. No permission on any route, like `/me/settings`: what
# protects a feed is the policy keyed to the verified subject, and a permission
# would make the bell a premium feature. No route writes one either -- a
# notification is produced by the thing that happened, server-side, because a
# create route would let any signed-in person put a message in a colleague's

# ── helpers ───────────────────────────────────────────────────────────────────

_BUCKETS = {"day": "day", "week": "week", "month": "month"}


def _bucket(period: DateRange) -> str:
    # A closed lookup rather than the value itself, so the one interpolated
    # word can only ever be one of three this file names.
    return _BUCKETS[period.bucket]


def _range_view(period: DateRange) -> RangeView:
    return RangeView(
        start=period.start.isoformat(), end=period.end.isoformat(), bucket=period.bucket
    )


def _period(filters: ResolvedFilters) -> DateRange:
    if filters.range is None:
        return DateRange.last(30)
    return filters.range


def _bound(period: DateRange, tenant_id: str) -> dict[str, Any]:
    return {"tenant_id": tenant_id, "start": period.start_at, "end": period.end_at}


async def _scalar(context: ReportContext, statement: str, parameters: dict[str, Any]) -> int:
    result = await context.session.execute(text(statement), parameters)
    value = result.scalar_one()
    return int(value) if value is not None else 0


async def _rows(
    context: ReportContext, statement: str, parameters: dict[str, Any]
) -> list[dict[str, Any]]:
    result = await context.session.execute(text(statement), parameters)
    return [dict(row) for row in result.mappings().all()]


def _series_from(
    key: str,
    label: str,
    rows: Sequence[dict[str, Any]],
    *,
    unit: Unit = Unit.COUNT,
    fmt: Format = Format.INTEGER,
    value: str = "value",
) -> Series:
    points = []
    for row in rows:
        bucket = row["bucket"]
        x = bucket.date().isoformat() if hasattr(bucket, "date") else str(bucket)[:10]
        raw = row.get(value)
        points.append(SeriesPoint(x=x, y=float(raw) if raw is not None else None))
    return Series(key=key, label=label, unit=unit, format=fmt, points=points)


def _quota(
    key: str, label: str, used: int, limit: int | None, *, fmt: Format = Format.INTEGER
) -> MetricValue:
    unit = Unit.BYTES if fmt is Format.BYTES else Unit.COUNT
    return MetricValue(
        key=key,
        label=label,
        value=float(used),
        unit=unit,
        format=fmt,
        limit=float(limit) if limit is not None else None,
    )


def _count(key: str, label: str, value: int, previous: int | None = None) -> MetricValue:
    return MetricValue(
        key=key,
        label=label,
        value=float(value),
        unit=Unit.COUNT,
        format=Format.INTEGER,
        previous=float(previous) if previous is not None else None,
    )


# ── the statements ────────────────────────────────────────────────────────────

_MEMBERS_TOTAL = "select count(*) from public.tenant_members where tenant_id = :tenant_id"
_MEMBERS_JOINED = (
    "select count(*) from public.tenant_members "
    "where tenant_id = :tenant_id and created_at >= :start and created_at < :end"
)
_MEMBERS_BY_ROLE = (
    "select role, count(*)::int as value from public.tenant_members "
    "where tenant_id = :tenant_id group by role order by value desc, role"
)
_MEMBERS_JOINED_SERIES = (
    "select date_trunc('{bucket}', created_at at time zone 'UTC') as bucket, "
    " count(*)::int as value "
    "from public.tenant_members "
    "where tenant_id = :tenant_id and created_at >= :start and created_at < :end "
    "group by 1 order by 1"
)
_FILES_TOTAL = (
    "select count(*)::int as files, coalesce(sum(size_bytes), 0)::bigint as bytes "
    "from public.files where tenant_id = :tenant_id and status = 'ready'"
)
_FILES_UPLOADED = (
    "select count(*) from public.files "
    "where tenant_id = :tenant_id and status = 'ready' "
    "and ready_at >= :start and ready_at < :end"
)
_FILES_UPLOADED_SERIES = (
    "select date_trunc('{bucket}', ready_at at time zone 'UTC') as bucket, "
    " count(*)::int as value "
    "from public.files "
    "where tenant_id = :tenant_id and status = 'ready' and ready_at >= :start and ready_at < :end "
    "group by 1 order by 1"
)
_ACTIVITY_TOTAL = (
    "select count(*)::int as events, count(distinct actor_id)::int as actors "
    "from public.audit_events "
    "where tenant_id = :tenant_id and created_at >= :start and created_at < :end"
)
_ACTIVITY_SERIES = (
    "select date_trunc('{bucket}', created_at at time zone 'UTC') as bucket, "
    " count(*)::int as value "
    "from public.audit_events "
    "where tenant_id = :tenant_id and created_at >= :start and created_at < :end "
    "group by 1 order by 1"
)
_ACTIVITY_BY_ACTION = (
    "select action, outcome, count(*)::int as value from public.audit_events "
    "where tenant_id = :tenant_id and created_at >= :start and created_at < :end "
    "group by action, outcome order by value desc, action, outcome limit 200"
)
_ACTIVITY_RECENT = (
    "select actor_id, action, target_type, target_id, outcome, created_at "
    "from public.audit_events "
    "where tenant_id = :tenant_id and created_at >= :start and created_at < :end "
    "order by created_at desc limit :limit"
)
{{#if capability.ai}}
_AI_TOTALS = (
    "select count(*)::int as calls, "
    " (count(*) filter (where status <> 'ok'))::int as errors, "
    " coalesce(sum(total_tokens), 0)::bigint as tokens, "
    " coalesce(sum(estimated_cost_micros), 0)::bigint as cost, "
    " coalesce(sum(billable_micros), 0)::bigint as billable, "
    " coalesce(avg(latency_ms), 0)::int as latency, "
    " (count(*) filter (where estimated_cost_micros is null))::int as unpriced "
    "from public.ai_usage_events "
    "where tenant_id = :tenant_id and created_at >= :start and created_at < :end"
)
_AI_CALLS_THIS_MONTH = (
    "select count(*) from public.ai_usage_events "
    "where tenant_id = :tenant_id and status = 'ok' "
    "and created_at >= date_trunc('month', now() at time zone 'UTC')"
)
_AI_SERIES = (
    "select date_trunc('{bucket}', created_at at time zone 'UTC') as bucket, "
    " count(*)::int as calls, coalesce(sum(total_tokens), 0)::bigint as tokens "
    "from public.ai_usage_events "
    "where tenant_id = :tenant_id and created_at >= :start and created_at < :end "
    "group by 1 order by 1"
)
_AI_BY_MODEL = (
    "select model_alias, provider, model, count(*)::int as calls, "
    " (count(*) filter (where status <> 'ok'))::int as errors, "
    " coalesce(sum(total_tokens), 0)::bigint as tokens, "
    " coalesce(sum(estimated_cost_micros), 0)::bigint as cost, "
    " coalesce(avg(latency_ms), 0)::int as latency "
    "from public.ai_usage_events "
    "where tenant_id = :tenant_id and created_at >= :start and created_at < :end "

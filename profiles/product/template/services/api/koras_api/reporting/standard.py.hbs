{{/if}}


# ── the resolvers ─────────────────────────────────────────────────────────────


async def overview(context: ReportContext, filters: ResolvedFilters) -> ReportResult:
    """The landing report: where the organization stands and what moved."""
    tenant_id = context.tenant_id or ""
    period = _period(filters)
    previous = period.previous
    now, before = _bound(period, tenant_id), _bound(previous, tenant_id)

    members = await _scalar(context, _MEMBERS_TOTAL, {"tenant_id": tenant_id})
    joined = await _scalar(context, _MEMBERS_JOINED, now)
    joined_before = await _scalar(context, _MEMBERS_JOINED, before)
    files = (await _rows(context, _FILES_TOTAL, {"tenant_id": tenant_id}))[0]
    uploaded = await _scalar(context, _FILES_UPLOADED, now)
    uploaded_before = await _scalar(context, _FILES_UPLOADED, before)
    activity = (await _rows(context, _ACTIVITY_TOTAL, now))[0]
    activity_before = (await _rows(context, _ACTIVITY_TOTAL, before))[0]
    series_rows = await _rows(context, _ACTIVITY_SERIES.format(bucket=_bucket(period)), now)

    metrics = [
        _quota("members_total", "Members", members, context.plan.limit_of(SEATS_ENTITLEMENT)),
        _count("members_joined", "New members", joined, joined_before),
        _count("files_total", "Files", int(files["files"])),
        _count("files_uploaded", "Files uploaded", uploaded, uploaded_before),
        _quota(
            "storage_used_bytes",
            "Storage used",
            int(files["bytes"]),
            _gigabytes(context.plan.limit_of(STORAGE_ENTITLEMENT)),
            fmt=Format.BYTES,
        ),
        _count(
            "activity_events",
            "Activity",
            int(activity["events"]),
            int(activity_before["events"]),
        ),
        _count(
            "active_users",
            "Active users",
            int(activity["actors"]),
            int(activity_before["actors"]),
        ),
    ]
{{#if capability.ai}}
    ai = (await _rows(context, _AI_TOTALS, now))[0]
    ai_before = (await _rows(context, _AI_TOTALS, before))[0]
    metrics.append(_count("ai_requests", "AI requests", int(ai["calls"]), int(ai_before["calls"])))
{{/if}}
    notes = []
    if not context.plan.resolved:
        notes.append("The plan could not be read, so limits are not shown.")
    return ReportResult(
        key="usage.overview",
        generated_at=context.now,
        range=_range_view(period),
        metrics=metrics,
        series=[_series_from("activity_events", "Activity", series_rows)],
        notes=notes,
        visualization=Visualization.KPI,
        resolved=context.plan.resolved,
    )


def _gigabytes(limit: int | None) -> int | None:
    return limit * 1024**3 if limit is not None else None


async def quotas(context: ReportContext, filters: ResolvedFilters) -> ReportResult:
    """Used, included and remaining, for every quota the plan names and the
    product can measure. A quota with no ceiling is unlimited and says so."""
    tenant_id = context.tenant_id or ""
    period = _period(filters)
    members = await _scalar(context, _MEMBERS_TOTAL, {"tenant_id": tenant_id})
    files = (await _rows(context, _FILES_TOTAL, {"tenant_id": tenant_id}))[0]
    metrics = [
        _quota("members_total", "Seats", members, context.plan.limit_of(SEATS_ENTITLEMENT)),
        _quota(
            "storage_used_bytes",
            "Storage",
            int(files["bytes"]),
            _gigabytes(context.plan.limit_of(STORAGE_ENTITLEMENT)),
            fmt=Format.BYTES,
        ),
        _count("files_total", "Files", int(files["files"])),
    ]
{{#if capability.ai}}
    calls = await _scalar(context, _AI_CALLS_THIS_MONTH, {"tenant_id": tenant_id})
    metrics.append(
        _quota(
            "ai_requests",
            "AI requests this month",
            calls,
            context.plan.limit_of(AI_REQUESTS_ENTITLEMENT),
        )
    )
{{/if}}
    rows: list[dict[str, Any]] = []
    for metric in metrics:
        used = metric.value or 0.0
        limit = metric.limit
        rows.append(
            {
                "quota": metric.label,
                "used": used,
                "included": limit,
                "remaining": (limit - used) if limit is not None else None,
                "percent": round(used / limit * 100, 1) if limit else None,
            }
        )
    uploads = await _rows(
        context, _FILES_UPLOADED_SERIES.format(bucket=_bucket(period)), _bound(period, tenant_id)
    )
    notes = []
    if not context.plan.resolved:
        notes.append("The plan could not be read, so what is included is not shown.")
    return ReportResult(
        key="usage.quotas",
        generated_at=context.now,
        range=_range_view(period),
        metrics=metrics,
        series=[_series_from("files_uploaded", "Files uploaded", uploads)],
        table=Table(
            columns=[
                TableColumn(key="quota", label="Quota"),
                TableColumn(key="used", label="Used", format=Format.DECIMAL, align="right"),
                TableColumn(key="included", label="Included", format=Format.DECIMAL, align="right"),
                TableColumn(
                    key="remaining", label="Remaining", format=Format.DECIMAL, align="right"
                ),
                TableColumn(key="percent", label="Used %", format=Format.PERCENT, align="right"),
            ],
            rows=rows,
        ),
        notes=notes,
        visualization=Visualization.KPI,
        resolved=context.plan.resolved,
    )


async def users(context: ReportContext, filters: ResolvedFilters) -> ReportResult:
    """Who has access, by role, and how membership moved in the period."""
    tenant_id = context.tenant_id or ""
    period = _period(filters)
    now = _bound(period, tenant_id)
    total = await _scalar(context, _MEMBERS_TOTAL, {"tenant_id": tenant_id})
    joined = await _scalar(context, _MEMBERS_JOINED, now)
    joined_before = await _scalar(context, _MEMBERS_JOINED, _bound(period.previous, tenant_id))
    by_role = await _rows(context, _MEMBERS_BY_ROLE, {"tenant_id": tenant_id})
    series = await _rows(context, _MEMBERS_JOINED_SERIES.format(bucket=_bucket(period)), now)
    activity = (await _rows(context, _ACTIVITY_TOTAL, now))[0]
    return ReportResult(
        key="people.users",
        generated_at=context.now,
        range=_range_view(period),
        metrics=[
            _quota("members_total", "Members", total, context.plan.limit_of(SEATS_ENTITLEMENT)),
            _count("members_joined", "Joined in the period", joined, joined_before),
            _count("active_users", "Active in the period", int(activity["actors"])),
        ],
        series=[
            _series_from("members_joined", "Members joined", series),
            Series(
                key="members_total",
                label="Members by role",
                unit=Unit.COUNT,
                format=Format.INTEGER,
                points=[SeriesPoint(x=str(r["role"]), y=float(r["value"])) for r in by_role],
            ),
        ],
        table=Table(
            columns=[
                TableColumn(key="role", label="Role"),
                TableColumn(key="value", label="Members", format=Format.INTEGER, align="right"),
            ],
            rows=[{"role": str(r["role"]), "value": int(r["value"])} for r in by_role],
        ),
        visualization=Visualization.BAR,
    )


async def subscription(context: ReportContext, filters: ResolvedFilters) -> ReportResult:
    """The plan as the platform resolved it, beside what the product measures
    against it. Nothing here is a query over money: the product holds none."""
    tenant_id = context.tenant_id or ""
    plan = context.plan
    members = await _scalar(context, _MEMBERS_TOTAL, {"tenant_id": tenant_id})
    files = (await _rows(context, _FILES_TOTAL, {"tenant_id": tenant_id}))[0]
    rows: list[dict[str, Any]] = [
        {"item": "Plan", "value": plan.code or "not recorded"},
        {"item": "Status", "value": plan.status or "not recorded"},
        {
            "item": "Trial ends",
            "value": plan.trial_ends_at.date().isoformat() if plan.trial_ends_at else None,
        },
        {
            "item": "Current period ends",
            "value": plan.period_ends_at.date().isoformat() if plan.period_ends_at else None,
        },
    ]
    for code, row in sorted(plan.entitlements.items()):
        rows.append(
            {
                "item": code,
                "value": ("included" if row.enabled else "not included")
                + (f", up to {row.limit}" if row.limit is not None else ""),
            }
        )
    metrics = [
        _quota("members_total", "Seats", members, plan.limit_of(SEATS_ENTITLEMENT)),
        _quota(
            "storage_used_bytes",
            "Storage",
            int(files["bytes"]),
            _gigabytes(plan.limit_of(STORAGE_ENTITLEMENT)),
            fmt=Format.BYTES,
        ),
    ]
    notes = []
    if not plan.resolved:
        notes.append("The plan could not be read from the platform just now.")
    else:
        notes.append("Invoices and payments are on the customer portal's billing page.")
    return ReportResult(
        key="billing.subscription",
        generated_at=context.now,
        metrics=metrics,
        table=Table(
            columns=[
                TableColumn(key="item", label="Item"),
                TableColumn(key="value", label="Value"),
            ],
            rows=rows,
        ),
        notes=notes,
        visualization=Visualization.TABLE,
        resolved=plan.resolved,
    )


OUTCOME = FilterDefinition(
    key="outcome",
    kind=FilterKind.CHOICE,
    label="Outcome",
    options=("ok", "denied", "failed", "pending"),
)
LIMIT = FilterDefinition(
    key="limit", kind=FilterKind.INTEGER, label="Rows", default=100, minimum=1, maximum=1000
)


async def activity(context: ReportContext, filters: ResolvedFilters) -> ReportResult:
    """What people did, from the audit table: totals, the shape over time,
    the breakdown by action, and the most recent rows."""
    tenant_id = context.tenant_id or ""
    period = _period(filters)
    now = _bound(period, tenant_id)
    totals = (await _rows(context, _ACTIVITY_TOTAL, now))[0]
    before = (await _rows(context, _ACTIVITY_TOTAL, _bound(period.previous, tenant_id)))[0]
    series = await _rows(context, _ACTIVITY_SERIES.format(bucket=_bucket(period)), now)
    by_action = await _rows(context, _ACTIVITY_BY_ACTION, now)
    outcome = filters.choice("outcome")
    if outcome is not None:
        by_action = [row for row in by_action if row["outcome"] == outcome]
    recent = await _rows(
        context, _ACTIVITY_RECENT, {**now, "limit": filters.integer("limit") or 100}
    )
    if outcome is not None:
        recent = [row for row in recent if row["outcome"] == outcome]
    return ReportResult(
        key="activity.audit",
        generated_at=context.now,
        range=_range_view(period),
        metrics=[
            _count("activity_events", "Actions", int(totals["events"]), int(before["events"])),
            _count("active_users", "Active users", int(totals["actors"]), int(before["actors"])),
        ],
        series=[
            _series_from("activity_events", "Actions", series),
            Series(
                key="activity_by_action",
                label="By action",
                unit=Unit.COUNT,
                format=Format.INTEGER,
                points=[
                    SeriesPoint(x=f"{r['action']} ({r['outcome']})", y=float(r["value"]))
                    for r in by_action[:12]
                ],
            ),
        ],
        table=Table(
            columns=[
                TableColumn(key="at", label="When"),
                TableColumn(key="actor", label="Who"),
                TableColumn(key="action", label="Action"),
                TableColumn(key="target", label="Target"),
                TableColumn(key="outcome", label="Outcome"),
            ],
            rows=[
                {
                    "at": _iso(row["created_at"]),
                    "actor": str(row["actor_id"]),
                    "action": str(row["action"]),
                    "target": f"{row['target_type']} {row['target_id']}",
                    "outcome": str(row["outcome"]),
                }
                for row in recent
            ],
        ),
        visualization=Visualization.LINE,
    )


def _iso(value: object) -> str:
    return value.isoformat() if hasattr(value, "isoformat") else str(value)


{{#if capability.ai}}
async def ai_usage(context: ReportContext, filters: ResolvedFilters) -> ReportResult:
    """The assistant's usage over the period: calls, errors, tokens, latency,
    the estimate where a price was known, and the breakdown by model.
    Aggregates only; no conversation, no prompt, no answer."""
    tenant_id = context.tenant_id or ""
    period = _period(filters)
    now = _bound(period, tenant_id)
    totals = (await _rows(context, _AI_TOTALS, now))[0]
    before = (await _rows(context, _AI_TOTALS, _bound(period.previous, tenant_id)))[0]
    series = await _rows(context, _AI_SERIES.format(bucket=_bucket(period)), now)
    by_model = await _rows(context, _AI_BY_MODEL, now)
    calls = int(totals["calls"])
    unpriced = int(totals["unpriced"])
    notes = []
    if calls and unpriced:
        notes.append(
            f"{unpriced} of {calls} calls carried no price, so the estimate covers "
            f"{calls - unpriced} calls."
        )
    metrics = [
        _count("ai_requests", "Requests", calls, int(before["calls"])),
        _count("ai_errors", "Errors", int(totals["errors"]), int(before["errors"])),
        MetricValue(
            key="ai_tokens",
            label="Tokens",
            value=float(totals["tokens"]),
            unit=Unit.COUNT,
            format=Format.INTEGER,
            previous=float(before["tokens"]),
        ),
        MetricValue(
            key="ai_estimated_cost",
            label="Estimated cost",
            value=float(totals["cost"]) if calls else 0.0,
            unit=Unit.MICROS,
            format=Format.MONEY,
            kind="estimated",
            previous=float(before["cost"]),
            note="List price, where the route carried one",
        ),
        MetricValue(
            key="ai_latency_average",
            label="Average latency",
            value=float(totals["latency"]),
            unit=Unit.MILLISECONDS,
            format=Format.DURATION,
        ),
        MetricValue(
            key="ai_billable",
            label="Pay-as-you-go charges",
            value=float(totals["billable"]),
            unit=Unit.MICROS,
            format=Format.MONEY,
            kind="actual",
        ),
    ]
    return ReportResult(
        key="ai.usage",
        generated_at=context.now,
        range=_range_view(period),
        metrics=metrics,
        series=[
            _series_from("ai_requests", "Requests", series, value="calls"),
            _series_from("ai_tokens", "Tokens", series, value="tokens"),
        ],
        table=Table(
            columns=[
                TableColumn(key="model_alias", label="Alias"),
                TableColumn(key="provider", label="Provider"),
                TableColumn(key="model", label="Model"),
                TableColumn(key="calls", label="Calls", format=Format.INTEGER, align="right"),
                TableColumn(key="errors", label="Errors", format=Format.INTEGER, align="right"),
                TableColumn(key="tokens", label="Tokens", format=Format.INTEGER, align="right"),
                TableColumn(key="cost", label="Estimated cost", format=Format.MONEY, align="right"),
                TableColumn(key="latency", label="Latency", format=Format.DURATION, align="right"),
            ],
            rows=[
                {
                    "model_alias": str(r["model_alias"]),
                    "provider": str(r["provider"]),
                    "model": str(r["model"]),
                    "calls": int(r["calls"]),
                    "errors": int(r["errors"]),
                    "tokens": int(r["tokens"]),
                    "cost": int(r["cost"]),
                    "latency": int(r["latency"]),
                }
                for r in by_model
            ],
        ),
        notes=notes,
        visualization=Visualization.LINE,
    )



"""`secure_files`: the one constant, and the configuration it makes mandatory.

`SECURE_FILES` is rendered by the generator from the `secure_files` capability
(ADR 0013). It is not a setting and nothing at deploy time can change it: a
product generated without the capability behaves exactly as it always did, and a
product generated with it cannot start without a scanner and object storage.

Code that differs by mode branches on this constant and nowhere else.
"""

from __future__ import annotations

from collections.abc import Callable, Sequence
from dataclasses import dataclass

#: Rendered by the generator from the secure_files capability.
SECURE_FILES = {{#if capability.secure_files}}True{{else}}False{{/if}}

# ---- machinery shared by the API and worker copies (parity-tested) -------------------
# BEGIN SHARED


class SecureFilesConfigurationError(RuntimeError):
    """`secure_files` is on and a mandatory setting is absent or invalid.

    The message names every problem at once -- the environment variable and the
    requirement, never the value -- so an operator fixes the configuration in
    one pass rather than one refusal at a time.
    """

    def __init__(self, problems: Sequence[str]) -> None:
        self.problems: tuple[str, ...] = tuple(problems)
        super().__init__(
            "secure_files is enabled and the product refuses to start: "
            + "; ".join(self.problems)
        )


@dataclass(frozen=True)
class SettingCheck:
    """One mandatory setting: where it is read from and what makes it acceptable."""

    #: The attribute on the settings object.
    attribute: str
    #: The environment variable an operator sets, for the message.
    env: str
    #: Whether the value is acceptable. Receives the attribute's value or None.
    accepts: Callable[[object], bool]
    #: What is required, in a sentence.
    requirement: str


def _nonblank(value: object) -> bool:
    return isinstance(value, str) and value.strip() != ""


def _real_scanner(value: object) -> bool:
    # ADR 0013 section 6: the scanner is mandatory. `none`, unset and anything
    # unrecognised are all "no scanner", and none of them is a way to run.
    return isinstance(value, str) and value.strip().lower() in REAL_SCANNER_BACKENDS


def _port(value: object) -> bool:
    return isinstance(value, int) and not isinstance(value, bool) and 1 <= value <= 65535


def _present(value: object) -> bool:
    # A DSN may be a string or a parsed URL object; either way it has to say something.
    return value is not None and str(value).strip() != ""


#: The scanner backends that are real scanners. Deliberately not `none`.
REAL_SCANNER_BACKENDS: frozenset[str] = frozenset({"clamd"})

#: Every mandatory setting, as data. A later layer appends its own entries here
#: (a tuple literal, one line each) rather than adding a branch to a function,
#: so the list of what is required reads as one list and a missing check is a
#: missing line, not a missing `if`.
SECURE_FILES_CHECKS: tuple[SettingCheck, ...] = (
    SettingCheck(
        "file_scan_backend",
        "FILE_SCAN_BACKEND",
        _real_scanner,
        "must name a real scanner (one of: "
        + ", ".join(sorted(REAL_SCANNER_BACKENDS))
        + "), not none",
    ),
    SettingCheck("file_scan_clamd_host", "FILE_SCAN_CLAMD_HOST", _nonblank, "must be set"),
    SettingCheck("file_scan_clamd_port", "FILE_SCAN_CLAMD_PORT", _port, "must be a port, 1-65535"),
    # The incoming and final objects live in one bucket, told apart by key, so
    # the object-storage configuration is the same four settings for both.
    SettingCheck("storage_endpoint", "STORAGE_ENDPOINT", _nonblank, "must be set"),
    SettingCheck("storage_bucket", "STORAGE_BUCKET", _nonblank, "must be set"),
    SettingCheck("storage_access_key", "STORAGE_ACCESS_KEY", _nonblank, "must be set"),
    SettingCheck("storage_secret_key", "STORAGE_SECRET_KEY", _nonblank, "must be set"),
    # The finalizer (layer 2). An upload is confirmed by the API, which hands the file to
    # the worker through the queue, and the worker finalizes it against the database as the
    # file's tenant. Without the queue no upload is ever finalized, and without a database
    # the worker would skip the sweep that recovers a lost job: either way a file would sit
    # on its incoming key for ever. That is safe -- nothing releases an incoming key -- but
    # it is a product that cannot store a file, so it is refused at start rather than found
    # by the first customer. The upload window itself is not a setting: it is the constants
    # in `core/upload_window.py`, and no deploy-time value may shorten it (ADR 0013 s6).
    SettingCheck(
        "redis_url",
        "REDIS_URL",
        _present,
        "must be set: confirmed uploads are finalized by a job",
    ),
    SettingCheck(
        "database_url",
        "DATABASE_URL",
        _present,
        "must be set: the finalizer works on the file's row",
    ),
)


def secure_files_enabled() -> bool:
    """Whether this product was generated with `secure_files`.

    Read through the module global at call time, so a test can switch modes by
    monkeypatching `SECURE_FILES`. Nothing at deploy time can.
    """
    return SECURE_FILES


def secure_files_problems(
    settings: object, checks: Sequence[SettingCheck] = SECURE_FILES_CHECKS
) -> list[str]:
    """Every failing check, in declaration order. Empty when all pass."""
    return [
        f"{check.env} {check.requirement}"
        for check in checks
        if not check.accepts(getattr(settings, check.attribute, None))
    ]


def validate_secure_files_settings(
    settings: object, checks: Sequence[SettingCheck] = SECURE_FILES_CHECKS
) -> None:
    """Refuse a configuration `secure_files` cannot run on. A no-op when it is off.

    Raises `SecureFilesConfigurationError` listing EVERY missing or invalid
    setting. It never falls back to the legacy behaviour: there is nothing to
    fall back to once the product was generated with the capability.
    """
    if not secure_files_enabled():
        return
    problems = secure_files_problems(settings, checks)
    if problems:
        raise SecureFilesConfigurationError(problems)


# END SHARED

[project]
name = "{{projectSlug}}-api"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = [
  # Left at 0.115.0 on 2026-09-19, deliberately. This repository records that
  # at exactly 0.115.0 every route returning `None` with a 204 fails at import,
  # which would make the declared floor a floor that does not work. Adding a
  # third such route (`routers/notifications.py`) was the reason to check, and
  # it does not reproduce: 0.115.0, 0.115.1, 0.115.2 and 0.115.4 all import a
  # 204 route returning `None`, both bare and with dependencies through
  # `include_router`. Either the claim is wrong or it needs a condition nobody
  # wrote down, so the floor is not moved on a premise that could not be shown.
  # PLAT-DEBT-001 carries the finding.
  "fastapi>=0.115.0",
  # Imported directly by core/security.py for BaseHTTPMiddleware. It resolves
  # anyway -- fastapi brings it -- which is exactly how an undeclared import
  # survives until the day the transitive dependency stops providing it.
  "starlette>=0.40.0",
  "uvicorn[standard]>=0.30.0",
  "sqlalchemy[asyncio]>=2.0.0",
  "alembic>=1.13.0",
  "asyncpg>=0.29.0",
  "python-jose[cryptography]>=3.3.0",
  "httpx>=0.27.0",
  # Imported directly by settings, health and the routers. It resolves anyway,
  # because fastapi and pydantic-settings both bring it -- which is the whole
  # shape of this defect class: the import works locally and the service is
  # built from a manifest that never named it.
  "pydantic>=2.0.0",
  "koras-ratelimit",
  "redis>=5.0.0",
  "pydantic-settings>=2.0.0",
  "opentelemetry-api>=1.25.0",
  "opentelemetry-sdk>=1.25.0",
  "opentelemetry-instrumentation-fastapi>=0.46b0",
  # Imported by src/core/observability.py. Absent from the manifest,
  # which made the service unimportable.
  "opentelemetry-exporter-otlp-proto-grpc>=1.25.0",
  # For a hosted collector that speaks OTLP over HTTP (Grafana Cloud does).
  "opentelemetry-exporter-otlp-proto-http>=1.25.0",
  "koras-auth",
  "koras-tenant",
  "koras-database",
  "koras-platform",
  "koras-logging",
  "koras-observability",
  "koras-audit",
  # The settings framework: the definition registry and the resolver behind
  # every signed-in request. Never capability-gated -- the shell resolves a
  # customer's settings before it paints, so a product generated without
  # anything optional still needs it.
  "koras-settings",
  "koras-storage",
  "koras-queue",
{{#if capability.data_import}}  # The import engine: targets, the reader, the mapping and the state
  # machine. No database driver of its own -- a commit runs on the caller's
  # session.
  "koras-import",
{{/if}}  # Mail, and the language it is written in. Always present: the assistant's
  # approval notice needs the sender, and every request resolves its locale
  # through the catalogue (`core/locale.py`) whether or not it sends anything.
  "koras-email",
{{#if capability.reporting}}  # The reporting framework: definitions, registries, filters and the CSV
  # writer the reports router runs. Generated only with the `reporting`
  # capability.
  "koras-reporting",
{{/if}}{{#if capability.ai}}  # The AI foundation: the runtime the assistant routes run. Generated only
  # with the `ai` capability, which also requires the gateway service.
  "koras-ai",
  # Text out of PDFs and workbooks, for retrieval. Pure Python, both.
  "pypdf>=4.0.0",
  "openpyxl>=3.1.0",
  # A scanned PDF has no text layer; its pages are rendered and read by the
  # vision alias. pypdfium2 ships pdfium in the wheel, so the image needs
  # no system package for it.
  "pypdfium2>=4.30.0",
  "pillow>=10.0.0",
{{/if}}]

[tool.uv.sources]
koras-ratelimit = { workspace = true }
koras-auth = { workspace = true }
koras-tenant = { workspace = true }
koras-database = { workspace = true }
koras-platform = { workspace = true }
koras-logging = { workspace = true }
koras-observability = { workspace = true }
koras-audit = { workspace = true }
koras-storage = { workspace = true }
koras-queue = { workspace = true }
{{#if capability.data_import}}koras-import = { workspace = true }
{{/if}}koras-email = { workspace = true }
{{#if capability.reporting}}koras-reporting = { workspace = true }
{{/if}}{{#if capability.ai}}koras-ai = { workspace = true }
{{/if}}
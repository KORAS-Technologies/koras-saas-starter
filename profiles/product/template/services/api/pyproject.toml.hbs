[project]
name = "{{projectSlug}}-api"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = [
  "fastapi>=0.115.0",
  # Imported directly by core/security.py for BaseHTTPMiddleware. It resolves
  # anyway -- fastapi brings it -- which is exactly how an undeclared import
  # survives until the day the transitive dependency stops providing it.
  "starlette>=0.40.0",
  "uvicorn[standard]>=0.30.0",
  "sqlalchemy>=2.0.0",
  "alembic>=1.13.0",
  "asyncpg>=0.29.0",
  "python-jose[cryptography]>=3.3.0",
  "httpx>=0.27.0",
  # Imported directly by settings, health and the routers. It resolves anyway,
  # because fastapi and pydantic-settings both bring it -- which is the whole
  # shape of this defect class: the import works locally and the service is
  # built from a manifest that never named it.
  "pydantic>=2.0.0",
  "koras-ratelimit",
  "redis>=5.0.0",
  "pydantic-settings>=2.0.0",
  "opentelemetry-api>=1.25.0",
  "opentelemetry-sdk>=1.25.0",
  "opentelemetry-instrumentation-fastapi>=0.46b0",
  # Imported by src/core/observability.py. Absent from the manifest,
  # which made the service unimportable.
  "opentelemetry-exporter-otlp-proto-grpc>=1.25.0",
  "koras-auth",
  "koras-tenant",
  "koras-database",
  "koras-platform",
  "koras-logging",
  "koras-observability",
  "koras-audit",
  "koras-storage",
  "koras-queue",
{{#if capability.ai}}  # The AI foundation: the runtime the assistant routes run. Generated only
  # with the `ai` capability, which also requires the gateway service.
  "koras-ai",
{{/if}}]

[tool.uv.sources]
koras-ratelimit = { workspace = true }
koras-auth = { workspace = true }
koras-tenant = { workspace = true }
koras-database = { workspace = true }
koras-platform = { workspace = true }
koras-logging = { workspace = true }
koras-observability = { workspace = true }
koras-audit = { workspace = true }
koras-storage = { workspace = true }
koras-queue = { workspace = true }
{{#if capability.ai}}koras-ai = { workspace = true }
{{/if}}
logger = logging.getLogger(__name__)


class ApprovedRestore(Protocol):
    """One row of the approved-and-joined query.

    A protocol rather than `Any`, so that renaming a column in the statement
    above and not here is a type error rather than an attribute error at three
    in the morning on the one night somebody needed their file back.
    """

    id: str
    tenant_id: str
    file_id: str
    overwrite: bool
    backup_key: str
    backup_digest: str | None
    size_bytes: int | None

#: The largest object this process will read into memory. The same ceiling the
#: cross-provider backup uses, for the same reason: a worker holding a gigabyte
#: to move it is a worker that falls over on the night it mattered.
RESTORE_CEILING = 64 * 1024 * 1024

#: How many approved requests one pass runs. A ceiling rather than a target.
RESTORE_LIMIT = 50

_PROVISIONING = text("select set_config('app.provisioning', 'on', true)")
_AS_TENANT = text(
    "select set_config('app.provisioning', '', true), set_config('app.tenant_id', :tenant_id, true)"
)

{{#if capability.secure_files}}
#: The backup is joined on the request's own tenant and file, not only on its id: this runs on
#: the provisioning context, which sees every tenant, so a row that named another tenant's
#: backup must find nothing here rather than that tenant's object.
_APPROVED = text(
    "select r.id::text as id, r.tenant_id::text as tenant_id, r.file_id::text as file_id, "
    " r.overwrite, b.backup_key, b.backup_digest, b.size_bytes, b.source_key "
    "from public.restore_requests r "
    "join public.file_backups b on b.id = r.backup_id "
    " and b.tenant_id = r.tenant_id and b.file_id = r.file_id "
    "where r.status = 'approved' order by r.approved_at limit :limit"
)
{{else}}
_APPROVED = text(
    "select r.id::text as id, r.tenant_id::text as tenant_id, r.file_id::text as file_id, "
    " r.overwrite, b.backup_key, b.backup_digest, b.size_bytes, b.source_key "
    "from public.restore_requests r "
    "join public.file_backups b on b.id = r.backup_id "
    "where r.status = 'approved' order by r.approved_at limit :limit"
)
{{/if}}

_CLAIM = text(
    "update public.restore_requests set status = 'restoring' "
    "where id = cast(:id as uuid) and status = 'approved' returning id"
)
_FINISH = text(
    "update public.restore_requests set status = :status, error = :error, "
    " restored_file_id = cast(:restored as uuid), finished_at = now() "
    "where id = cast(:id as uuid)"
)

#: The object being restored, where it still exists. An overwrite needs its key
#: and its metadata; a new object needs the metadata alone.
#:
#: Tenant-scoped, and it was not. The request that reaches here cannot name
#: another tenant's file today -- `routers/restore.py` resolves the backup
#: through `available_backup(tenant_id=...)` -- but that made a Python check the
#: only thing between a crafted row and this statement reading another tenant's
#: metadata under a context that sees every tenant. A predicate here costs
#: nothing and does not depend on the route staying correct.
_ORIGINAL = text(
    "select name, content_type, size_bytes, classification, category, uploaded_by, storage_key "
    "from public.files "
    "where id = cast(:file_id as uuid) and tenant_id = cast(:tenant_id as uuid)"
)
{{#if capability.secure_files}}
_INSERT_FILE = text(
    "insert into public.files "
    " (id, tenant_id, name, storage_key, content_type, size_bytes, status, uploaded_by, "
    "  category, classification, checksum_sha256, checksum_verified_at) "
    "values (cast(:id as uuid), cast(:tenant_id as uuid), :name, :storage_key, :content_type, "
    " :size_bytes, 'ready', :uploaded_by, :category, :classification, :checksum, now()) "
    "returning created_at"
)

#: The row of the file about to be replaced, locked, as the tenant. Its state is read here
#: and not from `_ORIGINAL`: the decision to replace is made on the row as it is while this
#: transaction holds it, so a verdict, a delete or another restore cannot move it between the
#: read and the write. `scan_recent` is asked of the database's own clock.
_LOCK_ORIGINAL = text(
    "select storage_key, status, scan_status, "
    " (scan_attempted_at is not null "
    "  and scan_attempted_at > now() - make_interval(secs => :horizon)) as scan_recent "
    "from public.files "
    "where id = cast(:file_id as uuid) and tenant_id = cast(:tenant_id as uuid) "
    "for update"
)

#: The replacement, in one statement: the new object's identity, and every piece of evidence
#: that was about the old bytes cleared with it. Not copied, not "reset to the column
#: default" by omission -- each is named, so a column added later that is evidence about bytes
#: has to be decided here and a test (`tests/integration/test_restore_replacement_real.py`) fails
#: until it is.
#:
#: * `scan_status = 'pending'`, `scan_note`, `scan_attempts`, `scan_attempted_at`,
#:   `scan_failure`, `scan_object_etag`: the verdict, its evidence and its attempt history
#:   belong to the old object. `scan_object_etag` is the identity a `clean` was bound to; with
#:   it gone the release rule refuses the row until the scanner stamps the new object.
#: * `checksum_sha256` is the digest this worker computed over the bytes it wrote, and read
#:   back, so `checksum_verified_at` is set to now: it is the same claim the upload finalizer
#:   makes about a final object it hashed itself, and it is what makes the scanner compare the
#:   digest of the bytes it streams with this one.
#: * `indexed_at`, `index_note`: the index state of the old content. (Whatever the assistant derived
#:   from it is removed in the same transaction where the assistant is generated, and by the
#:   withdrawal trigger as well where the file was clean.)
#: * `backup_status`, `backed_up_at`, `archived_at`: a "verified" backup and an archive copy are of
#:   the old bytes. Left set, the backup selection (`backup_status in ('none', 'failed')`) would
#:   never copy the replacement while the row claimed a verified backup. `retain_until` is
#:   deliberately not touched: re-resolving a restored file's retention is a policy decision.
#: * The `where` repeats the three facts the decision was made on, so a row that is not as it
#:   was read updates nothing and the caller fails the request instead of switching it.
_REPLACE_FILE = text(
    "update public.files set storage_key = :new_key, size_bytes = :size_bytes, "
    " checksum_sha256 = :checksum, checksum_verified_at = now(), status = 'ready', "
    " scan_status = 'pending', scan_note = null, scan_attempts = 0, scan_attempted_at = null, "
    " scan_failure = null, scan_object_etag = null, indexed_at = null, index_note = null, "
    " backup_status = 'none', backed_up_at = null, archived_at = null "
    "where id = cast(:file_id as uuid) and tenant_id = cast(:tenant_id as uuid) "
    " and storage_key = :old_key and status = :seen_status and scan_status = :seen_scan "
    "returning created_at"
)
{{#if capability.ai}}

#: Whatever the assistant derived from the old bytes. The withdrawal trigger does this for a file
#: that was `ready` + `clean`; a purged or archived file's chunks are hidden by the read gate only
#: while it is not releasable, and would come back the moment the replacement is cleaned. So it
#: is stated here, for every old state, in the same transaction.
_WITHDRAW_CHUNKS = text(
    "delete from public.ai_knowledge_chunks "
    "where tenant_id = cast(:tenant_id as uuid) and resource_type = 'file' "
    " and resource_id = :file_id"
)
{{/if}}

#: What a commit that raised left behind, asked of the database afterwards. The request row, the
#: index row and the audit row are one transaction, so the request being `completed` is proof the
#: whole of it committed; the request still `restoring` is proof none of it did (nothing else
#: finishes a claimed request). The file row naming the key is a second, independent proof of the
#: commit. Provisioning context, identifiers only.
_REQUEST_STATE = text("select status from public.restore_requests where id = cast(:id as uuid)")
#: Taken only when the request still reads `restoring`: the claim holds a row lock for as long as
#: the transaction that may still be committing is alive, so waiting for it (briefly) turns "I did
#: not see the commit" into "there is no commit left to see". Times out into `unknown`.
_REQUEST_LOCK = text(
    "select status from public.restore_requests where id = cast(:id as uuid) for update"
)
_LOCK_WAIT = text("select set_config('lock_timeout', '3s', true)")
_KEY_REFERENCED = text(
    "select exists(select 1 from public.files where storage_key = :key "
    " and tenant_id = cast(:tenant_id as uuid))"
)
{{else}}
_INSERT_FILE = text(
    "insert into public.files "
    " (id, tenant_id, name, storage_key, content_type, size_bytes, status, uploaded_by, "
    "  category, classification, checksum_sha256) "
    "values (cast(:id as uuid), cast(:tenant_id as uuid), :name, :storage_key, :content_type, "
    " :size_bytes, 'ready', :uploaded_by, :category, :classification, :checksum)"
)
_TOUCH_FILE = text(
    "update public.files set size_bytes = :size_bytes, checksum_sha256 = :checksum, "
    " status = 'ready' "
    "where id = cast(:file_id as uuid) and tenant_id = cast(:tenant_id as uuid)"
)
{{/if}}

_AUDIT_INSERT = text(
    "insert into public.audit_events "
    " (tenant_id, actor_id, action, target_type, target_id, outcome, details, classification) "
    "values (cast(:tenant_id as uuid), 'system', :action, 'file', :target_id, :outcome, "
    " cast(:details as jsonb), 'administrative')"
)



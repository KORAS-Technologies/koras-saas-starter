async def verify_isolation(ctx: dict[str, Any]) -> None:
    """Refuse to sweep on a connection row-level security cannot restrain.

    The API has made this check since R-032 and the worker did not, which a
    security review found on 2026-09-16. The gap mattered more here than there:
    every sweep below runs on the provisioning context, two of them delete, and
    the policies that bound what they may touch -- `files_update_provisioning`
    refusing a purged row, `legal_holds_expire_provisioning` admitting only
    `active` to `expired`, `restore_requests_run_provisioning` being the
    database half of the two-person rule -- are all inert against a role that
    bypasses RLS. A managed Postgres commonly hands out a superuser as the
    default role, and a DATABASE_URL copied from a dashboard is usually that
    role. Such a deployment has correct policies, a green policy suite, and no
    isolation at all.

    Hardcoded rather than read from a setting, deliberately.
    `REQUIRE_RLS_ENFORCEMENT` sits in this repository's `NEVER_SETTABLE` list
    with the reason written out: a switch for it in Doppler would be a switch
    for turning tenant isolation off, next to the one for the pool size.

    A worker with no database skips, because every sweep that needs one already
    skips and says so. Nothing else is exempt.
    """
    del ctx
    if not settings.database_url:
        return
    engine = create_async_engine(
        settings.database_url.replace("postgresql://", "postgresql+asyncpg://", 1)
    )
    try:
        async with async_sessionmaker(engine, expire_on_commit=False)() as session:
            await assert_rls_enforced(session)
    finally:
        await engine.dispose()


class WorkerSettings(WorkerSettingsBase):
    # Cron jobs are below; these are the jobs a *request* asks for. The list
    # was `[example_task]` alone until 2026-09-19, and that was the whole of
    # the problem: nothing could enqueue, so every path that needed work done
    # after responding used FastAPI background tasks, which run in the API
    # process and are lost when it restarts.
    #
    # `worker_functions` applies each task's declared retry policy and timeout
    # and refuses a name bound twice, so a collision is a traceback here rather
    # than one handler silently shadowing another in production.
    functions = [
        example_task,
{{#if capability.data_import}}        # The dry run a person is waiting on. The first enqueued work in this
        # product, and the reason the seam above exists.
        *worker_functions(import_tasks()),
{{/if}}        *worker_functions(PRODUCT_TASKS),
    ]
    # Before the first cron fires, not after. A sweep that deleted across
    # tenants once has already done it.
    #
    # `staticmethod` because a bare function assigned in a class body becomes a
    # method, and arq calls this with the context alone.
    on_startup = staticmethod(verify_isolation)
    # Nightly, at a quiet hour, on the worker's own clock: no scheduler
    # service is needed for a sweep that runs once a day. Each capability
    # adds its sweeps to the one list.
    cron_jobs = [
        # Foundation, like the table it sweeps: every product records audit
        # events, so every product forgets them on a schedule.
        cron(purge_audit_history, hour=3, minute=23),
{{#if capability.notifications}}        # The feed, in two windows: a read notification goes at ninety days, an
        # unread one at a hundred and eighty. Always on, like the audit sweep
        # and unlike the storage ones -- a notification is a sentence the
        # product wrote about content that still exists, so forgetting one
        # costs the customer nothing they cannot see elsewhere.
        cron(purge_notifications, hour=3, minute=19),
        # Every minute, unlike every other job here, and the interval is the
        # feature. A notification is something a person is waiting on; a
        # nightly sweep would make "you have an action to approve" arrive the
        # following morning. Claiming is `skip locked`, so a run that overruns
        # its minute costs a second worker nothing.
        cron(send_owed_notifications, second=0),
{{/if}}{{#if capability.audit_governance}}        # Export artifacts past their expiry. On by default, unlike the two
        # storage sweeps: those remove a customer's own content, while this
        # removes an artifact the product generated with a date the product
        # itself displayed. Before it existed, the only thing that retired
        # an export was somebody opening the exports page.
        cron(expire_audit_exports, hour=3, minute=29),
        # A bounded hold stopped holding on the day it said it would; this
        # makes the row say so too. Always on -- it changes a label, not a
        # byte, and a holds list full of holds that hold nothing is how a
        # tenant loses track of the ones that do.
        cron(expire_legal_holds, hour=3, minute=31),
{{/if}}
{{#if capability.ai}}        cron(purge_ai_history, hour=3, minute=17),
{{/if}}{{#if capability.storage_governance}}        # What the bucket holds against what the index says. Off unless
        # STORAGE_RECONCILE_ENABLED asks for it, and it reports rather than
        # deletes: an object it cannot match is not proof of a leak.
        cron(reconcile_storage, hour=3, minute=41),
        # Retention for stored objects: resolve a date for what has none,
        # lengthen what falls short of the floor, remove what has passed one
        # and nothing is holding. Off unless STORAGE_LIFECYCLE_ENABLED asks --
        # it deletes, which is a good reason to opt in rather than discover.
        cron(sweep_storage_lifecycle, hour=4, minute=7),
        # The copy, and the digest comparison that makes it a backup. After
        # the lifecycle sweep on purpose: an object removed tonight should
        # not be copied tonight, and a copy whose object has gone starts its
        # own clock here rather than being deleted alongside it. Off unless
        # STORAGE_BACKUP_ENABLED asks -- it bills a second destination.
        cron(back_up_storage, hour=4, minute=39),
        # Approved restores. Every ten minutes rather than nightly: a person
        # who approved a recovery is waiting for it, and the sweep is what
        # makes the approval durable -- a request approved and then lost to a
        # crashed process is a row somebody can find rather than an approval
        # that evaporated.
        cron(run_restores, minute={0, 10, 20, 30, 40, 50}),
{{/if}}
{{#if capability.reporting}}        # The seam for scheduled delivery. Hourly, and it says nothing is
        # scheduled until a product gives it something to deliver.
        cron(deliver_scheduled_reports, minute=41),
{{/if}}        # This product's own, from `tasks/product.py`. Last, so the
        # starter's sweeps keep their order and a product reading this file
        # can see where its own work joins.
        #
        # The list is empty in a freshly generated project. It exists because
        # a product that had to edit *this* file to schedule anything would
        # carry a permanent conflict into every future sync -- which is why
        # `koras-e2e-shop` had a retention sweep it never ran.
        *PRODUCT_CRON_JOBS,
    ]
    # Derived from REDIS_URL rather than hardcoded. A fixed localhost:6379 is
    # not merely wrong once deployed -- the worker starts, stays up, and quietly
    # consumes an empty local queue while the real one fills elsewhere. On a
    # developer machine running more than one KORAS stack it connects to
    # whichever project happens to hold 6379.
    redis_settings = RedisSettings.from_dsn(str(settings.redis_url))
    # arq polls every 0.5s by default: two Redis commands a second per worker,
    # forever, whether or not there is work. On a per-command managed queue that
    # is ~170,000 commands a day on an idle platform, and enough to exhaust a
    # free tier within minutes of starting.
    #
    # Nothing here needs sub-second pickup, so five seconds costs nothing
    # perceptible and removes ninety per cent of the idle traffic.
    poll_delay = 5.0
    max_jobs = 10
    job_timeout = 300

      {
        id: 'files',
        label: 'Files',
        icon: 'folder',
        href: '/dashboard/files',
        group: 'primary',
        order: 5,
        requiredPermissions: ['files.read'],
        requiredEntitlements: ['storage.files'],
        lockedBehavior: 'lock',

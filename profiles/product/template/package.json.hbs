{
  "name": "{{projectSlug}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{projectName}} — KORAS SaaS product",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm lint:py",
    "lint:py": "uv run ruff check .",
    "typecheck": "turbo run typecheck && pnpm typecheck:py",
    "typecheck:py": "uv run mypy python-packages services",
    "test": "turbo run test && pnpm test:py",
    "test:py": "uv run pytest",
    "dev": "turbo run dev",
    "bootstrap": "bash local/scripts/bootstrap.sh",
    "stack:ports": "bash local/scripts/ports.sh --reset",
    "stack:up": "docker compose -f local/docker-compose.yml up -d",
    "stack:down": "docker compose -f local/docker-compose.yml down",
    "stack:reset": "docker compose -f local/docker-compose.yml down -v",
    "stack:seed": "bash local/scripts/seed.sh",
    "stack:health": "bash local/scripts/health.sh",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,yaml,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "^15.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}

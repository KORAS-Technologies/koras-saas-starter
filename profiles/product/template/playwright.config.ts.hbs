import { defineConfig, devices } from '@playwright/test'

/**
 * The one suite in this repository that opens a browser.
 *
 * Everything else asserts structure: `node --test` over pure functions, and a
 * server-side probe of the rendered markup. That covers what a caller is
 * *allowed* to see, which is the claim that matters, and it cannot cover the
 * interaction — a focus trap, Escape returning focus, a drawer closing on
 * navigation, an icon-only link keeping its accessible name. Those are the
 * things a text search reads as present and a keyboard finds missing.
 *
 * **One server, built and started by Playwright**, so the suite owns its
 * lifecycle and a failed run cannot leave a port held. It runs the production
 * build rather than `next dev`: the shell's client boundaries, the middleware
 * and the CSP nonce all behave differently there, and the build is what ships.
 *
 * **No API by default, deliberately.** `NEXT_PUBLIC_API_URL` is unset, so the
 * tenant read fails and the shell falls back to this product's own branding and
 * no optional features — which is a supported state, not a broken one, and it
 * is the state a new customer is in. A suite that needed a database to check a
 * focus trap would be a suite nobody runs.
 *
 * ## The round trip, when a database is offered
 *
 * Set `E2E_DATABASE_URL` and three more servers start: a local identity
 * provider, this product's API against that database, and a *second* copy of
 * the web application pointed at both. The `roundtrip` project then runs
 * against that second copy, and nothing else changes — every existing test
 * still runs against the first server and the degraded shell, because that
 * state is a claim worth keeping true.
 *
 * **The second server is the whole point, and it was once shared.** Until
 * 2026-09-20 the round trip handed `NEXT_PUBLIC_API_URL` to the one web
 * server, so turning the database on moved `desktop` and `mobile` onto the API
 * as well. Their specs assert the degraded shell in English; with an API
 * answering, the shell resolved a stored language and 59 of them failed on
 * German copy. The product was correct throughout — only the harness had
 * changed what those projects faced, while this comment said it had not. Each
 * project now names the server it owns, so the two states cannot be confused
 * for one another again.
 *
 * **Why it is worth the wiring.** Settings, notifications and data import each
 * record, in their own status document, that the round trip has no automated
 * proof; that is why each has a manual plan nobody has run. And the class it
 * catches has already reached a running product: a notification label was a
 * closure passed from a server component to a client one, React could not
 * serialise it, and because the bell lives in the dashboard layout the throw
 * took down every signed-in page. It shipped green through every suite in this
 * repository and was found by a person opening the product.
 *
 * **Nothing is bypassed to make it work.** The API discovers the identity
 * provider's JWKS and verifies an RS256 signature, the audience, the issuer and
 * the expiry exactly as it does in production; what is local is the provider,
 * not the verification. `e2e/support/identity.mjs` says why that matters.
 *
 * It does not replace the manual plans. It replaces their repeatable half.
 */

const PORT = Number(process.env.E2E_PORT ?? 3210)

/**
 * A database to run the API against, or nothing.
 *
 * Its presence is the whole switch. Absent — which is the default, and what a
 * developer running `pnpm e2e` on a laptop has — the suite is exactly what it
 * was: one web server, no API, and the degraded shell. Present, the round trip
 * runs as well.
 *
 * Opt-in rather than opt-out on purpose. A suite that fails when Postgres is
 * not running is a suite people stop running, and the sixteen checks that need
 * no database are the ones that catch a focus trap.
 */
const DATABASE_URL = process.env.E2E_DATABASE_URL ?? ''
const ROUND_TRIP = Boolean(DATABASE_URL)

/**
 * The round trip's own web application, on its own port.
 *
 * **Two servers from one build, because the environment is the thing under
 * test.** `NEXT_PUBLIC_API_URL` is read on the server -- `apps/web/src/lib`
 * reads it through `next/headers`, so every caller is a server component, a
 * route handler or a server action -- which means two `next start` processes
 * from the same build can hold different values, and no second build is paid
 * for.
 *
 * It exists because the alternative was handing that variable to the *one*
 * shared server, which silently moved `desktop` and `mobile` onto the API too.
 * Their specs assert the degraded shell in English; with an API answering, the
 * shell resolved a stored language instead and 59 of them failed on translated
 * copy. Nothing about the product was wrong. The harness had quietly changed
 * what those projects were pointed at, which is the one thing this file's own
 * comment promised it would not do.
 */
const ROUNDTRIP_PORT = Number(process.env.E2E_ROUNDTRIP_PORT ?? 3214)
const ROUNDTRIP_URL = `http://localhost:${ROUNDTRIP_PORT}`

const API_PORT = Number(process.env.E2E_API_PORT ?? 3213)
const IDENTITY_PORT = Number(process.env.E2E_IDENTITY_PORT ?? 3212)
// `127.0.0.1` rather than `localhost`, everywhere these two are named. On a
// machine that resolves `localhost` to `::1` first, a server bound to the
// IPv4 address is never reached and Playwright waits the full two minutes
// for a process that started correctly.
const API_URL = `http://127.0.0.1:${API_PORT}`
const IDENTITY_URL = `http://127.0.0.1:${IDENTITY_PORT}`
//: The audience the API checks and the suite mints against. One value, read by
//: both, because two would verify against each other and pass.
const PROJECT_ID = process.env.E2E_PROJECT_ID ?? 'e2e-project'
{{#if apps.marketing}}
/**
 * The marketing site is a second application on a second origin, and the
 * language suite has claims about it that the web application cannot stand
 * in for: that `/de` is a static document, that `/` sends a German browser
 * there, that `/fr` is a 404. Its tests set `baseURL` to this server.
 */
const MARKETING_PORT = Number(process.env.E2E_MARKETING_PORT ?? 3211)
const MARKETING_URL = `http://localhost:${MARKETING_PORT}`
{{/if}}
{{#if apps.admin}}
/**
 * The operations application, started only so its production policy can be
 * read. It emits its own Content-Security-Policy from its own middleware -- a
 * second copy of the same function -- so a policy checked on `web` alone is a
 * policy checked on half the applications that have one.
 */
const ADMIN_PORT = Number(process.env.E2E_ADMIN_PORT ?? 3215)
const ADMIN_URL = `http://localhost:${ADMIN_PORT}`
{{/if}}

/**
 * The origins `csp.spec.ts` reads, as `label=origin` pairs.
 *
 * Set here rather than derived in the spec so that the ports live in one place:
 * a spec recomputing `E2E_ADMIN_PORT ?? 3215` would be a second copy of a
 * default, and the two would drift the day somebody changed one. Playwright
 * evaluates this config in the parent process before workers are spawned, so
 * the value reaches them through the environment they inherit.
 *
 * Marketing is deliberately absent: it emits no policy at all, and listing it
 * would turn a real gap into a passing test.
 */
process.env.E2E_CSP_ORIGINS ??= [
  `web=http://localhost:${PORT}`,
{{#if apps.admin}}
  `admin=${ADMIN_URL}`,
{{/if}}
].join(',')

export default defineConfig({
  testDir: './e2e',
  timeout: 30_000,
  // Serial. The suite is small, the server is one process, and a flaky
  // parallel run costs more to read than the seconds it saves.
  fullyParallel: false,
  forbidOnly: !!process.env.CI,
  retries: process.env.CI ? 1 : 0,
  workers: 1,
  // `github` annotates the failing line in a pull request; `html` writes the
  // trace that explains it. The Control Plane's suite uploaded a report
  // directory that was never produced, because only the first was configured.
  reporter: process.env.CI ? [['github'], ['html', { open: 'never' }]] : [['list']],
  use: {
    baseURL: `http://localhost:${PORT}`,
    trace: 'retain-on-failure',
  },
  projects: [
    // Two viewports, because the shell is two different components below and
    // above `lg` — a drawer and a sidebar — and testing one of them would test
    // half the navigation.
    {
      name: 'desktop',
      testIgnore: /roundtrip\//,
      use: { ...devices['Desktop Chrome'], viewport: { width: 1440, height: 900 } },
    },
    {
      name: 'mobile',
      testIgnore: /roundtrip\//,
      use: { ...devices['Desktop Chrome'], viewport: { width: 375, height: 812 } },
    },
    // One viewport for the round trip. What it checks is whether a change
    // reaches a database and comes back, which is the same answer at every
    // width, and the layouts are covered above.
    ...(ROUND_TRIP
      ? [
          {
            name: 'roundtrip',
            testMatch: /roundtrip\//,
            use: {
              ...devices['Desktop Chrome'],
              viewport: { width: 1440, height: 900 },
              // The only project pointed at the API-backed server. Every other
              // project keeps the `baseURL` above, which is the degraded shell.
              baseURL: ROUNDTRIP_URL,
            },
          },
        ]
      : []),
  ],
  webServer: [
    {
      command: `pnpm --filter @{{projectSlug}}/web exec next start -p ${PORT}`,
      url: `http://localhost:${PORT}/login`,
      reuseExistingServer: !process.env.CI,
      timeout: 120_000,
      env: {
        // The application refuses a signing key shorter than 32 characters, so a
        // test value has to be a real one. The suite signs its cookies with this
        // and the application verifies them: nothing is bypassed, and a test that
        // skipped verification would pass however broken authorisation became.
        SESSION_SECRET:
          process.env.SESSION_SECRET ?? 'e2e-session-secret-at-least-32-characters-long',
        // `NEXT_PUBLIC_API_URL` is never set here, in any mode. This is the
        // degraded-shell server, and `desktop` and `mobile` are its only
        // callers. The round trip gets its own server below rather than
        // borrowing this one -- see `ROUNDTRIP_PORT`.
      },
    },
{{#if apps.marketing}}
    {
      command: `pnpm --filter @{{projectSlug}}/marketing exec next start -p ${MARKETING_PORT}`,
      url: `${MARKETING_URL}/`,
      reuseExistingServer: !process.env.CI,
      timeout: 120_000,
    },
{{/if}}
{{#if apps.admin}}
    {
      // Started for `csp.spec.ts` alone. Its policy comes from its own copy of
      // `contentSecurityPolicy()`, so nothing about `web` passing says anything
      // about this one.
      command: `pnpm --filter @{{projectSlug}}/admin exec next start -p ${ADMIN_PORT}`,
      url: `${ADMIN_URL}/login`,
      reuseExistingServer: !process.env.CI,
      timeout: 120_000,
      env: {
        SESSION_SECRET:
          process.env.SESSION_SECRET ?? 'e2e-session-secret-at-least-32-characters-long',
      },
    },
{{/if}}
    ...(ROUND_TRIP
      ? [
          {
            // Started before the API, because the API fetches its discovery
            // document on the first token it is asked to verify and a
            // provider that is not there yet is a 500 on the first request.
            command: 'node e2e/support/identity.mjs',
            url: `${IDENTITY_URL}/.well-known/openid-configuration`,
            reuseExistingServer: !process.env.CI,
            timeout: 30_000,
            // Both, and they have to agree: the API pins the issuer, so a
            // token minted under one spelling of this address and verified
            // against another is rejected with the same 401 a forged one gets.
            env: { E2E_IDENTITY_PORT: String(IDENTITY_PORT), E2E_IDENTITY_URL: IDENTITY_URL },
          },
          {
            // `--directory`, because the API is a workspace member and the
            // module is not importable from the repository root -- which
            // fails as a two-minute timeout rather than as an error.
            command:
              `uv run --directory services/api uvicorn koras_api.main:app` +
              ` --host 127.0.0.1 --port ${API_PORT} --log-level warning`,
            // The real path, not `/health`: every route of this API is under
            // `/api/v1`, and polling the wrong one is a two-minute wait for a
            // process that started correctly.
            url: `${API_URL}/api/v1/health`,
            reuseExistingServer: !process.env.CI,
            timeout: 120_000,
            env: {
              ENVIRONMENT: 'dev',
              DATABASE_URL: DATABASE_URL,
              // The local provider. The API discovers its JWKS from here and
              // verifies signatures against it; nothing about that path is
              // different from production.
              ZITADEL_DOMAIN: IDENTITY_URL,
              ZITADEL_PROJECT_ID: PROJECT_ID,
              // No platform, no Redis, no bucket. Each is absent rather than
              // faked, and each has a documented answer for being absent —
              // which is itself worth exercising: this is the shape a product
              // runs in before its first deployment.
              //
              // The round trip's application, not the degraded one: this is
              // the address the API puts in anything it addresses back to the
              // product, and the round trip is the only project talking to it.
              NEXT_PUBLIC_APP_URL: ROUNDTRIP_URL,
            },
          },
          {
            // The same build as the degraded server above, started a second
            // time on its own port with the API address set. Two processes
            // rather than one shared one, because `desktop` and `mobile` assert
            // the shell *without* an API and this project asserts it *with*
            // one -- and a single server cannot be both.
            //
            // No rebuild: `next build` ran once, and `NEXT_PUBLIC_API_URL` is
            // read on the server by `apps/web/src/lib/session`, so the value
            // is this process's environment rather than something inlined into
            // a client bundle.
            command: `pnpm --filter @{{projectSlug}}/web exec next start -p ${ROUNDTRIP_PORT}`,
            url: `${ROUNDTRIP_URL}/login`,
            reuseExistingServer: !process.env.CI,
            timeout: 120_000,
            env: {
              SESSION_SECRET:
                process.env.SESSION_SECRET ?? 'e2e-session-secret-at-least-32-characters-long',
              NEXT_PUBLIC_API_URL: API_URL,
            },
          },
        ]
      : []),
  ],
})

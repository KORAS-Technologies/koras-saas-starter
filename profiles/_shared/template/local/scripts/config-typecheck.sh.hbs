#!/usr/bin/env bash
# Every typed setting holds a value of the shape it declares -- checked before
# a deployment changes anything.
#
# `doppler-check.sh` asks Doppler which NAMES it holds and never requests a
# value, which is what makes it safe to run anywhere. That property is worth
# keeping, and it has a limit: a name check cannot see that a boolean holds
# `truefalse`. That exact value once reached a worker, which crash-looped --
# after the same deployment had already applied its database migration. The
# schema had moved, the services had not, and the cause was one malformed
# value that every name-based check reported as present and correct.
#
# So this is a SECOND tool rather than a change to the first, and it is narrow
# on purpose:
#
#   - It reads only settings that carry a TYPE in secrets.manifest. Nothing
#     else is fetched, and the default for a new setting is no type, so a
#     secret is never read by forgetting to exclude it.
#   - It refuses to read a value whose NAME looks like a credential, even if
#     somebody typed it. A type is somebody's judgement; this is not.
#   - It prints the name, the expected type and the fault. It never prints a
#     value, not on success, not on failure, and not in a diff.
#
#   bash local/scripts/config-typecheck.sh dev
#
# Synced from koras-saas-starter:
#   profiles/{{profile}}/template/local/scripts/config-typecheck.sh.hbs
# Change it there. A fix made only here is a fix the next generated project
# does not get.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
DEFAULT_PROJECT="{{projectSlug}}"
PROJECT="${DOPPLER_PROJECT:-$DEFAULT_PROJECT}"
MANIFEST="${ROOT}/local/config/secrets.manifest"

ENVIRONMENTS=("$@")
if [ ${#ENVIRONMENTS[@]} -eq 0 ]; then
  ENVIRONMENTS=(dev test stg prod)
fi

if [ ! -f "$MANIFEST" ]; then
  echo "No manifest at ${MANIFEST}; nothing to type-check." >&2
  exit 1
fi

if ! command -v doppler >/dev/null 2>&1; then
  echo "The Doppler CLI is not on PATH; cannot type-check configuration." >&2
  exit 1
fi

# The second gate, independent of the manifest. A type is a person's
# judgement that a setting is safe to read; this is the rule that does not
# depend on that judgement being right. A name matching any of these is never
# fetched, and saying so is a failure rather than a silent skip -- a typed
# secret is a mistake somebody should hear about.
looks_like_a_credential() {
  case "$1" in
    *SECRET*|*PASSWORD*|*TOKEN*|*_KEY|*_KEY_*|*APIKEY*|*CREDENTIAL*|*DSN*|*PRIVATE*) return 0 ;;
    *) return 1 ;;
  esac
}

check_value() {
  # $1 name, $2 type, $3 value. Echoes a fault description, or nothing.
  local type="$2" value="$3"
  case "$type" in
    bool)
      case "$value" in
        true|false) ;;
        *) echo "expected true or false" ;;
      esac
      ;;
    int)
      case "$value" in
        ''|*[!0-9-]*|-) echo "expected an integer" ;;
        *) ;;
      esac
      ;;
    url)
      case "$value" in
        http://?*|https://?*) ;;
        *) echo "expected a URL with a scheme and a host" ;;
      esac
      ;;
    enum:*)
      local allowed="${type#enum:}" found=1 option
      local IFS='|'
      for option in $allowed; do
        [ "$value" = "$option" ] && found=0
      done
      unset IFS
      [ "$found" -eq 0 ] || echo "expected one of ${allowed//|/, }"
      ;;
    nonempty)
      [ -n "$value" ] || echo "expected a value"
      ;;
    *)
      echo "unknown type '${type}' in the manifest"
      ;;
  esac
}

echo "==> Type-checking configuration for '${PROJECT}'"
echo ""

failed=0
for environment in "${ENVIRONMENTS[@]}"; do
  echo "  ${environment}:"
  checked=0
  problems=0

  while read -r name class source type; do
    # `escrow` is written by stack.mjs to a per-machine config, never here.
    case "$class" in local|escrow|"") continue ;; esac
    [ -n "${type:-}" ] || continue

    if looks_like_a_credential "$name"; then
      echo "      ${name}: REFUSED — a typed setting whose name looks like a credential."
      echo "                 Remove the type, or rename it if it is not one."
      problems=$((problems + 1))
      continue
    fi

    # 2>/dev/null and the `|| true`: an absent optional setting is not a type
    # failure. doppler-check.sh owns presence; this owns shape.
    value=$(doppler secrets get "$name" --plain \
              --project "$PROJECT" --config "$environment" 2>/dev/null | tr -d '\r\n' || true)
    if [ -z "$value" ]; then
      if [ "$class" = "optional" ]; then
        continue
      fi
      echo "      ${name}: no value (${class}); presence is doppler-check.sh's job"
      continue
    fi

    checked=$((checked + 1))
    # `fault` never contains the value, and neither does anything printed
    # below. That is the whole safety property of this script.
    fault=$(check_value "$name" "$type" "$value")
    unset value
    if [ -n "$fault" ]; then
      echo "      ${name}: ${fault} (declared ${type})"
      problems=$((problems + 1))
    fi
  done < <(grep -vE '^\s*#|^\s*$' "$MANIFEST")

  if [ "$problems" -eq 0 ]; then
    echo "      ${checked} typed setting(s) hold a value of the declared shape."
  else
    failed=1
  fi
done

echo ""
if [ "$failed" -ne 0 ]; then
  cat >&2 <<'GUIDANCE'
At least one setting holds a value of the wrong shape.

Fix it in Doppler before deploying. This check runs ahead of the migration on
purpose: a malformed value found afterwards means the schema has already moved
and the services have not, which is the one state a deployment should not be
able to reach.

No value is printed by this tool. Read it yourself with:

  doppler secrets get NAME --plain --project {{projectSlug}} --config <env>
GUIDANCE
  exit 1
fi

echo "Every typed setting holds a value of its declared shape."

[project]
name = "{{projectSlug}}-worker"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = [
  "arq>=0.26.0",
  "redis>=5.0.0",
  "sqlalchemy>=2.0.0",
  "asyncpg>=0.29.0",
  "httpx>=0.27.0",
  # Imported directly by settings.py for RedisDsn. It resolves anyway --
  # pydantic-settings brings it -- which is exactly how an undeclared import
  # survives until the day the transitive dependency stops providing it.
  "pydantic>=2.0.0",
  "pydantic-settings>=2.0.0",
  "opentelemetry-api>=1.25.0",
  "opentelemetry-sdk>=1.25.0",
  "koras-database",
  "koras-platform",
  "koras-logging",
  "koras-observability",
  "koras-queue",
{{#if capability.reporting}}  # Scheduled delivery: the framework renders the file, the mail package
  # sends it. The product's report catalogue itself is reached by path;
  # see the Dockerfile.
  "koras-reporting",
  "koras-email",
{{/if}}]

[tool.uv.sources]
koras-database = { workspace = true }
koras-platform = { workspace = true }
koras-logging = { workspace = true }
koras-observability = { workspace = true }
koras-queue = { workspace = true }
{{#if capability.reporting}}koras-reporting = { workspace = true }
koras-email = { workspace = true }
{{/if}}
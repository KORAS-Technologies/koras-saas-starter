[project]
name = "{{projectSlug}}-worker"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = [
  "arq>=0.26.0",
  "redis>=5.0.0",
  "sqlalchemy[asyncio]>=2.0.0",
  "asyncpg>=0.29.0",
  "httpx>=0.27.0",
  # Imported directly by settings.py for RedisDsn. It resolves anyway --
  # pydantic-settings brings it -- which is exactly how an undeclared import
  # survives until the day the transitive dependency stops providing it.
  "pydantic>=2.0.0",
  "pydantic-settings>=2.0.0",
  "opentelemetry-api>=1.25.0",
  "opentelemetry-sdk>=1.25.0",
  "koras-database",
  "koras-platform",
  "koras-logging",
  "koras-observability",
  "koras-queue",
{{#if capability.secure_files}}{{#unless capability.data_import}}  # The finalizer records what it did through the audit sink, and imports the
  # envelope's `AuditEvent` itself. Declared here rather than left to arrive
  # through the API's dependencies (the capability that brings it in with
  # `data_import` declares it in the block below).
  "koras-audit",
{{/unless}}{{/if}}{{#if capability.data_import}}  # The validation job reads a file through the same engine the API does.
  "koras-import",
  # The commit reaches `koras_api.core.imports`, which registers this
  # capability's audit actions at import, and the completion notice reaches the
  # dispatch point, which resolves recipients and their settings. All three are
  # imports the worker makes, so all three are declared -- an undeclared one
  # resolves through somebody else's dependency until the day it does not, and
  # here the failure would be an `importlib` skip, which is a job that silently
  # never runs.
  "koras-audit",
  "koras-settings",
  "koras-auth",
{{/if}}{{#if capability.notifications}}  # The outbox sweep sends what the API decided to send.
  "koras-email",
{{/if}}  # The reconciliation sweep asks the bucket what it holds and compares it
  # with the index. Foundation, like the index.
  "koras-storage",
{{#if capability.reporting}}  # Scheduled delivery: the framework renders the file, the mail package
  # sends it. The product's report catalogue itself is reached by path;
  # see the Dockerfile.
  "koras-reporting",
{{#unless capability.notifications}}  "koras-email",
{{/unless}}{{/if}}]

[tool.uv.sources]
koras-database = { workspace = true }
koras-platform = { workspace = true }
koras-logging = { workspace = true }
koras-observability = { workspace = true }
koras-queue = { workspace = true }
{{#if capability.secure_files}}{{#unless capability.data_import}}koras-audit = { workspace = true }
{{/unless}}{{/if}}{{#if capability.data_import}}koras-import = { workspace = true }
koras-audit = { workspace = true }
koras-settings = { workspace = true }
koras-auth = { workspace = true }
{{/if}}{{#if capability.notifications}}koras-email = { workspace = true }
{{/if}}koras-storage = { workspace = true }
{{#if capability.reporting}}koras-reporting = { workspace = true }
{{#unless capability.notifications}}koras-email = { workspace = true }
{{/unless}}{{/if}}
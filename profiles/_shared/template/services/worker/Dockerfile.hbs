FROM python:3.12-slim

WORKDIR /app

RUN pip install uv

# Pin where uv puts the environment, and put it on PATH. fly.toml may override
# the CMD below with a [processes] entry, and those run the bare command -- a
# `python -m ...` that resolves to the system interpreter finds none of the
# dependencies uv just installed. That failure looks like a missing dependency
# rather than a missing PATH, and the dependency is right there in pyproject.
ENV UV_PROJECT_ENVIRONMENT=/app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# Built from the repository root, not from this directory. The service
# depends on the shared packages in python-packages/ as uv workspace
# members, so uv cannot resolve it without the workspace root and those
# members present -- a context of this directory alone fails on the first
# `workspace = true` entry it reads.
# uv.lock is a wildcard because a freshly generated project has not
# resolved one yet. A non-matching wildcard is tolerated only because
# pyproject.toml on the same line always matches.
COPY pyproject.toml uv.lock* ./
COPY python-packages/ ./python-packages/
COPY services/worker/pyproject.toml ./services/worker/

# The root pyproject names the API in its dev group and points that dependency
# at the workspace, so uv refuses to read the root manifest at all unless
# services/api resolves to a member it can find -- `--no-dev` skips installing
# the group, not parsing it. The API's manifest alone satisfies that; no API
# source is copied and nothing from it is installed into this image.
COPY services/api/pyproject.toml ./services/api/

# Ahead of the source copy, so editing the service does not resync every
# dependency. Run from the member directory: uv finds the workspace root
# above it and syncs this member against it.
RUN cd services/worker && uv sync --no-dev

COPY services/worker/koras_worker/ ./services/worker/koras_worker/
{{#if capability.reporting}}
# The product's report catalogue, for scheduled delivery. Only this package
# of the API: its modules import the reporting framework and SQLAlchemy and
# nothing of the API's own settings, routers or session. On the path as a
# namespace package, so `koras_api.reporting` resolves and nothing else of
# `koras_api` exists here.
COPY services/api/koras_api/reporting/ ./services/api/koras_api/reporting/
{{/if}}{{#if capability.notifications}}# The outbox store, for the send sweep. Same arrangement and the same
# reason: the worker sends what the API decided to send, without depending on
# the API's distribution.
COPY services/api/koras_api/core/outbox.py ./services/api/koras_api/core/outbox.py
{{/if}}{{#if capability.data_import}}# The import targets and the run store, for the validation job. Same
# arrangement and the same reason: the worker reads what a product declared
# without depending on the API's distribution.
#
# Its own block rather than nested inside the reporting one. It was nested
# until 2026-09-19, which meant `--with data_import --without reporting` built
# a worker with neither the targets nor the run store on its path -- and the
# job's graceful `importlib` failure would have turned that into a run stuck in
# `validating` rather than a build error.
COPY services/api/koras_api/imports/ ./services/api/koras_api/imports/
COPY services/api/koras_api/core/imports.py ./services/api/koras_api/core/imports.py
COPY services/api/koras_api/core/import_notify.py ./services/api/koras_api/core/import_notify.py
# And the dispatch point itself, because the commit tells whoever confirmed the
# run that it finished, and there is exactly one place a notification leaves
# from. Five modules rather than a re-implementation in the worker -- a second
# emitter is how the two drift, and the drift is invisible until somebody
# compares two notifications nobody reads side by side.
#
# None of these reaches the API's settings. `core/recipients` imported
# `core/platform` -- which builds `Settings()` at import -- until 2026-09-20,
# when that import became lazy for exactly this reason: a worker that had to
# satisfy the API's whole environment to announce a finished import is a worker
# with the API's configuration surface.
COPY services/api/koras_api/core/dispatch.py ./services/api/koras_api/core/dispatch.py
COPY services/api/koras_api/core/notifications.py ./services/api/koras_api/core/notifications.py
COPY services/api/koras_api/core/recipients.py ./services/api/koras_api/core/recipients.py
COPY services/api/koras_api/core/settings_store.py ./services/api/koras_api/core/settings_store.py
COPY services/api/koras_api/settings_catalogue/ ./services/api/koras_api/settings_catalogue/
{{/if}}
# Unconditional: two capabilities put a namespace package here and a third
# would be a third place to remember. An empty directory on the path costs
# nothing, and a missing one is a stuck job rather than a loud failure.
ENV PYTHONPATH=/app/services/api

# The workspace members again, now that their sources are here.
#
# The sync above runs before any source is copied, so it installs third-party
# dependencies and leaves every local member -- this service and the shared
# python-packages -- installed from a manifest with nothing behind it. This
# second sync completes them, in the image, where the cost is paid once.
RUN cd services/worker && uv sync --no-dev

WORKDIR /app/services/worker

# The venv directly, so `uv` is not on the runtime path at all.
#
# On Fly on 2026-08-30 a machine spent two minutes on `Building koras-audit ...
# Built koras-database` for eleven packages *after* `Preparing to run` and
# before the server process existed -- longer than the deploy pipeline's
# health-check budget, so a service that would have come up was reported as one
# that never became healthy.
#
# What triggered the resync there is not established: the same image built and
# run locally, from this Dockerfile and from the previous one, rebuilt nothing.
# So this is not a fix for a reproduced trigger. It removes the mechanism --
# `uv run` synchronises the environment before it execs, and nothing else in
# the container can rebuild anything. A cause that cannot be reached does not
# need to be understood first.
#
# It also removes the `uv` parent from the process tree, so the server is a
# direct child of Fly's init and receives Fly's signals on shutdown rather than
# depending on `uv` to forward them.
#
# This said "puts the process at PID 1 ... Measured: PID 10 before, PID 1 now",
# and PID 1 is not what a Fly machine shows. `/fly/init` is PID 1 there, always;
# the server is its child. Checked on a deployed machine on 2026-09-01, where
# `/proc` lists `/app/.venv/bin/python /app/.venv/bin/uvicorn ...` and no `uv`
# anywhere. The benefit is real and the number was wrong -- corrected rather
# than deleted, because a measurement nobody can reproduce is worse than none.
#
# /app/.venv/bin is already on PATH for the reason given at the top of this
# file, so the bare command resolves there.
CMD ["python", "-m", "koras_worker.main"]
